diff --git a/server/src/services/email/cloudflare.test.ts b/server/src/services/email/cloudflare.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b576ef9f5b56d7e954ae6a9737a89f78bc629f60
--- /dev/null
+++ b/server/src/services/email/cloudflare.test.ts
@@ -0,0 +1,34 @@
+import { Context } from 'hono'
+import { describe, expect, test, vi } from 'vitest'
+import { typeConfig } from '../../configs'
+import { CloudflareMailer } from './cloudflare'
+
+vi.mock('hono/adapter', () => ({ env: (value: { env: object }) => value.env }))
+
+const message = { email: 'recipient@example.com', senderName: 'NAccount', subject: 'Verify', content: '<p>test</p>' }
+const context = (bindings: object) => ({ env: bindings, runtime: 'workerd' }) as unknown as Context<typeConfig.Context>
+
+describe('Cloudflare Email binding', () => {
+  test('uses the binding and preserves message fields without API token', async () => {
+    const send = vi.fn().mockResolvedValue({ messageId: 'mail-123' })
+    const mailer = new CloudflareMailer({ context: context({ CLOUDFLARE_EMAIL: { send }, CLOUDFLARE_SENDER_ADDRESS: 'accounts@example.com' }) })
+    const response = await mailer.sendEmail(message)
+    expect(response.status).toBe(202)
+    expect(await response.json()).toEqual({ messageId: 'mail-123' })
+    expect(send).toHaveBeenCalledExactlyOnceWith({ to: message.email, from: { email: 'accounts@example.com', name: message.senderName }, subject: message.subject, html: message.content })
+  })
+
+  test('missing binding is a failure, not accepted email', async () => {
+    const response = await new CloudflareMailer({ context: context({}) }).sendEmail(message)
+    expect(response.ok).toBe(false)
+  })
+
+  test('unknown provider result and errors do not report success or disclose details', async () => {
+    for (const send of [vi.fn().mockResolvedValue({}), vi.fn().mockRejectedValue(new Error('private verification code'))]) {
+      const response = await new CloudflareMailer({ context: context({ CLOUDFLARE_EMAIL: { send }, CLOUDFLARE_SENDER_ADDRESS: 'accounts@example.com' }) }).sendEmail(message)
+      expect(response.status).toBe(502)
+      expect(await response.text()).not.toContain('private verification code')
+      expect(send).toHaveBeenCalledTimes(1)
+    }
+  })
+})
diff --git a/server/src/services/email/cloudflare.ts b/server/src/services/email/cloudflare.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b10da54b79e0c79ee3b2e2a013376da544007f98
--- /dev/null
+++ b/server/src/services/email/cloudflare.ts
@@ -0,0 +1,33 @@
+import { env } from 'hono/adapter'
+import {
+  IMailer, SendEmailOptions,
+} from './interface'
+
+// 由 Worker binding 发信，不向应用注入账户管理 API token。
+export class CloudflareMailer extends IMailer {
+  async sendEmail ({
+    email, subject, content, senderName,
+  }: SendEmailOptions) {
+    const binding = this.context.env.CLOUDFLARE_EMAIL
+    const sender = env(this.context).CLOUDFLARE_SENDER_ADDRESS
+    if (!binding || typeof sender !== 'string' || !sender) {
+      return Response.json({ error: 'CLOUDFLARE_EMAIL_NOT_CONFIGURED' }, { status: 503 })
+    }
+    try {
+      const result = await binding.send({
+        to: email,
+        from: { email: sender, name: senderName },
+        subject,
+        html: content,
+      })
+      if (!result?.messageId) {
+        return Response.json({ error: 'CLOUDFLARE_EMAIL_RESULT_UNKNOWN' }, { status: 502 })
+      }
+      // 接受发送不是送达证明；最终送达在真实业务验收中核对。
+      return Response.json({ messageId: result.messageId }, { status: 202 })
+    } catch {
+      // provider 异常可能含收件人/正文；只返回固定错误，不泄露验证码。
+      return Response.json({ error: 'CLOUDFLARE_EMAIL_FAILED' }, { status: 502 })
+    }
+  }
+}
