+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { ClientType } from '@melody-auth/shared'
+import account from './account'
+import { appModel } from 'models'
+
+vi.mock('models', () => ({ appModel: { getByClientId: vi.fn() } }))
+const env = {
+  NACCOUNT_PORTAL_CLIENT_ID: 'portal-only', AUTH_SERVER_URL: 'https://auth.example.test',
+  ENABLE_SIGN_UP: true, ENABLE_PASSWORD_RESET: true, ENABLE_EMAIL_VERIFICATION: true,
+  ENABLE_RECOVERY_CODE: true, ALLOW_PASSKEY_ENROLLMENT: true, BLOCKED_POLICIES: ['change_org'],
+  ENVIRONMENT: 'prod', DB: {},
+} as any
+
+beforeEach(() => {
+  vi.mocked(appModel.getByClientId).mockReset()
+  vi.mocked(appModel.getByClientId).mockResolvedValue({
+    clientId: 'portal-only', isActive: true, type: ClientType.SPA,
+    redirectUris: ['https://auth.example.test/account'], secret: 'must-never-leak',
+  } as any)
+})
+
+describe('public account surface', () => {
+  it('serves an ordinary-user portal without authentication or admin privilege', async () => {
+    const res = await account.request('/account', {}, env)
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
+    expect(res.headers.get('Referrer-Policy')).toBe('no-referrer')
+    expect(res.headers.get('X-Frame-Options')).toBe('DENY')
+    const html = await res.text()
+    expect(html).toContain('个人中心')
+    expect(html).toContain('/client.js')
+    expect(html).not.toContain('must-never-leak')
+  })
+  it('returns only allowlisted public configuration', async () => {
+    const res = await account.request('/account/config', {}, env)
+    expect(await res.json()).toEqual({
+      clientId: 'portal-only', serverUri: 'https://auth.example.test', redirectUri: 'https://auth.example.test/account', signup: true,
+      policies: ['update_info', 'reset_mfa', 'change_password', 'change_email', 'manage_passkey', 'manage_recovery_code'],
+    })
+  })
+  it('does not guess another client when configuration is missing', async () => {
+    const res = await account.request('/account/config', {}, { ...env, NACCOUNT_PORTAL_CLIENT_ID: undefined })
+    expect(res.status).toBe(503)
+    expect(appModel.getByClientId).not.toHaveBeenCalled()
+  })
+  it.each([null, { isActive: false }, { type: ClientType.S2S }, { redirectUris: ['https://evil.example/account'] }])('rejects unavailable or mismatched clients', async (override) => {
+    const original = await appModel.getByClientId(env.DB, 'portal-only')
+    vi.mocked(appModel.getByClientId).mockResolvedValue(override === null ? null : { ...original, ...override } as any)
+    const res = await account.request('/account/config', {}, env)
+    expect(res.status).toBe(503)
+  })
+  it('respects disabled and blocked policies', async () => {
+    const res = await account.request('/account/config', {}, {
+      ...env, ENABLE_PASSWORDLESS_SIGN_IN: true, ENABLE_EMAIL_VERIFICATION: false,
+      BLOCKED_POLICIES: ['reset_mfa', 'update_info'],
+    })
+    expect(await res.json()).toMatchObject({ signup: false, policies: [] })
+  })
+})
diff --git a/server/src/routes/account.tsx b/server/src/routes/account.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f07077a2cfa9e7f468b46ddcbb886e1d179439d0
--- /dev/null
+++ b/server/src/routes/account.tsx
@@ -0,0 +1,56 @@
+import { Hono } from 'hono'
+import { ClientType } from '@melody-auth/shared'
+import { typeConfig } from 'configs'
+import { appModel } from 'models'
+
+// This surface never resolves or exposes the administrator application's secret.
+const account = new Hono<typeConfig.Context>()
+
+account.use('*', async (c, next) => {
+  c.header('Cache-Control', 'no-store')
+  c.header('Referrer-Policy', 'no-referrer')
+  c.header('X-Content-Type-Options', 'nosniff')
+  c.header('X-Frame-Options', 'DENY')
+  await next()
+})
+
+account.get('/account/config', async (c) => {
+  const clientId = c.env.NACCOUNT_PORTAL_CLIENT_ID
+  if (!clientId) return c.json({ error: 'PORTAL_NOT_CONFIGURED' }, 503)
+  const app = await appModel.getByClientId(c.env.DB, clientId)
+  const redirectUri = `${c.env.AUTH_SERVER_URL.replace(/\/$/, '')}/account`
+  if (!app || !app.isActive || app.type !== ClientType.SPA || !app.redirectUris.includes(redirectUri)) {
+    return c.json({ error: 'PORTAL_CLIENT_INVALID' }, 503)
+  }
+  const blocked = c.env.BLOCKED_POLICIES ?? []
+  const policies = ['update_info', 'reset_mfa']
+  if (c.env.ENABLE_PASSWORD_RESET && !c.env.ENABLE_PASSWORDLESS_SIGN_IN) policies.push('change_password')
+  if (c.env.ENABLE_EMAIL_VERIFICATION) policies.push('change_email')
+  if (c.env.ALLOW_PASSKEY_ENROLLMENT && !c.env.ENABLE_PASSWORDLESS_SIGN_IN) policies.push('manage_passkey')
+  if (c.env.ENABLE_RECOVERY_CODE && !c.env.ENABLE_PASSWORDLESS_SIGN_IN) policies.push('manage_recovery_code')
+  return c.json({
+    clientId,
+    redirectUri,
+    serverUri: c.env.AUTH_SERVER_URL.replace(/\/$/, ''),
+    signup: !!c.env.ENABLE_SIGN_UP && !c.env.ENABLE_PASSWORDLESS_SIGN_IN,
+    policies: policies.filter((policy) => !blocked.includes(policy)),
+  })
+})
+
+account.get('/account', (c) => c.html(
+  <html lang='zh-CN'>
+    <head>
+      <meta charset='utf-8' />
+      <meta name='viewport' content='width=device-width, initial-scale=1' />
+      <title>NAccount · 个人中心</title>
+      <link rel='stylesheet' href={c.env.ENVIRONMENT === 'dev' ? '/src/pages/client.css' : '/client.css'} />
+    </head>
+    <body>
+      <div id='root' />
+      <noscript>请启用 JavaScript 以使用个人中心。</noscript>
+      <script type='module' src={c.env.ENVIRONMENT === 'dev' ? '/src/pages/client.tsx' : '/client.js'} />
+    </body>
+  </html>,
+))
+
+export default account
