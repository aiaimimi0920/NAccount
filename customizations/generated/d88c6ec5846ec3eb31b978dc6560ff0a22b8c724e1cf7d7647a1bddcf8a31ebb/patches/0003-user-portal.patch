+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { render } from 'hono/jsx/dom'
+import { fireEvent, getByRole, queryByRole, waitFor } from '@testing-library/dom'
+import Account from './Account'
+import * as auth from './auth'
+
+vi.mock('./auth', async (original) => ({
+  ...await original<typeof import('./auth')>(),
+  request: vi.fn(), restore: vi.fn(), profile: vi.fn(), authorize: vi.fn(), logout: vi.fn(),
+}))
+const config: auth.PortalConfig = {
+  clientId: 'portal', serverUri: 'https://auth.example.test', redirectUri: 'https://auth.example.test/account',
+  signup: true, policies: ['update_info', 'change_password'],
+}
+let container: HTMLDivElement
+
+beforeEach(() => {
+  vi.resetAllMocks()
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  vi.mocked(auth.request).mockResolvedValue(config)
+  vi.mocked(auth.restore).mockResolvedValue(null)
+})
+afterEach(() => { render(null, container); container.remove() })
+
+describe('ordinary-user account center', () => {
+  it('offers separate login and registration without an admin role', async () => {
+    render(<Account />, container)
+    await waitFor(() => expect(getByRole(container, 'button', { name: '注册账号' })).toBeTruthy())
+    fireEvent.click(getByRole(container, 'button', { name: '注册账号' }))
+    await waitFor(() => expect(auth.authorize).toHaveBeenCalledWith(config, undefined, true))
+  })
+  it('does not offer disabled registration', async () => {
+    vi.mocked(auth.request).mockResolvedValue({ ...config, signup: false })
+    render(<Account />, container)
+    await waitFor(() => expect(getByRole(container, 'button', { name: '登录' })).toBeTruthy())
+    expect(queryByRole(container, 'button', { name: '注册账号' })).toBeNull()
+  })
+  it('shows current-user data and only enabled policy actions', async () => {
+    vi.mocked(auth.restore).mockResolvedValue('access')
+    vi.mocked(auth.profile).mockResolvedValue({ authId: 'ordinary-user', email: 'user@example.test', emailVerified: true })
+    render(<Account />, container)
+    await waitFor(() => expect(container.textContent).toContain('user@example.test'))
+    expect(container.textContent).toContain('已验证')
+    expect(queryByRole(container, 'button', { name: '管理 Passkey' })).toBeNull()
+    fireEvent.click(getByRole(container, 'button', { name: '修改个人资料' }))
+    await waitFor(() => expect(auth.authorize).toHaveBeenCalledWith(config, 'update_info'))
+  })
+  it('escapes account text instead of rendering HTML', async () => {
+    vi.mocked(auth.restore).mockResolvedValue('access')
+    vi.mocked(auth.profile).mockResolvedValue({ authId: 'user', email: '<img src=x onerror=alert(1)>', emailVerified: false })
+    render(<Account />, container)
+    await waitFor(() => expect(container.textContent).toContain('<img src=x'))
+    expect(container.querySelector('img')).toBeNull()
+  })
+  it('ends loading and allows recovery after failed userinfo', async () => {
+    vi.mocked(auth.restore).mockResolvedValue('access')
+    vi.mocked(auth.profile).mockRejectedValue(new auth.PortalError('SESSION_EXPIRED'))
+    render(<Account />, container)
+    await waitFor(() => expect(getByRole(container, 'alert').textContent).toContain('登录已过期'))
+    expect(queryByRole(container, 'status')).toBeNull()
+    expect((getByRole(container, 'button', { name: '登录' }) as HTMLButtonElement).disabled).toBe(false)
+  })
+  it('displays unavailable configuration without a false usable entry', async () => {
+    vi.mocked(auth.request).mockRejectedValue(new auth.PortalError('NOT_CONFIGURED'))
+    render(<Account />, container)
+    await waitFor(() => expect(getByRole(container, 'alert').textContent).toContain('尚未配置'))
+    expect(queryByRole(container, 'status')).toBeNull()
+    expect(queryByRole(container, 'button', { name: '注册账号' })).toBeNull()
+  })
+  it('does not show social binding as implemented before its API exists', async () => {
+    render(<Account />, container)
+    await waitFor(() => expect(getByRole(container, 'button', { name: '登录' })).toBeTruthy())
+    expect(queryByRole(container, 'button', { name: /绑定/ })).toBeNull()
+  })
+})
diff --git a/server/src/pages/account/Account.tsx b/server/src/pages/account/Account.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a4cf3e7392465e83f074da85fa62b3eac0efb55c
