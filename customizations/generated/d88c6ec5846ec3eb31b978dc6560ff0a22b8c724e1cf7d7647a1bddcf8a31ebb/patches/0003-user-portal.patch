+++ b/server/src/pages/account/Account.tsx
@@ -0,0 +1,93 @@
+import { useEffect, useState } from 'hono/jsx'
+import * as auth from './auth'
+
+const actions: Record<string, string> = {
+  update_info: '修改个人资料', change_password: '修改密码', change_email: '修改邮箱',
+  reset_mfa: '重置多因素认证', manage_passkey: '管理 Passkey', manage_recovery_code: '管理恢复码',
+}
+const errors: Record<string, string> = {
+  SESSION_EXPIRED: '登录已过期，请重新登录。',
+  NETWORK_ERROR: '网络请求超时或失败，请重试。',
+  REQUEST_FAILED: '操作未完成，请重试或重新登录。',
+  INVALID_CALLBACK: '登录请求已失效或被取消，请重新登录。',
+  NOT_CONFIGURED: '个人中心尚未配置完成。',
+}
+
+export default function Account() {
+  const [config, setConfig] = useState<auth.PortalConfig | null>(null)
+  const [user, setUser] = useState<auth.Profile | null>(null)
+  const [accessToken, setAccessToken] = useState<string | null>(null)
+  const [busy, setBusy] = useState(true)
+  const [error, setError] = useState('')
+  const [attempt, setAttempt] = useState(0)
+
+  useEffect(() => {
+    let cancelled = false
+    setBusy(true)
+    setError('')
+    const load = async () => {
+      try {
+        const nextConfig = await auth.request<auth.PortalConfig>('/account/config')
+        if (cancelled) return
+        setConfig(nextConfig)
+        const token = await auth.restore(nextConfig)
+        if (cancelled) return
+        const nextUser = token ? await auth.profile(nextConfig, token) : null
+        if (!cancelled) { setAccessToken(token); setUser(nextUser) }
+      } catch (cause) {
+        if (!cancelled) setError(errors[cause instanceof auth.PortalError ? cause.code : 'REQUEST_FAILED'])
+      } finally {
+        if (!cancelled) setBusy(false)
+      }
+    }
+    void load()
+    return () => { cancelled = true }
+  }, [attempt])
+
+  const run = async (operation: () => Promise<void>) => {
+    if (busy) return
+    setBusy(true)
+    setError('')
+    try { await operation() } catch (cause) {
+      setError(errors[cause instanceof auth.PortalError ? cause.code : 'REQUEST_FAILED'])
+    } finally { setBusy(false) }
+  }
+  const button = 'rounded-lg border border-slate-300 px-4 py-3 text-left hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50'
+
+  return <main class='min-h-screen bg-slate-50 text-slate-900 px-4 py-12'>
+    <div class='mx-auto max-w-2xl flex flex-col gap-6'>
+      <header><p class='font-semibold text-sm'>NAccount</p><h1 class='text-3xl font-bold mt-2'>个人中心</h1></header>
+      {busy && <p role='status'>正在处理…</p>}
+      {error && <section class='rounded-lg border border-red-300 bg-red-50 p-4' role='alert'>
+        <p>{error}</p><button class={`${button} mt-3`} disabled={busy} onClick={() => setAttempt(attempt + 1)}>重试</button>
+      </section>}
+      {!user && config && <section class='flex flex-wrap gap-3' aria-label='账号入口'>
+        <button class={button} disabled={busy} onClick={() => run(() => auth.authorize(config))}>登录</button>
+        {config.signup && <button class={button} disabled={busy} onClick={() => run(() => auth.authorize(config, undefined, true))}>注册账号</button>}
+      </section>}
+      {user && config && <>
+        <section class='rounded-xl border border-slate-200 bg-white p-6'>
+          <h2 class='text-lg font-semibold mb-4'>账号资料</h2>
+          <dl class='grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 break-all'>
+            <dt>邮箱</dt><dd>{user.email || '未设置'}</dd>
+            <dt>邮箱状态</dt><dd>{user.emailVerified ? '已验证' : '未验证'}</dd>
+            <dt>姓名</dt><dd>{[user.firstName, user.lastName].filter(Boolean).join(' ') || '未设置'}</dd>
+            <dt>账号 ID</dt><dd>{user.authId}</dd>
+          </dl>
+        </section>
+        <section aria-labelledby='account-security'>
+          <h2 id='account-security' class='text-lg font-semibold mb-4'>资料与安全</h2>
+          <div class='grid gap-3 sm:grid-cols-2'>
+            {config.policies.filter((policy) => actions[policy]).map((policy) => <button key={policy} class={button} disabled={busy}
+              onClick={() => run(() => auth.authorize(config, policy))}>{actions[policy]}</button>)}
+          </div>
+        </section>
+        <button class={button} disabled={busy} onClick={() => run(async () => {
+          setUser(null)
+          setAccessToken(null)
+          await auth.logout(config, accessToken)
+        })}>退出登录</button>
+      </>}
+    </div>
+  </main>
+}
