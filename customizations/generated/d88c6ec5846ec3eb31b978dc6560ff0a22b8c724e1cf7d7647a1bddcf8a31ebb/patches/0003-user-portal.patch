+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { webcrypto } from 'node:crypto'
+import { authorize, clearSession, restore, request, profile, logout, type PortalConfig } from './auth'
+
+const config: PortalConfig = {
+  clientId: 'portal-only', serverUri: 'https://auth.example.test',
+  redirectUri: 'https://auth.example.test/account', signup: true, policies: ['update_info'],
+}
+const transactionKey = 'naccount.portal.transaction'
+const refreshKey = 'naccount.portal.refresh'
+const fetchMock = vi.fn()
+const assign = vi.fn()
+const replaceState = vi.fn()
+
+beforeEach(() => {
+  sessionStorage.clear()
+  fetchMock.mockReset()
+  assign.mockReset()
+  replaceState.mockReset()
+  vi.stubGlobal('fetch', fetchMock)
+  vi.stubGlobal('crypto', webcrypto)
+  vi.stubGlobal('window', { location: { pathname: '/account', search: '', assign }, history: { replaceState } })
+})
+afterEach(() => { vi.unstubAllGlobals(); vi.useRealTimers() })
+
+function callback(overrides = {}, query = '?code=code&state=state') {
+  window.location.search = query
+  sessionStorage.setItem(transactionKey, JSON.stringify({ state: 'state', verifier: 'v'.repeat(64), clientId: config.clientId, created: Date.now(), ...overrides }))
+}
+
+describe('portal authorization boundaries', () => {
+  it('starts registration on the interactive view with independent PKCE and state', async () => {
+    await authorize(config, undefined, true)
+    const url = new URL(assign.mock.calls[0][0])
+    const stored = JSON.parse(sessionStorage.getItem(transactionKey)!)
+    expect(url.pathname).toBe('/identity/v1/view/authorize')
+    expect(url.searchParams.get('screen')).toBe('signup')
+    expect(url.searchParams.get('client_id')).toBe(config.clientId)
+    expect(url.searchParams.get('scope')).toBe('openid profile offline_access')
+    expect(url.searchParams.get('code_challenge_method')).toBe('S256')
+    expect(url.searchParams.get('state')).toBe(stored.state)
+    expect(url.searchParams.get('code_challenge')).toHaveLength(43)
+    expect(stored.verifier).toHaveLength(64)
+    expect(stored.state).not.toBe(stored.verifier)
+  })
+  it('does not start disabled registration or arbitrary policies', async () => {
+    await expect(authorize({ ...config, signup: false }, undefined, true)).rejects.toMatchObject({ code: 'REQUEST_FAILED' })
+    await expect(authorize(config, 'arbitrary_policy')).rejects.toMatchObject({ code: 'REQUEST_FAILED' })
+    expect(assign).not.toHaveBeenCalled()
+  })
+  it('discards a refresh token after the configured portal client changes', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: 'old-client', token: 'old-token' }))
+    expect(await restore(config)).toBeNull()
+    expect(fetchMock).not.toHaveBeenCalled()
+    expect(sessionStorage.getItem(refreshKey)).toBeNull()
+  })
+  it('does not restore tokens belonging to an administrator SDK', async () => {
+    sessionStorage.setItem('melody-auth-refresh-token', 'administrator-token')
+    expect(await restore(config)).toBeNull()
+    expect(fetchMock).not.toHaveBeenCalled()
+  })
+  it('exchanges a matching one-time callback using PKCE and clears the URL', async () => {
+    callback()
+    fetchMock.mockResolvedValue(Response.json({ access_token: 'access', refresh_token: 'refresh' }))
+    expect(await restore(config)).toBe('access')
+    const body = new URLSearchParams(fetchMock.mock.calls[0][1].body)
+    expect(body.get('code_verifier')).toBe('v'.repeat(64))
+    expect(body.get('redirect_uri')).toBe(config.redirectUri)
+    expect(sessionStorage.getItem(transactionKey)).toBeNull()
+    expect(JSON.parse(sessionStorage.getItem(refreshKey)!).token).toBe('refresh')
+    expect(replaceState).toHaveBeenCalledWith(null, '', '/account')
+    await expect(restore(config)).rejects.toMatchObject({ code: 'INVALID_CALLBACK' })
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+  })
+  it.each([
+    [{ state: 'different' }, '?code=code&state=state'],
+    [{ clientId: 'admin' }, '?code=code&state=state'],
+    [{ created: Date.now() - 700000 }, '?code=code&state=state'],
+    [{ created: Date.now() + 700000 }, '?code=code&state=state'],
+    [{ created: 'invalid' }, '?code=code&state=state'],
+    [{ verifier: '' }, '?code=code&state=state'],
+    [{}, '?code=code&state=state&state=state'],
+    [{}, '?code=code&code=code&state=state'],
+    [{}, '?error=access_denied&state=state'],
+    [{}, '?code=code'],
+    [{}, '?state=state'],
+  ])('rejects malformed, stale or cross-client callbacks', async (overrides, query) => {
+    callback(overrides, query)
+    await expect(restore(config)).rejects.toMatchObject({ code: 'INVALID_CALLBACK' })
+    expect(fetchMock).not.toHaveBeenCalled()
+    expect(sessionStorage.getItem(transactionKey)).toBeNull()
+    expect(replaceState).toHaveBeenCalled()
+  })
+  it('rejects corrupted persisted state without leaking it', async () => {
+    callback()
+    sessionStorage.setItem(transactionKey, '{secret')
+    await expect(restore(config)).rejects.toMatchObject({ message: 'INVALID_CALLBACK' })
+  })
+  it('restores and rotates only the portal refresh token', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: 'refresh' }))
+    fetchMock.mockResolvedValue(Response.json({ access_token: 'access', refresh_token: 'rotated' }))
+    expect(await restore(config)).toBe('access')
+    expect(JSON.parse(sessionStorage.getItem(refreshKey)!).token).toBe('rotated')
+  })
+  it('clears a rejected refresh token', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: 'expired' }))
+    fetchMock.mockResolvedValue(new Response('sensitive upstream body', { status: 401 }))
+    await expect(restore(config)).rejects.toMatchObject({ message: 'SESSION_EXPIRED' })
+    expect(sessionStorage.getItem(refreshKey)).toBeNull()
+  })
+  it('keeps a refresh token during a transient network failure', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: 'refresh' }))
+    fetchMock.mockRejectedValue(new Error('sensitive request detail'))
+    await expect(restore(config)).rejects.toMatchObject({ message: 'NETWORK_ERROR' })
+    expect(JSON.parse(sessionStorage.getItem(refreshKey)!).token).toBe('refresh')
+  })
+  it('reads only the current user endpoint', async () => {
+    fetchMock.mockResolvedValue(Response.json({ authId: 'ordinary-user', emailVerified: true }))
+    expect(await profile(config, 'access')).toMatchObject({ authId: 'ordinary-user' })
+    expect(fetchMock.mock.calls[0][0]).toBe(`${config.serverUri}/oauth2/v1/userinfo`)
+    expect(fetchMock.mock.calls[0][1].headers).toEqual({ Authorization: 'Bearer access' })
+  })
+  it('clears local state even if remote logout fails, without claiming remote success', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: 'refresh' }))
+    fetchMock.mockRejectedValue(new Error('network'))
+    await expect(logout(config, 'access')).rejects.toMatchObject({ code: 'NETWORK_ERROR' })
+    expect(sessionStorage.getItem(refreshKey)).toBeNull()
+    expect(assign).not.toHaveBeenCalled()
+  })
+  it('never follows an upstream logout redirect', async () => {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: 'refresh' }))
+    fetchMock.mockResolvedValue(Response.json({ redirectUri: 'https://evil.example' }))
+    await logout(config, 'access')
+    expect(assign.mock.calls[0][0]).toContain(`${config.serverUri}/oauth2/v1/logout?`)
+  })
+  it('aborts a stalled request after 15 seconds', async () => {
+    vi.useFakeTimers()
+    fetchMock.mockImplementation((_url, { signal }) => new Promise((_resolve, reject) => {
+      signal.addEventListener('abort', () => reject(new Error('aborted')))
+    }))
+    const result = expect(request('/account/config')).rejects.toMatchObject({ code: 'NETWORK_ERROR' })
+    await vi.advanceTimersByTimeAsync(15000)
+    await result
+  })
+  it('does not erase other applications storage', () => {
+    sessionStorage.setItem('another-app', 'keep')
+    clearSession()
+    expect(sessionStorage.getItem('another-app')).toBe('keep')
+  })
+})
diff --git a/server/src/pages/account/auth.ts b/server/src/pages/account/auth.ts
new file mode 100644
index 0000000000000000000000000000000000000000..42ca8fe78ba13466158f38aef42c68b33b197680
--- /dev/null
+++ b/server/src/pages/account/auth.ts
@@ -0,0 +1,148 @@
+export interface PortalConfig {
+  clientId: string;
+  serverUri: string;
+  redirectUri: string;
+  signup: boolean;
+  policies: string[];
+}
+
+export interface Profile {
+  authId: string;
+  email: string | null;
+  emailVerified: boolean;
+  firstName?: string | null;
+  lastName?: string | null;
+}
+
+const transactionKey = 'naccount.portal.transaction'
+const refreshKey = 'naccount.portal.refresh'
+const transactionTtl = 10 * 60 * 1000
+
+export class PortalError extends Error {
+  constructor(public code: 'SESSION_EXPIRED' | 'NETWORK_ERROR' | 'REQUEST_FAILED' | 'INVALID_CALLBACK' | 'NOT_CONFIGURED') {
+    super(code)
+  }
+}
+
+export async function request<T>(url: string, options: RequestInit = {}): Promise<T> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), 15000)
+  try {
+    const response = await fetch(url, { ...options, signal: controller.signal, cache: 'no-store' })
+    if (!response.ok) {
+      // Do not expose upstream bodies: they can contain account or token data.
+      throw new PortalError(response.status === 401 ? 'SESSION_EXPIRED' : response.status === 503 ? 'NOT_CONFIGURED' : 'REQUEST_FAILED')
+    }
+    return await response.json() as T
+  } catch (error) {
+    if (error instanceof PortalError) throw error
+    throw new PortalError('NETWORK_ERROR')
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+const random = () => {
+  const bytes = crypto.getRandomValues(new Uint8Array(32))
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export const clearSession = () => {
+  sessionStorage.removeItem(refreshKey)
+  sessionStorage.removeItem(transactionKey)
+}
+
+function refreshFor(config: PortalConfig): string | null {
+  try {
+    const value = JSON.parse(sessionStorage.getItem(refreshKey) ?? 'null')
+    if (value?.clientId === config.clientId && typeof value.token === 'string' && value.token) return value.token
+  } catch { /* Corrupt browser storage is not an authenticated session. */ }
+  sessionStorage.removeItem(refreshKey)
+  return null
+}
+
+export async function authorize(config: PortalConfig, policy?: string, signup = false) {
+  if (policy && !config.policies.includes(policy)) throw new PortalError('REQUEST_FAILED')
+  if (signup && !config.signup) throw new PortalError('REQUEST_FAILED')
+  const verifier = random()
+  const state = random()
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(verifier)))
+  const challenge = btoa(String.fromCharCode(...digest)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+  sessionStorage.setItem(transactionKey, JSON.stringify({ state, verifier, created: Date.now(), clientId: config.clientId }))
+  const params = new URLSearchParams({
+    response_type: 'code', client_id: config.clientId, redirect_uri: config.redirectUri,
+    state, code_challenge: challenge, code_challenge_method: 'S256',
+    scope: 'openid profile offline_access', authorize_method: 'redirect',
+    policy: policy ?? 'sign_in_or_sign_up',
+  })
+  if (signup) params.set('screen', 'signup')
+  // Registration deliberately starts at the validated interactive view, not an existing SSO session.
+  const path = signup ? '/identity/v1/view/authorize' : '/oauth2/v1/authorize'
+  window.location.assign(`${config.serverUri}${path}?${params}`)
+}
+
+interface Tokens { access_token: string; refresh_token?: string }
+
+async function token(config: PortalConfig, data: Record<string, string>) {
+  const result = await request<Tokens>(`${config.serverUri}/oauth2/v1/token`, {
+    method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams(data).toString(),
+  })
+  if (!result.access_token || typeof result.access_token !== 'string') throw new PortalError('REQUEST_FAILED')
+  if (result.refresh_token && typeof result.refresh_token === 'string') {
+    sessionStorage.setItem(refreshKey, JSON.stringify({ clientId: config.clientId, token: result.refresh_token }))
+  }
+  return result.access_token
+}
+
+export async function restore(config: PortalConfig): Promise<string | null> {
+  const params = new URLSearchParams(window.location.search)
+  if (params.has('code') || params.has('state') || params.has('error')) {
+    const stored = sessionStorage.getItem(transactionKey)
+    sessionStorage.removeItem(transactionKey)
+    sessionStorage.removeItem(refreshKey)
+    // Remove authorization material even on denial, malformed state or network failure.
+    window.history.replaceState(null, '', window.location.pathname)
+    let transaction
+    try { transaction = JSON.parse(stored ?? 'null') } catch { throw new PortalError('INVALID_CALLBACK') }
+    if (!transaction || params.has('error') || params.getAll('code').length !== 1 || params.getAll('state').length !== 1 ||
+      !params.get('code') || !params.get('state') || params.get('state') !== transaction.state ||
+      transaction.clientId !== config.clientId || typeof transaction.verifier !== 'string' || transaction.verifier.length !== 64 ||
+      !Number.isFinite(transaction.created) || Date.now() - transaction.created > transactionTtl || transaction.created > Date.now()) {
+      throw new PortalError('INVALID_CALLBACK')
+    }
+    // Never fall back to another stored account after a failed callback.
+    sessionStorage.removeItem(refreshKey)
+    return token(config, {
+      grant_type: 'authorization_code', code: params.get('code')!,
+      redirect_uri: config.redirectUri, code_verifier: transaction.verifier,
+    })
+  }
+  const refresh = refreshFor(config)
+  if (!refresh) return null
+  try {
+    return await token(config, { grant_type: 'refresh_token', refresh_token: refresh })
+  } catch (error) {
+    if (error instanceof PortalError && ['SESSION_EXPIRED', 'REQUEST_FAILED'].includes(error.code)) clearSession()
+    throw error
+  }
+}
+
+export const profile = (config: PortalConfig, accessToken: string) => request<Profile>(`${config.serverUri}/oauth2/v1/userinfo`, {
+  headers: { Authorization: `Bearer ${accessToken}` },
+})
+
+export async function logout(config: PortalConfig, accessToken: string | null) {
+  const refresh = refreshFor(config)
+  clearSession()
+  if (refresh && accessToken) {
+    await request(`${config.serverUri}/identity/v1/logout`, {
+      method: 'POST',
+      headers: { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/x-www-form-urlencoded' },
+      body: new URLSearchParams({ refresh_token: refresh, post_logout_redirect_uri: config.redirectUri }).toString(),
+    })
+  }
+  // The server clears the SSO cookie too; never follow a response-controlled redirect.
+  const params = new URLSearchParams({ client_id: config.clientId, post_logout_redirect_uri: config.redirectUri })
+  window.location.assign(`${config.serverUri}/oauth2/v1/logout?${params}`)
+}
