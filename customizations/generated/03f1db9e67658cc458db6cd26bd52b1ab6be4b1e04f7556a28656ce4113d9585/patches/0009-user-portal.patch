+++ b/server/src/__tests__/normal/request-latency.test.ts
@@ -0,0 +1,66 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Hono } from 'hono'
+import { typeConfig, routeConfig } from 'configs'
+import { session } from 'middlewares/setup'
+import { kvService } from 'services'
+
+afterEach(() => vi.restoreAllMocks())
+
+describe('stateless request session budget', () => {
+  it.each([
+    '/', '/account', '/account/', '/account/config', '/account/api/profile', '/account/api/apps',
+    '/.well-known/openid-configuration', '/.well-known/jwks.json',
+    routeConfig.OauthRoute.Token, routeConfig.OauthRoute.Userinfo, routeConfig.OauthRoute.Revoke,
+    routeConfig.IdentityRoute.AuthorizeView, routeConfig.IdentityRoute.ProcessView,
+    routeConfig.IdentityRoute.SendEmailMfa, routeConfig.IdentityRoute.SendPasswordlessCode,
+    routeConfig.IdentityRoute.ResetPasswordCode, routeConfig.IdentityRoute.ChangeEmailCode,
+    routeConfig.IdentityRoute.ResendSmsMfa,
+  ])('does not read or seal an SSO cookie for %s', async (path) => {
+    const secret = vi.spyOn(kvService, 'getSessionSecret').mockRejectedValue(new Error('unnecessary KV request'))
+    const app = new Hono<typeConfig.Context>()
+    app.use('*', session)
+    app.all('*', (c) => c.text('stateless'))
+    const response = await app.request(path, {}, { SERVER_SESSION_EXPIRES_IN: 1800 } as typeConfig.Bindings)
+    expect(response.status).toBe(200)
+    expect(secret).not.toHaveBeenCalled()
+    expect(response.headers.get('Set-Cookie')).toBeNull()
+  })
+
+  it.each([routeConfig.OauthRoute.Authorize, routeConfig.OauthRoute.Logout,
+    routeConfig.IdentityRoute.Logout, routeConfig.IdentityRoute.AuthorizeAccount,
+    routeConfig.IdentityRoute.AuthorizePassword, routeConfig.IdentityRoute.ProcessEmailMfa,
+    routeConfig.IdentityRoute.ProcessPasswordlessCode, routeConfig.IdentityRoute.ProcessOtpMfa,
+    routeConfig.IdentityRoute.ProcessSmsMfa, '/identity/v1/future-unreviewed-route',
+  ])('still requires the real SSO key for %s', async (path) => {
+    const secret = vi.spyOn(kvService, 'getSessionSecret').mockRejectedValue(new Error('key unavailable'))
+    const app = new Hono<typeConfig.Context>()
+    app.use('*', session)
+    app.all('*', (c) => c.text('session'))
+    const response = await app.request(path, {}, { SERVER_SESSION_EXPIRES_IN: 1800 } as typeConfig.Bindings)
+    expect(response.status).toBe(500)
+    expect(secret).toHaveBeenCalledOnce()
+  })
+
+  it('retains the encrypted SSO cookie through an intervening stateless view', async () => {
+    vi.spyOn(kvService, 'getSessionSecret').mockResolvedValue('test-session-key-with-at-least-32-characters')
+    const app = new Hono<typeConfig.Context>()
+    app.use('*', session)
+    app.get(routeConfig.IdentityRoute.AuthorizeAccount, (c) => {
+      c.get('session').set('authId', 'test-subject')
+      return c.text('signed in')
+    })
+    app.get('/account', (c) => c.text('stateless'))
+    app.get(routeConfig.OauthRoute.Authorize, (c) => c.text(c.get('session').get('authId') as string))
+    const env = { SERVER_SESSION_EXPIRES_IN: 1800 } as typeConfig.Bindings
+    const signedIn = await app.request(routeConfig.IdentityRoute.AuthorizeAccount, {}, env)
+    expect(signedIn.status).toBe(200)
+    // CookieStore emits the initial cookie before persisting the authenticated one.
+    const cookie = signedIn.headers.getSetCookie().at(-1)!.split(';')[0]
+    expect(cookie).toBeTruthy()
+    const view = await app.request('/account', { headers: { Cookie: cookie } }, env)
+    expect(view.headers.get('Set-Cookie')).toBeNull()
+    const authorized = await app.request(routeConfig.OauthRoute.Authorize, { headers: { Cookie: cookie } }, env)
+    expect(authorized.status).toBe(200)
+    expect(await authorized.text()).toBe('test-subject')
+  })
+})
