@@ -0,0 +1,58 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from 'hono'
+import { ClientType } from '@melody-auth/shared'
+import { Database } from 'better-sqlite3'
+import { migrate, mock } from 'tests/mock'
+import { jwtService } from 'services'
+import { userModel } from 'models'
+import { typeConfig } from 'configs'
+import { timeUtil } from 'utils'
+import account from 'routes/account'
+
+let db: Database
+let env: typeConfig.Bindings
+let token: string
+beforeEach(async () => {
+  db = await migrate()
+  db.prepare("INSERT INTO user(authId,email,otpSecret) VALUES('budget-user','budget@example.test','')").run()
+  db.prepare('UPDATE app SET redirectUris=? WHERE clientId=?').run('https://auth.example.test/account', 'naccount-user-portal')
+  env = { ...process.env, ...mock(db), AUTH_SERVER_URL: 'https://auth.example.test',
+    NACCOUNT_PORTAL_CLIENT_ID: 'naccount-user-portal', PG_CONNECTION_STRING: '' } as unknown as typeConfig.Bindings
+  const context = new Context(new Request('https://auth.example.test'), { env })
+  token = (await jwtService.genAccessToken(context, ClientType.SPA, timeUtil.getCurrentTimestamp(),
+    'budget-user', 'naccount-user-portal', 'openid profile')).accessToken
+})
+afterEach(() => { db.close(); vi.restoreAllMocks() })
+const get = (path = '/account/api/profile') => account.request(path, { headers: { Authorization: 'Bearer ' + token } }, env)
+
+describe('authenticated portal round-trip budget', () => {
+  it('checks the current user exactly once per profile request, not twice', async () => {
+    const reads = vi.spyOn(userModel, 'getByAuthId')
+    expect((await get()).status).toBe(200)
+    expect(reads).toHaveBeenCalledTimes(1)
+    expect((await get()).status).toBe(200)
+    expect(reads).toHaveBeenCalledTimes(2)
+  })
+
+  it.each(['version', 'disabled', 'deleted'])('does not cache the user across requests after %s changes', async (kind) => {
+    expect((await get()).status).toBe(200)
+    if (kind === 'version') db.prepare('UPDATE user SET securityVersion=securityVersion+1').run()
+    if (kind === 'disabled') db.prepare('UPDATE user SET isActive=0').run()
+    if (kind === 'deleted') db.prepare('UPDATE user SET deletedAt=CURRENT_TIMESTAMP').run()
+    expect((await get()).status).toBe(401)
+  })
+
+  it('loads 100 public apps in one catalogue statement and preserves explicit catalogue order', async () => {
+    const ids = Array.from({ length: 100 }, (_, i) => `budget-${i}`)
+    for (const id of ids) db.prepare('INSERT INTO app(name,type,clientId) VALUES(?,?,?)').run(id, 'spa', id)
+    env.NACCOUNT_PUBLIC_APP_IDS = [...ids].reverse()
+    const reads = vi.spyOn(env.DB, 'prepare')
+    const response = await get('/account/api/apps')
+    expect(response.status).toBe(200)
+    const body = await response.json() as { apps: { clientId: string; authorized: boolean }[] }
+    expect(body.apps.map((entry) => entry.clientId)).toEqual(env.NACCOUNT_PUBLIC_APP_IDS)
+    expect(body.apps.every((entry) => entry.authorized === false)).toBe(true)
+    // Current user, portal client, catalogue. No per-app remote round trips.
+    expect(reads).toHaveBeenCalledTimes(3)
+  })
+})
diff --git a/server/src/__tests__/normal/request-latency.test.ts b/server/src/__tests__/normal/request-latency.test.ts
