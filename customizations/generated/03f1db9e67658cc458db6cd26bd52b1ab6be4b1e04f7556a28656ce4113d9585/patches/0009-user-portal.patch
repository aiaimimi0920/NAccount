@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest'
+import { Hono } from 'hono'
+import { typeConfig } from 'configs'
+import { timed } from './timing'
+
+describe('safe timing headers', () => {
+  it('preserves the response and appends fixed numeric stage names only', async () => {
+    const app = new Hono<typeConfig.Context>()
+    app.use('*', (c, next) => timed(c, 'app', next))
+    app.get('*', async (c) => {
+      await timed(c, 'email-provider', () => ({ messageId: 'private-provider-id', code: '123456' }))
+      return c.json({ success: true })
+    })
+    const response = await app.request('/?private=do-not-log')
+    expect(await response.json()).toEqual({ success: true })
+    expect(response.headers.get('Server-Timing')).toMatch(/^email-provider;dur=\d+\.\d, app;dur=\d+\.\d$/)
+    expect(response.headers.get('Server-Timing')).not.toMatch(/private|123456/)
+  })
+})
diff --git a/server/src/utils/timing.ts b/server/src/utils/timing.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ab34486ebbc0de9db354b9dacc44533744801b2
--- /dev/null
+++ b/server/src/utils/timing.ts
@@ -0,0 +1,12 @@
+import { Context } from 'hono'
+import { typeConfig } from 'configs'
+
+// Fixed names and numeric durations only: never put request data or provider responses here.
+export async function timed<T>(c: Context<typeConfig.Context>, name: 'app' | 'session-key' | 'email-provider', operation: () => T | Promise<T>): Promise<T> {
+  const started = performance.now()
+  try {
+    return await operation()
+  } finally {
+    c.header('Server-Timing', `${name};dur=${Math.max(0, performance.now() - started).toFixed(1)}`, { append: true })
+  }
+}
