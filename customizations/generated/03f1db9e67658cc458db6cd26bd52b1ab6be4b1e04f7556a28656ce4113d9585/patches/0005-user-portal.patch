diff --git a/server/migrations/sqlite/0050_naccount_security.sql b/server/migrations/sqlite/0050_naccount_security.sql
new file mode 100644
index 0000000000000000000000000000000000000000..78bdfe6fb2d9e1a66bd1de716de396552e45c411
--- /dev/null
+++ b/server/migrations/sqlite/0050_naccount_security.sql
@@ -0,0 +1,82 @@
+ALTER TABLE user ADD COLUMN securityVersion INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE naccount_profile ADD COLUMN phone TEXT;
+CREATE UNIQUE INDEX naccount_contact_phone_unique ON naccount_profile(phone) WHERE phone IS NOT NULL;
+
+CREATE TABLE naccount_security_request (
+  id TEXT PRIMARY KEY,
+  userId INTEGER NOT NULL REFERENCES user(id),
+  version INTEGER NOT NULL,
+  action TEXT NOT NULL CHECK(action IN ('email','phone','password','otp-enable','otp-disable','delete')),
+  target TEXT NOT NULL DEFAULT '',
+  guard TEXT NOT NULL,
+  payload TEXT NOT NULL DEFAULT '{}',
+  proofs TEXT NOT NULL DEFAULT '{}',
+  tokenHash TEXT NOT NULL,
+  createdAt INTEGER NOT NULL,
+  expiresAt INTEGER NOT NULL,
+  attempts INTEGER NOT NULL DEFAULT 0,
+  ready INTEGER NOT NULL DEFAULT 0,
+  used INTEGER NOT NULL DEFAULT 0
+);
+CREATE INDEX naccount_security_user_time ON naccount_security_request(userId,createdAt);
+CREATE INDEX naccount_security_target_time ON naccount_security_request(target,createdAt);
+CREATE TABLE naccount_security_limit (bucket TEXT PRIMARY KEY, count INTEGER NOT NULL, expiresAt INTEGER NOT NULL);
+CREATE TABLE naccount_otp_use (userId INTEGER NOT NULL, secretHash TEXT NOT NULL, step INTEGER NOT NULL, PRIMARY KEY(userId,secretHash,step));
+
+-- Validation and application share one SQLite transaction. A failed trigger rolls back consumption.
+CREATE TRIGGER naccount_security_apply BEFORE UPDATE OF used ON naccount_security_request
+WHEN NEW.used=1 AND OLD.used=0
+BEGIN
+  SELECT CASE WHEN OLD.ready<>1 OR OLD.attempts>5 OR OLD.expiresAt<=CAST(strftime('%s','now') AS INTEGER)*1000
+    THEN RAISE(ABORT,'security_request_invalid') END;
+  SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM user WHERE id=OLD.userId AND isActive=1 AND deletedAt IS NULL AND securityVersion=OLD.version
+    AND COALESCE(password,'')=json_extract(OLD.guard,'$.password')
+    AND COALESCE(email,'')=json_extract(OLD.guard,'$.email')
+    AND otpSecret=json_extract(OLD.guard,'$.otpSecret')
+    AND mfaTypes=json_extract(OLD.guard,'$.mfaTypes')
+    AND emailVerified=json_extract(OLD.guard,'$.emailVerified')
+    AND otpVerified=json_extract(OLD.guard,'$.otpVerified')
+    AND COALESCE(smsPhoneNumber,'')=json_extract(OLD.guard,'$.smsPhoneNumber')
+    AND smsPhoneNumberVerified=json_extract(OLD.guard,'$.smsPhoneNumberVerified')
+    AND COALESCE(recoveryCodeHash,'')=json_extract(OLD.guard,'$.recoveryCodeHash'))
+    THEN RAISE(ABORT,'security_owner_changed') END;
+  SELECT CASE WHEN OLD.action='email' AND EXISTS(SELECT 1 FROM user WHERE id<>OLD.userId AND deletedAt IS NULL AND lower(trim(email))=OLD.target)
+    THEN RAISE(ABORT,'security_email_unavailable') END;
+  SELECT CASE WHEN OLD.action='delete' AND EXISTS(SELECT 1 FROM user_role ur JOIN role r ON r.id=ur.roleId WHERE ur.userId=OLD.userId AND ur.deletedAt IS NULL AND r.name='super_admin' AND r.deletedAt IS NULL)
+    AND NOT EXISTS(SELECT 1 FROM user_role ur JOIN role r ON r.id=ur.roleId JOIN user u ON u.id=ur.userId WHERE u.id<>OLD.userId AND u.isActive=1 AND u.deletedAt IS NULL AND ur.deletedAt IS NULL AND r.name='super_admin' AND r.deletedAt IS NULL)
+    THEN RAISE(ABORT,'security_last_admin') END;
+
+  UPDATE user SET
+    email=CASE WHEN OLD.action='email' THEN OLD.target WHEN OLD.action='delete' THEN NULL ELSE email END,
+    emailVerified=CASE WHEN OLD.action='email' THEN 1 WHEN OLD.action='delete' THEN 0 ELSE emailVerified END,
+    password=CASE WHEN OLD.action='password' THEN json_extract(OLD.payload,'$.password') WHEN OLD.action='delete' THEN NULL ELSE password END,
+    otpSecret=CASE WHEN OLD.action='otp-enable' THEN json_extract(OLD.payload,'$.secret') WHEN OLD.action IN ('otp-disable','delete') THEN '' ELSE otpSecret END,
+    otpVerified=CASE WHEN OLD.action='otp-enable' THEN 1 WHEN OLD.action IN ('otp-disable','delete') THEN 0 ELSE otpVerified END,
+    mfaTypes=CASE WHEN OLD.action IN ('otp-enable','otp-disable') THEN json_extract(OLD.payload,'$.mfaTypes') WHEN OLD.action='delete' THEN '' ELSE mfaTypes END,
+    recoveryCodeHash=CASE WHEN OLD.action='otp-enable' THEN json_extract(OLD.payload,'$.recoveryHash') WHEN OLD.action IN ('otp-disable','delete') THEN NULL ELSE recoveryCodeHash END,
+    firstName=CASE WHEN OLD.action='delete' THEN NULL ELSE firstName END,
+    lastName=CASE WHEN OLD.action='delete' THEN NULL ELSE lastName END,
+    linkedAuthId=CASE WHEN OLD.action='delete' THEN NULL ELSE linkedAuthId END,
+    invitationToken=CASE WHEN OLD.action='delete' THEN NULL ELSE invitationToken END,
+    invitationExpiresAt=CASE WHEN OLD.action='delete' THEN NULL ELSE invitationExpiresAt END,
+    orgSlug=CASE WHEN OLD.action='delete' THEN '' ELSE orgSlug END,
+    smsPhoneNumber=CASE WHEN OLD.action='delete' THEN NULL ELSE smsPhoneNumber END,
+    smsPhoneNumberVerified=CASE WHEN OLD.action='delete' THEN 0 ELSE smsPhoneNumberVerified END,
+    isActive=CASE WHEN OLD.action='delete' THEN 0 ELSE isActive END,
+    deletedAt=CASE WHEN OLD.action='delete' THEN CURRENT_TIMESTAMP ELSE deletedAt END,
+    securityVersion=securityVersion+1, updatedAt=CURRENT_TIMESTAMP
+    WHERE id=OLD.userId;
+  INSERT INTO naccount_profile(userId,phone) SELECT OLD.userId,OLD.target WHERE OLD.action='phone'
+    ON CONFLICT(userId) DO UPDATE SET phone=excluded.phone;
+  DELETE FROM naccount_profile WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_app_consent WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_passkey WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_attribute_value WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_role WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_org WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM user_org_group WHERE userId=OLD.userId AND OLD.action='delete';
+  DELETE FROM naccount_link_request WHERE userId=OLD.userId;
+  UPDATE naccount_social_identity SET label='' WHERE userId=OLD.userId AND OLD.action='delete';
+  UPDATE naccount_security_request SET guard='{}',payload='{}',proofs='{}',tokenHash='',ready=0
+    WHERE userId=OLD.userId AND id<>OLD.id;
+END;
diff --git a/server/src/__tests__/normal/account-epoch.test.ts b/server/src/__tests__/normal/account-epoch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5782a4ad6122b9e3ba6341973accfa83468b56da
--- /dev/null
+++ b/server/src/__tests__/normal/account-epoch.test.ts
@@ -0,0 +1,65 @@
+import { beforeEach, afterEach, describe, expect, it } from 'vitest'
+import { Context } from 'hono'
+import { ClientType } from '@melody-auth/shared'
+import { Database } from 'better-sqlite3'
+import { migrate, mock, session } from 'tests/mock'
+import { jwtService, kvService, oauthService, identityService, sessionService } from 'services'
+import { userModel } from 'models'
+import { typeConfig } from 'configs'
+import { timeUtil } from 'utils'
+import { getAuthCodeBody } from 'handlers/identity/mfa'
+let db: Database
+let c: Context<typeConfig.Context>
+beforeEach(async()=>{
+  db=await migrate()
+  db.prepare("INSERT INTO user(authId,email,otpSecret) VALUES('epoch-user','epoch@example.test','')").run()
+  c=new Context(new Request('http://localhost:8787'),{env:{...process.env,...mock(db),SERVER_SESSION_EXPIRES_IN:3600}})
+  c.set('session',session as never)
+})
+afterEach(()=>db.close())
+const snapshot=async()=> (await userModel.getByAuthId(c.env.DB,'epoch-user'))!
+const revoke=()=>db.prepare("UPDATE user SET securityVersion=securityVersion+1 WHERE authId='epoch-user'").run()
+describe('user security epoch',()=>{
+  it('rejects old signed access JWT and accepts a freshly authenticated version',async()=>{
+    const original=await jwtService.genAccessToken(c,ClientType.SPA,timeUtil.getCurrentTimestamp(),'epoch-user','portal','profile')
+    expect((await jwtService.getAccessTokenBody(c,original.accessToken)).securityVersion).toBe(0)
+    revoke()
+    await expect(jwtService.getAccessTokenBody(c,original.accessToken)).rejects.toThrow('ACCOUNT_SESSION_REVOKED')
+    await expect(jwtService.genAccessToken(c,ClientType.SPA,timeUtil.getCurrentTimestamp(),'epoch-user','portal','profile')).rejects.toThrow()
+    const fresh=await jwtService.genAccessToken(c,ClientType.SPA,timeUtil.getCurrentTimestamp(),'epoch-user','portal','profile',[],undefined,1)
+    expect((await jwtService.getAccessTokenBody(c,fresh.accessToken)).securityVersion).toBe(1)
+  })
+  it('does not treat service tokens as user sessions',async()=>{
+    const result=await jwtService.genAccessToken(c,ClientType.S2S,timeUtil.getCurrentTimestamp(),'service','service','read_user')
+    expect((await jwtService.getAccessTokenBody(c,result.accessToken)).tokenType).toBe('service')
+  })
+  it('refuses old refresh tokens without minting a new version',async()=>{
+    await kvService.storeRefreshToken(c.env.KV,'epoch-refresh',{authId:'epoch-user',clientId:'portal',scope:'profile',roles:[],securityVersion:0,expiredAt:timeUtil.getCurrentTimestamp()+3600},3600)
+    revoke()
+    await expect(oauthService.handleRefreshTokenTokenExchange(c,{refreshToken:'epoch-refresh'} as never)).rejects.toThrow()
+  })
+  it('invalidates SSO cookies and already-secured authorization codes',async()=>{
+    const body={user:await snapshot(),request:{clientId:'portal'},isSecured:true} as typeConfig.AuthCodeBody
+    sessionService.setAuthInfoSession(c,body)
+    expect(await sessionService.getAuthInfoSession(c,'portal')).toBeTruthy()
+    await kvService.storeAuthCode(c.env.KV,'epoch-code',body,600)
+    revoke()
+    expect(await sessionService.getAuthInfoSession(c,'portal')).toBeNull()
+    await expect(identityService.ensureAuthCodeIsSecured(c,'epoch-code',body)).rejects.toThrow('ACCOUNT_SESSION_REVOKED')
+    await expect(getAuthCodeBody(c,'epoch-code')).rejects.toThrow('ACCOUNT_SESSION_REVOKED')
+  })
+  it('rejects disabled and deleted users even when versions match',async()=>{
+    const token=await jwtService.genAccessToken(c,ClientType.SPA,timeUtil.getCurrentTimestamp(),'epoch-user','portal','profile')
+    db.prepare('UPDATE user SET isActive=0').run()
+    await expect(jwtService.getAccessTokenBody(c,token.accessToken)).rejects.toThrow()
+    db.prepare('UPDATE user SET isActive=1,deletedAt=CURRENT_TIMESTAMP').run()
+    await expect(jwtService.getAccessTokenBody(c,token.accessToken)).rejects.toThrow()
+  })
+  it('binds remembered device proofs to the authenticated version',async()=>{
+    await kvService.storeOtpMfaRememberDevice(c.env.KV,1,'0.fixture','proof')
+    expect(await kvService.verifyOtpMfaRememberDevice(c.env.KV,1,'0.fixture-proof',0)).toBeTruthy()
+    expect(await kvService.verifyOtpMfaRememberDevice(c.env.KV,1,'0.fixture-proof',1)).toBe(false)
+    await kvService.storeOtpMfaRememberDevice(c.env.KV,1,'1.fixture','proof')
+    expect(await kvService.verifyOtpMfaRememberDevice(c.env.KV,1,'1.fixture-proof',1)).toBeTruthy()
+  })
+})
\ No newline at end of file
diff --git a/server/src/__tests__/normal/account-profile.test.ts b/server/src/__tests__/normal/account-profile.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b9c0ace35dd876fcd4a8433f342352ec0accdc68
--- /dev/null
+++ b/server/src/__tests__/normal/account-profile.test.ts
@@ -0,0 +1,76 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { Database } from 'better-sqlite3'
+import { migrate, mock } from 'tests/mock'
+import { typeConfig } from 'configs'
+import { jwtService } from 'services'
+import account from 'routes/account'
+
+let db: Database
+let env: typeConfig.Bindings
+beforeEach(async () => {
+  db = await migrate()
+  db.prepare('INSERT INTO user(authId,email,password,emailVerified,otpSecret,firstName) VALUES(?,?,?,?,?,?)').run('owner','owner@example.test','private-password-hash',1,'private-otp','Original')
+  db.prepare('INSERT INTO user(authId,email,otpSecret) VALUES(?,?,?)').run('other','other@example.test','other-otp')
+  db.prepare('UPDATE app SET redirectUris=? WHERE clientId=?').run('https://auth.example.test/account','naccount-user-portal')
+  env = { ...process.env, ...mock(db), AUTH_SERVER_URL:'https://auth.example.test', NACCOUNT_PORTAL_CLIENT_ID:'naccount-user-portal', PG_CONNECTION_STRING:'' } as unknown as typeConfig.Bindings
+  vi.spyOn(jwtService,'getAccessTokenBody').mockImplementation(async (_c, token) => {
+    if (!['owner','other','wrong-client','no-profile'].includes(token)) return null as any
+    return { sub:token === 'other' ? 'other' : 'owner', azp:token === 'wrong-client' ? 'admin-client' : 'naccount-user-portal', scope:token === 'no-profile' ? 'openid' : 'openid profile' } as typeConfig.AccessTokenBody
+  })
+})
+afterEach(() => { db.close(); vi.restoreAllMocks() })
+const get = (path='/account/api/profile', token='owner') => account.request(path,{headers:{Authorization:'Bearer '+token}},env)
+const patch = (body: unknown, token='owner') => account.request('/account/api/profile', {
+  method:'PATCH', headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body),
+},env)
+
+describe('portal profile and catalogue (D1)', () => {
+  it('exposes an explicit safe DTO, not secrets or unverified phone numbers', async () => {
+    db.prepare('UPDATE user SET smsPhoneNumber=?,smsPhoneNumberVerified=0').run('+12025550147')
+    const response = await get()
+    expect(response.status).toBe(200)
+    const body = await response.json()
+    expect(body).toMatchObject({authId:'owner',nickname:'Original',signature:'',phone:null,otpEnabled:false,canEdit:true})
+    expect(Object.keys(body as object).sort()).toEqual(['authId','email','emailVerified','nickname','signature','phone','otpEnabled','canEdit','canUsePolicies'].sort())
+    expect(JSON.stringify(body)).not.toContain('private-')
+  })
+  it('persists nickname/signature independently without rewriting names or other users', async () => {
+    expect((await patch({nickname:'测试昵称'})).status).toBe(200)
+    expect((await patch({signature:'真实保存的签名'})).status).toBe(200)
+    expect(await (await get()).json()).toMatchObject({nickname:'测试昵称',signature:'真实保存的签名'})
+    expect(await (await get('/account/api/profile','other')).json()).toMatchObject({nickname:'',signature:''})
+    expect(db.prepare('SELECT firstName FROM user WHERE authId=?').get('owner')).toEqual({firstName:'Original'})
+    expect((await patch({signature:''})).status).toBe(200)
+  })
+  it.each([{nickname:''},{nickname:'x'.repeat(41)},{signature:'x'.repeat(121)},{nickname:' x'}, {signature:'line\nbreak'}, {authId:'other'}, {nickname:'x',authId:'other'}, null, [], {signature:42}])('rejects invalid or identity-controlling input %j', async (body) => {
+    expect((await patch(body)).status).not.toBe(200)
+    expect(db.prepare('SELECT COUNT(*) AS count FROM naccount_profile').get()).toEqual({count:0})
+  })
+  it.each(['wrong-client','no-profile','invalid'])('rejects inappropriate token %s on all surfaces', async (token) => {
+    expect((await get('/account/api/profile',token)).status).not.toBe(200)
+    expect((await get('/account/api/apps',token)).status).not.toBe(200)
+    expect((await patch({nickname:'x'},token)).status).not.toBe(200)
+  })
+  it.each(['user-disabled','user-deleted','client-disabled','policy-blocked','pg'])('fails closed for %s', async (kind) => {
+    if(kind==='user-disabled') db.prepare('UPDATE user SET isActive=0 WHERE authId=?').run('owner')
+    if(kind==='user-deleted') db.prepare('UPDATE user SET deletedAt=CURRENT_TIMESTAMP WHERE authId=?').run('owner')
+    if(kind==='client-disabled') db.prepare('UPDATE app SET isActive=0 WHERE clientId=?').run('naccount-user-portal')
+    if(kind==='policy-blocked') env.BLOCKED_POLICIES=['update_info']
+    if(kind==='pg') env.PG_CONNECTION_STRING='unsupported'
+    expect((await patch({nickname:'x'})).status).not.toBe(200)
+  })
+  it('rejects oversized bodies before a write', async () => { expect((await patch({signature:'x'.repeat(3000)})).status).toBe(413) })
+  it('lists only own consent and explicitly public active SPA apps, without credentials or callbacks', async () => {
+    db.prepare('INSERT INTO app(name,type,clientId,secret,redirectUris) VALUES(?,?,?,?,?)').run('Owned','spa','owned','private-secret','https://private.example/callback')
+    db.prepare('INSERT INTO app(name,type,clientId) VALUES(?,?,?)').run('Public','spa','public')
+    db.prepare('INSERT INTO app(name,type,clientId) VALUES(?,?,?)').run('Internal','spa','internal')
+    db.prepare('INSERT INTO app(name,type,clientId) VALUES(?,?,?)').run('Service','s2s','service')
+    db.prepare('INSERT INTO user_app_consent(userId,appId,scopes) SELECT user.id, app.id, ? FROM user,app WHERE user.authId=? AND app.clientId=?').run('[]','owner','owned')
+    env.NACCOUNT_PUBLIC_APP_IDS=['public','service','naccount-user-portal','public']
+    const response=await get('/account/api/apps')
+    expect(await response.json()).toEqual({apps:[{clientId:'owned',name:'Owned',authorized:true},{clientId:'public',name:'Public',authorized:false}]})
+    expect(await (await get('/account/api/apps','other')).json()).toEqual({apps:[{clientId:'public',name:'Public',authorized:false}]})
+    db.prepare('UPDATE app SET isActive=0 WHERE clientId=?').run('owned')
+    expect(JSON.stringify(await (await get('/account/api/apps')).json())).not.toContain('Owned')
+  })
+})
