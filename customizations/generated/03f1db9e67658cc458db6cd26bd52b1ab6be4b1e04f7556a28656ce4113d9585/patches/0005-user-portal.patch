+++ b/server/src/pages/account/Applications.tsx
@@ -0,0 +1,38 @@
+import { useEffect, useRef, useState } from 'hono/jsx'
+import { request } from './auth'
+import Icon from './Icons'
+
+interface App { clientId: string; name: string; authorized: boolean }
+export default function Applications({ accessToken }: { accessToken: string }) {
+  const [apps, setApps] = useState<App[] | null>(null)
+  const [tab, setTab] = useState<'authorized' | 'all'>('authorized')
+  const [error, setError] = useState(false)
+  const [attempt, setAttempt] = useState(0)
+  const tabs = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    let stale = false
+    setApps(null); setError(false)
+    void request<{ apps: App[] }>('/account/api/apps', { headers: { Authorization: `Bearer ${accessToken}` } })
+      .then((value) => { if (!stale) setApps(value.apps) })
+      .catch(() => { if (!stale) setError(true) })
+    return () => { stale = true }
+  }, [accessToken, attempt])
+  const visible = apps?.filter((app) => tab === 'all' || app.authorized)
+  return <section class='application-card' aria-label='应用管理'>
+    <div class='tabs' role='tablist' aria-label='应用分类' ref={tabs} onKeyDown={(event) => {
+      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return
+      event.preventDefault()
+      const next = event.key === 'Home' ? 'authorized' : event.key === 'End' ? 'all' : tab === 'all' ? 'authorized' : 'all'
+      setTab(next); (tabs.current?.children[next === 'all' ? 1 : 0] as HTMLElement)?.focus()
+    }}>
+      {(['authorized', 'all'] as const).map((key) => <button key={key} id={`tab-${key}`} role='tab' aria-controls='app-panel'
+        aria-selected={tab === key ? 'true' : 'false'} tabIndex={tab === key ? 0 : -1} onClick={() => setTab(key)}>{key === 'all' ? '全部应用' : '已授权应用'}</button>)}
+    </div>
+    <div id='app-panel' role='tabpanel' aria-labelledby={`tab-${tab}`} tabIndex={0}>
+      {error ? <div class='empty' role='alert'><p>无法读取应用</p><button class='btn' onClick={() => setAttempt(attempt + 1)}>重试</button></div>
+        : !apps ? <div class='empty' role='status'>正在加载…</div>
+          : !visible?.length ? <div class='empty'><Icon name='apps' /><p>{tab === 'all' ? '暂无应用' : '暂无授权应用'}</p></div>
+            : <ul class='application-list'>{visible.map((app) => <li key={app.clientId}><Icon name='apps' /><span>{app.name}</span><span class='muted'>{app.authorized ? '已授权' : '未授权'}</span></li>)}</ul>}
+    </div>
+  </section>
+}
