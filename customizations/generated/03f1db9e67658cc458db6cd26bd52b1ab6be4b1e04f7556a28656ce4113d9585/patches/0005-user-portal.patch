+++ b/server/src/pages/account/Dialog.tsx
@@ -0,0 +1,26 @@
+import { useEffect, useRef } from 'hono/jsx'
+import { Child } from 'hono/jsx'
+
+export default function Dialog({ title, children, onClose, busy = false, danger = false }: {
+  title: string; children: Child; onClose: () => void; busy?: boolean; danger?: boolean;
+}) {
+  const ref = useRef<HTMLDialogElement>(null)
+  useEffect(() => {
+    const previous = document.activeElement as HTMLElement | null
+    const element = ref.current
+    const overflow = document.body.style.overflow
+    document.body.style.overflow = 'hidden'
+    element?.showModal()
+    return () => {
+      // Close the native modal before restoring focus; the background is otherwise still inert.
+      element?.close?.()
+      document.body.style.overflow = overflow
+      if (previous?.isConnected) previous.focus()
+    }
+  }, [])
+  return <dialog ref={ref} class={`portal-dialog${danger ? ' danger-dialog' : ''}`} aria-label={title}
+    onCancel={(event: Event) => { event.preventDefault(); if (!busy) onClose() }}>
+    <div class='dialoghead'><h2>{title}</h2><button type='button' class='close' aria-label='关闭弹窗' disabled={busy} onClick={onClose}>×</button></div>
+    {children}
+  </dialog>
+}
