@@ -0,0 +1,122 @@
+import { useEffect, useRef, useState } from 'hono/jsx'
+import { toCanvas } from 'qrcode'
+import Dialog from './Dialog'
+import * as auth from './auth'
+
+export type SecurityAction = 'email' | 'phone' | 'password' | 'otp-enable' | 'otp-disable' | 'delete'
+interface Capabilities extends Record<SecurityAction, boolean> { passwordRequired: boolean; otpRequired: boolean }
+interface Challenge {
+  id: string; token: string; required: string[]; expiresAt: number;
+  setup?: { secret: string; uri: string; recoveryCode?: string };
+}
+const titles: Record<SecurityAction, string> = {
+  email: '绑定邮箱', phone: '绑定手机号', password: '修改密码', 'otp-enable': '启用两步验证', 'otp-disable': '禁用两步验证', delete: '删除账户',
+}
+const messages: Record<string, string> = {
+  SECURITY_INVALID_CODE: '验证码错误或已使用，请重试。',
+  SECURITY_RATE_LIMITED: '操作过于频繁，请稍后重试。',
+  SECURITY_REQUEST_EXPIRED: '请求已失效，请关闭后重新操作。',
+  SECURITY_TARGET_UNAVAILABLE: '该邮箱或手机号不可用。',
+  SECURITY_LAST_ADMIN: '不能删除最后一个超级管理员。',
+  SECURITY_UNAVAILABLE: '当前配置不支持此操作。',
+  SECURITY_INVALID_INPUT: '请检查输入；新密码至少 8 位，包含大小写字母、数字和符号。',
+  SECURITY_DELIVERY_FAILED: '验证码未发送成功，请稍后重试。',
+}
+async function post<T>(path: string, token: string, body: unknown): Promise<T> {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), 20000)
+  try {
+    const response = await fetch('/account/api/security/' + path, {
+      method: 'POST', headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
+      body: JSON.stringify(body), cache: 'no-store', signal: controller.signal,
+    })
+    const result = await response.json() as { error?: string }
+    if (!response.ok) throw new Error(response.status === 401 ? '登录已过期，请重新登录。' : messages[result?.error ?? ''] ?? '验证失败或操作未完成，请重试。')
+    return result as T
+  } catch (error) {
+    if (error instanceof Error && Object.values(messages).includes(error.message)) throw error
+    if (error instanceof Error && ['登录已过期，请重新登录。', '验证失败或操作未完成，请重试。'].includes(error.message)) throw error
+    throw new Error('网络请求失败。若已提交，请重新登录核对状态后再试。')
+  } finally { clearTimeout(timer) }
+}
+export default function SecurityDialog({ action, accessToken, onClose, onCompleted }: {
+  action: SecurityAction; accessToken: string; onClose: () => void; onCompleted: (deleted: boolean) => void;
+}) {
+  const [caps, setCaps] = useState<Capabilities | null>(null)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+  const [values, setValues] = useState<Record<string, string>>({})
+  const [challenge, setChallenge] = useState<Challenge | null>(null)
+  const [step, setStep] = useState(0)
+  const [saved, setSaved] = useState(false)
+  const qr = useRef<HTMLCanvasElement>(null)
+  const active = useRef(true)
+  const submitting = useRef(false)
+  useEffect(() => {
+    active.current = true
+    auth.request<Capabilities>('/account/api/security', { headers: { Authorization: 'Bearer ' + accessToken } })
+      .then((value) => { if (active.current) setCaps(value) }).catch(() => { if (active.current) setError('无法读取安全设置，请关闭后重试。') })
+    return () => { active.current = false }
+  }, [accessToken])
+  useEffect(() => {
+    if (challenge?.setup && qr.current && step === 1) {
+      void toCanvas(qr.current, challenge.setup.uri, { width: 192, margin: 2 }).catch(() => setError('二维码加载失败，请手动输入密钥。'))
+    }
+  }, [challenge, step])
+  const field = (name: string, label: string, type = 'text', maxLength = 1024) => <label class='field'>{label}<input
+    name={name} type={type} required maxLength={maxLength} value={values[name] ?? ''} disabled={busy}
+    autoComplete={type === 'password' ? name === 'password' ? 'current-password' : 'new-password' : name.toLowerCase().includes('code') || name.toLowerCase().includes('otp') ? 'one-time-code' : 'off'}
+    inputMode={name.toLowerCase().includes('code') || name.toLowerCase().includes('otp') ? 'numeric' : undefined}
+    onInput={(event: Event) => { const value = (event.target as HTMLInputElement).value; setValues((previous) => ({ ...previous, [name]: value })) }} /></label>
+  const submit = async (event: Event) => {
+    event.preventDefault()
+    if (submitting.current || !caps?.[action]) return
+    const submitted = Object.fromEntries(new FormData(event.currentTarget as HTMLFormElement))
+    if (!challenge && action === 'password' && submitted.newPassword !== submitted.confirmPassword) { setError('两次输入的新密码不一致。'); return }
+    if (challenge?.setup && step === 1) { setStep(2); setError(''); return }
+    submitting.current = true
+    setBusy(true); setError('')
+    try {
+      if (!challenge) {
+        const next = await post<Challenge>('start', accessToken, { action, ...submitted })
+        if (!active.current) return
+        setValues({}); setChallenge(next); setStep(1)
+      } else {
+        const result = await post<{ deleted: boolean }>('complete', accessToken, {
+          id: challenge.id, token: challenge.token, ...submitted, savedRecoveryCode: submitted.savedRecoveryCode === 'on',
+        })
+        auth.clearSession()
+        if (active.current) onCompleted(result.deleted)
+      }
+    } catch (cause) { if (active.current) setError(cause instanceof Error ? cause.message : '操作未完成。') }
+    finally { submitting.current = false; if (active.current) setBusy(false) }
+  }
+  return <Dialog title={titles[action]} onClose={onClose} busy={busy} danger={action === 'delete'}>
+    {error && <p role='alert' class='error-inline'>{error}</p>}
+    {!caps ? !error && <p role='status'>正在读取…</p> : !caps[action] ? <p role='status'>当前配置不支持此操作。</p> : <form onSubmit={submit}>
+      {action === 'delete' && <p class='danger-warning'>注销后无法恢复。个人资料、登录凭据和应用授权将被清除，必要的安全记录及身份占用记录保留。</p>}
+      {!challenge ? <>
+        {caps.passwordRequired && field('password', '当前密码', 'password')}
+        {caps.otpRequired && field('otp', '验证器验证码', 'text', 6)}
+        {action === 'email' && field('target', '新邮箱', 'email', 254)}
+        {action === 'phone' && field('target', '新手机号（含国家区号，如 +86）', 'tel', 16)}
+        {action === 'password' && <>{field('newPassword', '新密码', 'password')}{field('confirmPassword', '确认新密码', 'password')}</>}
+        {action === 'delete' && field('confirmation', '输入“删除账户”确认', 'text', 10)}
+      </> : <>
+        {challenge.setup && step === 1 ? <div class='otp-setup'><canvas ref={qr} aria-label='验证器二维码' />
+          <code class='secret-value'>{challenge.setup.secret}</code></div> : <>
+          {challenge.required.map((name) => field(name, name === 'targetCode' ? action === 'phone' ? '新手机号验证码' : '新邮箱验证码' : name === 'currentEmailCode' ? '当前邮箱验证码' : '当前 MFA 手机验证码', 'text', 6))}
+          {challenge.setup && <>
+            {challenge.setup.recoveryCode && <><p class='muted'>恢复码</p><code class='secret-value'>{challenge.setup.recoveryCode}</code>
+            <label class='recovery-check'><input name='savedRecoveryCode' type='checkbox' checked={saved} required disabled={busy} onChange={(event: Event) => setSaved((event.target as HTMLInputElement).checked)} />我已安全保存恢复码</label></>}
+            {field('newOtp', '验证器验证码', 'text', 6)}
+          </>}
+          {!challenge.required.length && !challenge.setup && <p>{action === 'delete' ? '确认注销此账户？' : '确认提交此更改？'}</p>}
+        </>}
+      </>}
+      <div class='form-actions'><button class='btn' type='button' disabled={busy} onClick={onClose}>取消</button>
+        <button class={'btn ' + (action === 'delete' ? 'danger-solid' : 'primary')} type='submit' disabled={busy}>{busy ? '正在处理…' : !challenge ? '验证身份' : challenge.setup && step === 1 ? '下一步' : '确认'}</button>
+      </div>
+    </form>}
+  </Dialog>
+}
