diff --git a/server/src/pages/account/InlineEdit.tsx b/server/src/pages/account/InlineEdit.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..73abb17032cdeab4d8864fd0f326d19ca30e5647
--- /dev/null
+++ b/server/src/pages/account/InlineEdit.tsx
@@ -0,0 +1,37 @@
+import { useEffect, useRef, useState } from 'hono/jsx'
+import Icon from './Icons'
+
+export default function InlineEdit({ label, value, placeholder, maxLength, required = false, disabled = false, onSave }: {
+  label: string; value: string; placeholder: string; maxLength: number; required?: boolean; disabled?: boolean;
+  onSave: (value: string) => Promise<void>;
+}) {
+  const [editing, setEditing] = useState(false)
+  const [draft, setDraft] = useState(value)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+  const input = useRef<HTMLInputElement>(null)
+  const trigger = useRef<HTMLButtonElement>(null)
+  const mounted = useRef(false)
+  useEffect(() => {
+    if (!mounted.current) { mounted.current = true; return }
+    if (editing) input.current?.focus(); else trigger.current?.focus()
+  }, [editing])
+  const close = () => { if (!busy) { setEditing(false); setError('') } }
+  return <div class='inline-edit-wrap'>
+    {editing ? <form class='inline-editor' onSubmit={async (event) => {
+      event.preventDefault()
+      if (busy) return
+      const next = (input.current?.value ?? draft).trim()
+      if ((required && !next) || next.length > maxLength || /[\u0000-\u001f\u007f]/.test(next)) { setError('请检查输入内容'); return }
+      setBusy(true); setError('')
+      try { await onSave(next); setEditing(false) } catch { setError('保存失败，请重试') } finally { setBusy(false) }
+    }} onKeyDown={(event) => { if (event.key === 'Escape') { event.preventDefault(); close() } }}>
+      <input ref={input} class='inline-input' aria-label={label} value={draft} maxLength={maxLength} required={required} disabled={busy}
+        onInput={(event) => setDraft((event.target as HTMLInputElement).value)} />
+      <button class='edit-icon primary' aria-label={`保存${label}`} disabled={busy}><Icon name='check' /></button>
+      <button type='button' class='edit-icon' aria-label={`取消编辑${label}`} disabled={busy} onClick={close}>×</button>
+    </form> : <div class='inline-editor'><span class={label === '昵称' ? 'nickname' : 'signature-text'}>{value || placeholder}</span>
+      <button ref={trigger} class='edit-icon' aria-label={`编辑${label}`} disabled={disabled} onClick={() => { setDraft(value); setEditing(true) }}><Icon name='edit' /></button></div>}
+    {error && <p role='alert' class='error-inline'>{error}</p>}
+  </div>
+}
