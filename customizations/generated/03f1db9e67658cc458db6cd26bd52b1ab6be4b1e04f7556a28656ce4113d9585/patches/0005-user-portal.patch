+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { Database } from 'better-sqlite3'
+import { migrate, mock } from 'tests/mock'
+import { typeConfig } from 'configs'
+import { jwtService, emailService, smsService } from 'services'
+import { cryptoUtil } from 'utils'
+import account from 'routes/account'
+
+let db: Database
+let env: typeConfig.Bindings
+const password = 'Local-Fixture-729!'
+const hash = cryptoUtil.bcryptText(password)
+beforeEach(async () => {
+  db = await migrate()
+  db.prepare('INSERT INTO user(authId,email,password,emailVerified,otpSecret) VALUES(?,?,?,?,?)').run('owner','owner@example.test',hash,1,'')
+  db.prepare('UPDATE app SET redirectUris=? WHERE clientId=?').run('https://auth.example.test/account','naccount-user-portal')
+  env = { ...process.env, ...mock(db), AUTH_SERVER_URL:'https://auth.example.test', NACCOUNT_PORTAL_CLIENT_ID:'naccount-user-portal', PG_CONNECTION_STRING:'',
+    ENABLE_PASSWORD_RESET:true, ENABLE_PASSWORDLESS_SIGN_IN:false, ENABLE_RECOVERY_CODE:true, OTP_MFA_IS_REQUIRED:false, ENFORCE_ONE_MFA_ENROLLMENT:[],
+    EMAIL_PROVIDER_NAME:'resend',RESEND_API_KEY:'fixture',RESEND_SENDER_ADDRESS:'sender@example.test',
+    TWILIO_ACCOUNT_ID:'fixture',TWILIO_AUTH_TOKEN:'fixture',TWILIO_SENDER_NUMBER:'+12025550100',
+  } as unknown as typeConfig.Bindings
+  vi.spyOn(jwtService,'getAccessTokenBody').mockImplementation(async (_c, token) => ({
+    sub:'owner',azp:'naccount-user-portal',scope:'openid profile',securityVersion:token==='v1'?1:0,
+    ...(token==='impersonated'?{impersonatedBy:'admin'}:{}),
+  } as typeConfig.AccessTokenBody))
+  vi.spyOn(emailService,'sendChangeEmailVerificationCode').mockResolvedValue('654321')
+  vi.spyOn(smsService,'sendSmsMfa').mockResolvedValue('123456')
+})
+afterEach(() => { db.close(); vi.restoreAllMocks() })
+const post = (path: string, body: unknown, token='v0') => account.request('/account/api/security/'+path,{
+  method:'POST',headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'},body:JSON.stringify(body),
+},env)
+const begin = async (body: object) => {
+  const response=await post('start',{password,...body})
+  expect(response.status,JSON.stringify(await response.clone().json())).toBe(200)
+  return await response.json() as any
+}
+const row = () => db.prepare("SELECT * FROM user WHERE authId='owner'").get() as any
+const finish = (challenge: any, values: object={}) => post('complete',{id:challenge.id,token:challenge.token,...values})
+
+describe('self-service account security',()=>{
+  it('changes email only after the target code, revokes sessions and erases challenge secrets',async()=>{
+    const c=await begin({action:'email',target:' NEW@example.test '})
+    expect(row().email).toBe('owner@example.test')
+    expect((await finish(c,{targetCode:'000000'})).status).toBe(400)
+    expect(row().email).toBe('owner@example.test')
+    expect((await finish(c,{targetCode:'654321'})).status).toBe(200)
+    expect(row()).toMatchObject({email:'new@example.test',emailVerified:1,securityVersion:1})
+    expect((await finish(c,{targetCode:'654321'})).status).not.toBe(200)
+    const stored=db.prepare('SELECT guard,payload,proofs,tokenHash FROM naccount_security_request').get()
+    expect(stored).toEqual({guard:'{}',payload:'{}',proofs:'{}',tokenHash:''})
+    expect((await account.request('/account/api/profile',{headers:{Authorization:'Bearer v0'}},env)).status).not.toBe(200)
+    expect((await account.request('/account/api/profile',{headers:{Authorization:'Bearer v1'}},env)).status).toBe(200)
+  })
+  it('keeps contact phone independent from SMS MFA and verifies before updating',async()=>{
+    db.prepare("UPDATE user SET smsPhoneNumber='+12025550111',smsPhoneNumberVerified=1").run()
+    const c=await begin({action:'phone',target:'+12025550122'})
+    expect(db.prepare('SELECT * FROM naccount_profile').get()).toBeUndefined()
+    expect((await finish(c,{targetCode:'123456'})).status).toBe(200)
+    expect(db.prepare('SELECT phone FROM naccount_profile').get()).toEqual({phone:'+12025550122'})
+    expect(row().smsPhoneNumber).toBe('+12025550111')
+  })
+  it('requires current password and rejects impersonation',async()=>{
+    expect((await post('start',{action:'password',password:'wrong',newPassword:'Replacement-739!'})).status).not.toBe(200)
+    expect((await post('start',{action:'delete',password,confirmation:'删除账户'},'impersonated')).status).not.toBe(200)
+    expect(row().securityVersion).toBe(0)
+  })
+  it('changes a strong password only on final confirmation',async()=>{
+    const c=await begin({action:'password',newPassword:'Replacement-739!'})
+    expect(row().password).toBe(hash)
+    expect((await finish(c)).status).toBe(200)
+    expect(cryptoUtil.bcryptCompare('Replacement-739!',row().password)).toBe(true)
+  })
+  it('enrolls OTP only after a valid new code and recovery acknowledgement',async()=>{
+    const c=await begin({action:'otp-enable'})
+    expect(row().otpVerified).toBe(0)
+    const code=await cryptoUtil.genTotp(c.setup.secret)
+    expect((await finish(c,{newOtp:code})).status).toBe(400)
+    expect((await finish(c,{newOtp:code,savedRecoveryCode:true})).status).toBe(200)
+    expect(row()).toMatchObject({otpVerified:1,otpSecret:c.setup.secret,mfaTypes:'otp'})
+    expect(cryptoUtil.bcryptCompare(c.setup.recoveryCode,row().recoveryCodeHash)).toBe(true)
+  })
+  it('requires existing OTP to disable it, then clears only OTP factors',async()=>{
+    const secret=cryptoUtil.genOtpSecret()
+    db.prepare("UPDATE user SET otpSecret=?,otpVerified=1,mfaTypes='otp'").run(secret)
+    const c=await begin({action:'otp-disable',otp:await cryptoUtil.genTotp(secret)})
+    expect((await finish(c)).status).toBe(200)
+    expect(row()).toMatchObject({otpVerified:0,otpSecret:'',mfaTypes:'',recoveryCodeHash:null})
+  })
+  it('does not bypass mandatory OTP',async()=>{
+    env.OTP_MFA_IS_REQUIRED=true
+    db.prepare("UPDATE user SET mfaTypes='otp',otpVerified=1").run()
+    expect((await post('start',{action:'otp-disable',password})).status).toBe(409)
+  })
+  it('requires system-enforced OTP even without a voluntary enrollment row',async()=>{
+    env.OTP_MFA_IS_REQUIRED=true
+    db.prepare("UPDATE user SET otpSecret=?,otpVerified=1,mfaTypes=''").run(cryptoUtil.genOtpSecret())
+    expect((await post('start',{action:'password',password,newPassword:'Replacement-739!'})).status).toBe(400)
+    expect((await post('start',{action:'otp-enable',password})).status).toBe(409)
+    expect(row().securityVersion).toBe(0)
+  })
+  it('requires configured email MFA even without voluntary enrollment',async()=>{
+    env.EMAIL_MFA_IS_REQUIRED=true
+    const c=await begin({action:'password',newPassword:'Replacement-739!'})
+    expect(c.required).toContain('currentEmailCode')
+    expect((await finish(c)).status).toBe(400)
+  })
+  it('rejects authentication policy changes during a pending request',async()=>{
+    const c=await begin({action:'email',target:'new@example.test'})
+    env.EMAIL_MFA_IS_REQUIRED=true
+    expect((await finish(c,{targetCode:'654321'})).status).toBe(409)
+  })
+  it('rejects changes to the current SMS proof destination',async()=>{
+    db.prepare("UPDATE user SET smsPhoneNumber='+12025550111',smsPhoneNumberVerified=1,mfaTypes='sms'").run()
+    const c=await begin({action:'password',newPassword:'Replacement-739!'})
+    db.prepare("UPDATE user SET smsPhoneNumber='+12025550112'").run()
+    expect((await finish(c,{currentSmsCode:'123456'})).status).toBe(409)
+    expect(row().securityVersion).toBe(0)
+  })
+  it('uses verified current email proof when no local password exists',async()=>{
+    db.prepare('UPDATE user SET password=NULL').run()
+    const c=await begin({action:'phone',target:'+12025550122'})
+    expect(c.required).toEqual(['currentEmailCode','targetCode'])
+    expect((await finish(c,{targetCode:'123456'})).status).toBe(400)
+    expect((await finish(c,{targetCode:'123456',currentEmailCode:'654321'})).status).toBe(200)
+  })
+  it('does not advertise native password login for an unconverted primary social account',async()=>{
+    db.prepare("UPDATE user SET password=NULL,socialAccountId='primary-subject',socialAccountType='Google'").run()
+    const response=await account.request('/account/api/security',{headers:{Authorization:'Bearer v0'}},env)
+    expect(await response.json()).toMatchObject({password:false,email:true,phone:true})
+  })
+  it('does not issue a recovery code when recovery login is disabled',async()=>{
+    env.ENABLE_RECOVERY_CODE=false
+    const c=await begin({action:'otp-enable'})
+    expect(c.setup.recoveryCode).toBeUndefined()
+    expect((await finish(c,{newOtp:await cryptoUtil.genTotp(c.setup.secret)})).status).toBe(200)
+  })
+  it('keeps all state unchanged when delivery fails',async()=>{
+    vi.mocked(emailService.sendChangeEmailVerificationCode).mockResolvedValue(null)
+    expect((await post('start',{action:'email',password,target:'new@example.test'})).status).toBe(503)
+    expect(row().email).toBe('owner@example.test')
+    expect(db.prepare('SELECT * FROM naccount_security_request').get()).toBeUndefined()
+  })
+  it('locks a challenge after five wrong attempts',async()=>{
+    const c=await begin({action:'email',target:'new@example.test'})
+    for(let i=0;i<5;i++) expect((await finish(c,{targetCode:'000000'})).status).toBe(400)
+    expect((await finish(c,{targetCode:'654321'})).status).toBe(409)
+    expect(row().securityVersion).toBe(0)
+  })
+  it.each(['expiry','password','email','version'])('rejects a changed identity or expired request: %s',async(kind)=>{
+    const c=await begin({action:'email',target:'new@example.test'})
+    if(kind==='expiry')db.prepare('UPDATE naccount_security_request SET expiresAt=0').run()
+    if(kind==='password')db.prepare("UPDATE user SET password='changed'").run()
+    if(kind==='email')db.prepare("UPDATE user SET email='changed@example.test'").run()
+    if(kind==='version')db.prepare('UPDATE user SET securityVersion=1').run()
+    expect((await finish(c,{targetCode:'654321'})).status).not.toBe(200)
+    expect(row().email).not.toBe('new@example.test')
+  })
+  it('checks email collision again at commit',async()=>{
+    const c=await begin({action:'email',target:'new@example.test'})
+    db.prepare('INSERT INTO user(authId,email,otpSecret) VALUES(?,?,?)').run('other','NEW@example.test','')
+    expect((await finish(c,{targetCode:'654321'})).status).toBe(409)
+    expect(row().email).toBe('owner@example.test')
+  })
+  it('allows only one winner for concurrent completion',async()=>{
+    const c=await begin({action:'email',target:'new@example.test'})
+    const results=await Promise.all([finish(c,{targetCode:'654321'}),finish(c,{targetCode:'654321'})])
+    expect(results.filter(r=>r.status===200)).toHaveLength(1)
+    expect(row().securityVersion).toBe(1)
+  })
+  it('deletes own personal data but retains a disabled identity tombstone',async()=>{
+    db.prepare("INSERT INTO naccount_profile(userId,nickname) SELECT id,'Fixture' FROM user WHERE authId='owner'").run()
+    db.prepare("INSERT INTO naccount_social_identity(provider,subject,userId,label) SELECT 'Google','subject',id,'label@example.test' FROM user WHERE authId='owner'").run()
+    const c=await begin({action:'delete',confirmation:'删除账户'})
+    expect((await finish(c)).status).toBe(200)
+    expect(row()).toMatchObject({isActive:0,email:null,password:null,securityVersion:1})
+    expect(row().deletedAt).toBeTruthy()
+    expect(db.prepare('SELECT * FROM naccount_profile').get()).toBeUndefined()
+    expect(db.prepare('SELECT label FROM naccount_social_identity').get()).toEqual({label:''})
+  })
+  it('does not delete the final super administrator',async()=>{
+    db.prepare("INSERT INTO user_role(userId,roleId) SELECT u.id,r.id FROM user u,role r WHERE u.authId='owner' AND r.name='super_admin'").run()
+    const c=await begin({action:'delete',confirmation:'删除账户'})
+    expect((await finish(c)).status).toBe(409)
+    expect(row().isActive).toBe(1)
+  })
+  it('enforces send cooldown and advertises unconfigured providers honestly',async()=>{
+    await begin({action:'email',target:'new@example.test'})
+    expect((await post('start',{action:'email',password,target:'another@example.test'})).status).toBe(429)
+    env.RESEND_API_KEY=''
+    const res=await account.request('/account/api/security',{headers:{Authorization:'Bearer v0'}},env)
+    expect(await res.json()).toMatchObject({email:false,phone:true})
+  })
+})
