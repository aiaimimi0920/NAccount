--- /dev/null
+++ b/server/src/services/accountEpoch.ts
@@ -0,0 +1,12 @@
+import { Context } from 'hono'
+import { HTTPException } from 'hono/http-exception'
+import { typeConfig } from 'configs'
+import { userModel } from 'models'
+
+export async function freshUser(c: Context<typeConfig.Context>, snapshot: Pick<userModel.Record, 'authId' | 'securityVersion'>) {
+  const current = await userModel.getByAuthId(c.env.DB, snapshot.authId)
+  if (!current || !current.isActive || current.deletedAt || (current.securityVersion ?? 0) !== (snapshot.securityVersion ?? 0)) {
+    throw new HTTPException(401, { message: 'ACCOUNT_SESSION_REVOKED' })
+  }
+  return current
+}
diff --git a/server/src/services/accountProfile.ts b/server/src/services/accountProfile.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3c482a5ed8abc35fbabecf2a0beba26f01f0a38b
--- /dev/null
+++ b/server/src/services/accountProfile.ts
@@ -0,0 +1,62 @@
+import { Context } from 'hono'
+import { HTTPException } from 'hono/http-exception'
+import { ClientType } from '@melody-auth/shared'
+import { errorConfig, typeConfig } from 'configs'
+import { appModel, userAppConsentModel } from 'models'
+import { actor } from './accountSocial'
+
+interface Card { nickname: string; signature: string; phone: string | null }
+const denied = () => new errorConfig.Forbidden('NACCOUNT_PROFILE_REQUEST_DENIED')
+
+export const profile = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  const card = await c.env.DB.prepare('SELECT nickname, signature, phone FROM naccount_profile WHERE userId=$1').bind(user.id).first<Card>()
+  // Keep the portal DTO explicit: never serialize the user model (password, OTP secret, recovery hash).
+  return c.json({
+    authId: user.authId, email: user.email, emailVerified: user.emailVerified,
+    nickname: card?.nickname || [user.firstName, user.lastName].filter(Boolean).join(' '),
+    signature: card?.signature ?? '',
+    phone: card?.phone ?? null,
+    otpEnabled: user.otpVerified,
+    canUsePolicies: !!(user.email && !user.socialAccountId),
+    canEdit: !(c.env.BLOCKED_POLICIES ?? []).includes('update_info'),
+  })
+}
+
+export const update = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  if ((c.env.BLOCKED_POLICIES ?? []).includes('update_info')) throw new HTTPException(403)
+  const body = await c.req.json()
+  if (!body || typeof body !== 'object' || Array.isArray(body) || Object.keys(body).length !== 1) throw denied()
+  const key = Object.keys(body)[0]
+  if (key !== 'nickname' && key !== 'signature') throw denied()
+  const value = body[key]
+  if (typeof value !== 'string' || value !== value.trim() || /[\u0000-\u001f\u007f]/.test(value) ||
+    value.length > (key === 'nickname' ? 40 : 120) || (key === 'nickname' && !value)) throw denied()
+  // Only an allowlisted identifier is interpolated. Identity always comes from the validated token.
+  const result = await c.env.DB.prepare(`INSERT INTO naccount_profile (userId, ${key})
+    SELECT id, $1 FROM "user" WHERE id=$2 AND isActive=1 AND deletedAt IS NULL
+    ON CONFLICT(userId) DO UPDATE SET ${key}=excluded.${key}`)
+    .bind(value, user.id).run()
+  if (!result.success || !result.meta.changes) throw denied()
+  return profile(c)
+}
+
+export const apps = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  const consents = await userAppConsentModel.getAllByUser(c.env.DB, user.id)
+  const entries = new Map<string, { clientId: string; name: string; authorized: boolean }>()
+  const add = (app: appModel.Record | null, authorized: boolean) => {
+    if (!app || !app.isActive || app.deletedAt || app.type !== ClientType.SPA || app.clientId === c.env.NACCOUNT_PORTAL_CLIENT_ID) return
+    entries.set(app.clientId, { clientId: app.clientId, name: app.name, authorized: authorized || entries.get(app.clientId)?.authorized || false })
+  }
+  for (const consent of consents) add(await appModel.getById(c.env.DB, consent.appId), true)
+  // Own consent is private to this user. Additional discovery is opt-in, never a global app dump.
+  const catalogue = c.env.NACCOUNT_PUBLIC_APP_IDS
+  if (Array.isArray(catalogue)) {
+    for (const clientId of catalogue.slice(0, 100)) {
+      if (typeof clientId === 'string') add(await appModel.getByClientId(c.env.DB, clientId), false)
+    }
+  }
+  return c.json({ apps: [...entries.values()] })
+}
diff --git a/server/src/services/accountSecurity.ts b/server/src/services/accountSecurity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..27fb831b5c83d3c277cff364462c85155dfdc42b
--- /dev/null
+++ b/server/src/services/accountSecurity.ts
@@ -0,0 +1,186 @@
+import { Context } from 'hono'
+import { HTTPException } from 'hono/http-exception'
+import { isEmail, isStrongPassword } from 'class-validator'
+import { typeConfig } from 'configs'
+import { appModel, userModel } from 'models'
+import { emailService, smsService, userService, mfaService } from 'services'
+import { cryptoUtil } from 'utils'
+import { actor, digest } from './accountSocial'
+
+type C = Context<typeConfig.Context>
+type Action = 'email' | 'phone' | 'password' | 'otp-enable' | 'otp-disable' | 'delete'
+const actions: Action[] = ['email', 'phone', 'password', 'otp-enable', 'otp-disable', 'delete']
+const fail = (message = 'SECURITY_REQUEST_DENIED', status: 400 | 403 | 409 | 429 | 503 = 403): never => { throw new HTTPException(status, { message }) }
+const text = (value: unknown, max = 1024) => typeof value === 'string' && value.length <= max ? value : ''
+const otpCode = (value: unknown) => typeof value === 'string' && /^\d{6}$/.test(value) ? value : ''
+export function emailReady(c: C) {
+  const e = c.env
+  const providers: Record<string, boolean> = {
+    cloudflare: !!(e.CLOUDFLARE_EMAIL && e.CLOUDFLARE_SENDER_ADDRESS), smtp: !!e.SMTP,
+    sendgrid: !!(e.SENDGRID_API_KEY && e.SENDGRID_SENDER_ADDRESS),
+    mailgun: !!(e.MAILGUN_API_KEY && e.MAILGUN_SENDER_ADDRESS),
+    brevo: !!(e.BREVO_API_KEY && e.BREVO_SENDER_ADDRESS),
+    resend: !!(e.RESEND_API_KEY && e.RESEND_SENDER_ADDRESS),
+    postmark: !!(e.POSTMARK_API_KEY && e.POSTMARK_SENDER_ADDRESS),
+  }
+  return e.EMAIL_PROVIDER_NAME ? !!providers[e.EMAIL_PROVIDER_NAME] : Object.values(providers).some(Boolean)
+}
+const smsReady = (c: C) => !!(c.env.TWILIO_ACCOUNT_ID && c.env.TWILIO_AUTH_TOKEN && c.env.TWILIO_SENDER_NUMBER)
+async function capabilities(c: C, user: userModel.Record) {
+  const app = await appModel.getByClientId(c.env.DB, c.env.NACCOUNT_PORTAL_CLIENT_ID!)
+  const mfa = app && mfaService.getAppMfaConfig(app)
+  const forcedOtp = mfa?.requireOtpMfa ?? c.env.OTP_MFA_IS_REQUIRED
+  const emailRequired = !!((mfa?.requireEmailMfa ?? c.env.EMAIL_MFA_IS_REQUIRED) || user.mfaTypes.includes('email'))
+  const smsRequired = !!((mfa?.requireSmsMfa ?? c.env.SMS_MFA_IS_REQUIRED) || user.mfaTypes.includes('sms'))
+  const otpEnabled = !!user.otpVerified
+  const remaining = user.mfaTypes.filter((value) => value !== 'otp')
+  const enforced = mfa?.enforceOneMfaEnrollment ?? c.env.ENFORCE_ONE_MFA_ENROLLMENT ?? []
+  const forcedOne = enforced.length > 0 && !remaining.some((value) => enforced.includes(value as userModel.MfaType))
+  const blocked = c.env.BLOCKED_POLICIES ?? []
+  const canProve = !!user.password || !!(user.email && user.emailVerified && emailReady(c))
+  return {
+    passwordRequired: !!user.password, otpRequired: !!(forcedOtp || otpEnabled || user.mfaTypes.includes('otp')), emailRequired, smsRequired, recoveryEnabled: !!c.env.ENABLE_RECOVERY_CODE,
+    email: canProve && emailReady(c) && !blocked.includes('change_email'),
+    phone: canProve && smsReady(c),
+    password: canProve && !user.socialAccountId && !!c.env.ENABLE_PASSWORD_RESET && !c.env.ENABLE_PASSWORDLESS_SIGN_IN && !blocked.includes('change_password'),
+    'otp-enable': canProve && !otpEnabled && !user.mfaTypes.includes('otp') && !blocked.includes('reset_mfa'),
+    'otp-disable': canProve && otpEnabled && !forcedOtp && !forcedOne && !blocked.includes('reset_mfa'),
+    delete: canProve,
+  }
+}
+export const status = async (c: C) => c.json(await capabilities(c, await actor(c)))
+
+// Fixed-window counters are incremented atomically in D1; no KV read/modify/write race.
+async function limit(c: C, bucket: string, maximum: number, duration: number) {
+  const now = Date.now()
+  const row = await c.env.DB.prepare(
+    'INSERT INTO naccount_security_limit(bucket,count,expiresAt) VALUES(?,1,?) ON CONFLICT(bucket) DO UPDATE SET count=CASE WHEN expiresAt<=? THEN 1 ELSE count+1 END, expiresAt=CASE WHEN expiresAt<=? THEN ? ELSE expiresAt END RETURNING count',
+  ).bind(bucket, now + duration, now, now, now + duration).first<{ count: number }>()
+  if (!row || row.count > maximum) fail('SECURITY_RATE_LIMITED', 429)
+}
+async function consumeOtp(c: C, userId: number, secret: string, code: unknown) {
+  const clean = otpCode(code)
+  const step = clean ? await cryptoUtil.verifyTotp(secret, clean) : null
+  if (step === null) fail('SECURITY_INVALID_CODE', 400)
+  const result = await c.env.DB.prepare('INSERT OR IGNORE INTO naccount_otp_use(userId,secretHash,step) VALUES(?,?,?)')
+    .bind(userId, await digest(secret), step).run()
+  if (!result.meta.changes) fail('SECURITY_INVALID_CODE', 400)
+}
+interface Stored {
+  id: string; userId: number; version: number; action: Action; target: string;
+  guard: string; payload: string; proofs: string; tokenHash: string; expiresAt: number; attempts: number; ready: number; used: number;
+}
+export async function start(c: C) {
+  const user = await actor(c)
+  const body = await c.req.json()
+  const action = body?.action as Action
+  if (!actions.includes(action)) fail()
+  const caps = await capabilities(c, user)
+  if (!caps[action]) fail('SECURITY_UNAVAILABLE', 409)
+  await limit(c, 'start:' + user.id, 6, 3600000)
+  await limit(c, 'ip:' + await digest(c.req.header('CF-Connecting-IP') ?? 'local'), 30, 3600000)
+  await limit(c, 'cooldown:' + user.id, 1, 30000)
+  if (user.password) {
+    const password = text(body.password)
+    if (!password || !user.email) fail()
+    const verified = await userService.verifySignIn(c, user.email!, (record) => record.id === user.id && !!record.password && cryptoUtil.bcryptCompare(password, record.password))
+    if (verified.id !== user.id) fail()
+  }
+  if (caps.otpRequired) await consumeOtp(c, user.id, user.otpSecret, body.otp)
+  let target = ''
+  const payload: Record<string, string> = {}
+  if (action === 'email') {
+    target = text(body.target, 254).trim().toLowerCase()
+    if (!isEmail(target) || target === user.email?.trim().toLowerCase()) fail('SECURITY_INVALID_INPUT', 400)
+    if (await c.env.DB.prepare('SELECT id FROM user WHERE lower(trim(email))=? AND deletedAt IS NULL AND id<>?').bind(target, user.id).first()) fail('SECURITY_TARGET_UNAVAILABLE', 409)
+  }
+  if (action === 'phone') {
+    target = text(body.target, 16).trim()
+    if (!/^\+[1-9]\d{1,14}$/.test(target)) fail('SECURITY_INVALID_INPUT', 400)
+    if (await c.env.DB.prepare('SELECT userId FROM naccount_profile WHERE phone=?').bind(target).first()) fail('SECURITY_TARGET_UNAVAILABLE', 409)
+  }
+  if (action === 'password') {
+    const password = text(body.newPassword)
+    if (!password || !isStrongPassword(password) || (user.password && cryptoUtil.bcryptCompare(password, user.password))) fail('SECURITY_INVALID_INPUT', 400)
+    payload.password = cryptoUtil.bcryptText(password)
+  }
+  if (action === 'delete' && body.confirmation !== '删除账户') fail('SECURITY_INVALID_INPUT', 400)
+  let setup: { secret: string; uri: string; recoveryCode?: string } | undefined
+  if (action === 'otp-enable') {
+    const secret = cryptoUtil.genOtpSecret()
+    const recovery = c.env.ENABLE_RECOVERY_CODE ? await cryptoUtil.genRecoveryCode() : null
+    payload.secret = secret
+    payload.recoveryHash = recovery?.recoveryHash ?? ''
+    payload.mfaTypes = [...new Set([...user.mfaTypes, 'otp'])].join(',')
+    setup = { secret, uri: 'otpauth://totp/' + encodeURIComponent('NAccount:' + (user.email || user.authId)) + '?secret=' + secret + '&issuer=NAccount&algorithm=SHA1&digits=6&period=30', ...(recovery ? { recoveryCode: recovery.recoveryCode } : {}) }
+  }
+  if (action === 'otp-disable') payload.mfaTypes = user.mfaTypes.filter((value) => value !== 'otp').join(',')
+  const id = crypto.randomUUID()
+  const token = crypto.randomUUID() + crypto.randomUUID()
+  const guard = JSON.stringify({ password: user.password ?? '', email: user.email ?? '', otpSecret: user.otpSecret, mfaTypes: user.mfaTypes.join(','), recoveryCodeHash: user.recoveryCodeHash ?? '',
+    emailVerified: Number(user.emailVerified), otpVerified: Number(user.otpVerified), smsPhoneNumber: user.smsPhoneNumber ?? '', smsPhoneNumberVerified: Number(user.smsPhoneNumberVerified), capabilities: caps })
+  const now = Date.now()
+  await c.env.DB.prepare('DELETE FROM naccount_security_request WHERE expiresAt<=?').bind(now).run()
+  await c.env.DB.prepare('DELETE FROM naccount_security_limit WHERE expiresAt<=?').bind(now).run()
+  await c.env.DB.prepare('DELETE FROM naccount_otp_use WHERE step<?').bind(Math.floor(now / 30000) - 3).run()
+  await c.env.DB.prepare('INSERT INTO naccount_security_request(id,userId,version,action,target,guard,payload,tokenHash,createdAt,expiresAt) VALUES(?,?,?,?,?,?,?,?,?,?)')
+    .bind(id, user.id, user.securityVersion ?? 0, action, target, guard, JSON.stringify(payload), await digest(token), now, now + 600000).run()
+  const proofs: Record<string, string> = {}
+  const required: string[] = []
+  const send = async (name: string, address: string, phone: boolean) => {
+    await limit(c, 'target:' + await digest(address), 6, 3600000)
+    const code = phone ? await smsService.sendSmsMfa(c, address, user.locale) : await emailService.sendChangeEmailVerificationCode(c, address, user.locale, user.orgSlug)
+    if (!code) fail('SECURITY_DELIVERY_FAILED', 503)
+    proofs[name] = await digest(id + ':' + name + ':' + code)
+    required.push(name)
+  }
+  try {
+    if (!user.password || caps.emailRequired) {
+      if (!user.email || !user.emailVerified || !emailReady(c)) fail('SECURITY_UNAVAILABLE', 409)
+      await send('currentEmailCode', user.email!, false)
+    }
+    if (caps.smsRequired) {
+      if (!user.smsPhoneNumber || !user.smsPhoneNumberVerified || !smsReady(c)) fail('SECURITY_UNAVAILABLE', 409)
+      await send('currentSmsCode', user.smsPhoneNumber!, true)
+    }
+    if (action === 'email' || action === 'phone') await send('targetCode', target, action === 'phone')
+    await c.env.DB.prepare('UPDATE naccount_security_request SET proofs=?,ready=1 WHERE id=?').bind(JSON.stringify(proofs), id).run()
+  } catch (error) {
+    await c.env.DB.prepare('DELETE FROM naccount_security_request WHERE id=?').bind(id).run()
+    if (error instanceof HTTPException) throw error
+    fail('SECURITY_DELIVERY_FAILED', 503)
+  }
+  return c.json({ id, token, action, required, setup, expiresAt: now + 600000 })
+}
+export async function complete(c: C) {
+  const user = await actor(c)
+  const body = await c.req.json()
+  const id = text(body?.id, 64)
+  const tokenHash = await digest(text(body?.token, 150))
+  const request = await c.env.DB.prepare('UPDATE naccount_security_request SET attempts=attempts+1 WHERE id=? AND userId=? AND tokenHash=? AND version=? AND ready=1 AND used=0 AND attempts<5 AND expiresAt>? RETURNING *')
+    .bind(id, user.id, tokenHash, user.securityVersion ?? 0, Date.now()).first<Stored>()
+  if (!request) fail('SECURITY_REQUEST_EXPIRED', 409)
+  const currentCaps = await capabilities(c, user)
+  if (!currentCaps[request!.action] || JSON.stringify(currentCaps) !== JSON.stringify(JSON.parse(request!.guard).capabilities)) fail('SECURITY_UNAVAILABLE', 409)
+  const proofs = JSON.parse(request!.proofs) as Record<string, string>
+  for (const [key, expected] of Object.entries(proofs)) {
+    if (!otpCode(body[key]) || await digest(id + ':' + key + ':' + body[key]) !== expected) fail('SECURITY_INVALID_CODE', 400)
+  }
+  if (request!.action === 'otp-enable') {
+    const payload = JSON.parse(request!.payload)
+    if (payload.recoveryHash && body.savedRecoveryCode !== true) fail('SECURITY_INVALID_INPUT', 400)
+    await consumeOtp(c, user.id, payload.secret, body.newOtp)
+  }
+  try {
