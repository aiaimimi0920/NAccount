diff --git a/server/src/pages/account/AuthDialog.test.tsx b/server/src/pages/account/AuthDialog.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..888a06b162b3530c21c1e6b5d86ffda6f1ffbad8
--- /dev/null
+++ b/server/src/pages/account/AuthDialog.test.tsx
@@ -0,0 +1,117 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { render } from 'hono/jsx/dom'
+import { useState } from 'hono/jsx'
+import { fireEvent, getByRole, waitFor } from '@testing-library/dom'
+import AuthDialog from './AuthDialog'
+import * as auth from './auth'
+import { View } from '../hooks'
+
+vi.mock('./auth', async (original) => ({
+  ...await original<typeof import('./auth')>(),
+  beginAuthorization: vi.fn(), request: vi.fn(), restore: vi.fn(), profile: vi.fn(),
+}))
+const config: auth.PortalConfig = {
+  clientId: 'portal', serverUri: 'http://localhost:3000', redirectUri: 'http://localhost:3000/account', signup: true, policies: [],
+}
+const initialProps = { locales: 'en,zh', enableLocaleSelector: true, enablePasswordSignIn: true, enableSignUp: true, enablePasswordReset: true }
+let container: HTMLDivElement
+const authenticated = vi.fn()
+const fetchMock = vi.fn()
+
+beforeEach(() => {
+  vi.resetAllMocks()
+  sessionStorage.clear()
+  window.history.replaceState(null, '', '/account#apps')
+  HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', '') }
+  HTMLDialogElement.prototype.close = function () { this.removeAttribute('open') }
+  container = document.createElement('div'); document.body.appendChild(container)
+  vi.mocked(auth.beginAuthorization).mockImplementation(async (_config, _policy, signup) => new URL('http://localhost:3000/identity/v1/view/authorize?client_id=portal&state=state&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Faccount' + (signup ? '&screen=signup' : '')))
+  vi.mocked(auth.request).mockResolvedValue({ initialProps, locale: 'en' })
+  vi.mocked(auth.restore).mockResolvedValue('access')
+  vi.mocked(auth.profile).mockResolvedValue({ authId: 'user', email: 'user@example.test', emailVerified: true })
+  vi.stubGlobal('fetch', fetchMock)
+})
+afterEach(async () => {
+  const close = container.querySelector('button[aria-label="关闭弹窗"]')
+  if (close) { fireEvent.click(close); await waitFor(() => expect(container.querySelector('dialog')).toBeNull()) }
+  render(null, container); container.remove(); vi.unstubAllGlobals()
+})
+
+function Host({ signup }: { signup: boolean }) {
+  const [open, setOpen] = useState(true)
+  return <div>{open && <AuthDialog config={config} signup={signup} onClose={() => setOpen(false)} onAuthenticated={authenticated} />}</div>
+}
+
+function mount(signup = false) {
+  render(<Host signup={signup} />, container)
+}
+async function signIn() {
+  await waitFor(() => expect(container.querySelector('#form-email')).toBeTruthy())
+  fireEvent.input(container.querySelector('#form-email')!, { target: { value: 'user@example.test' } })
+  fireEvent.input(container.querySelector('#form-password')!, { target: { value: 'Test-only-Password!123' } })
+  await new Promise((done) => setTimeout(done, 0))
+  // Hono's form-action listener expects detail on synthetic (untrusted) submit events.
+  fireEvent(container.querySelector('form')!, new CustomEvent('submit', { bubbles: true, cancelable: true, detail: {} }))
+}
+const success = { redirectUri: config.redirectUri, state: 'state', code: 'code' }
+
+describe('embedded portal authentication', () => {
+  it('switches login and registration inside the same page', async () => {
+    mount()
+    await waitFor(() => expect(getByRole(container, 'button', { name: 'Create a new account' })).toBeTruthy())
+    fireEvent.click(getByRole(container, 'button', { name: 'Create a new account' }))
+    await waitFor(() => expect(container.querySelector('input[autocomplete="new-password"]')).toBeTruthy())
+    expect(window.location.pathname + window.location.hash).toBe('/account#apps')
+    expect(authenticated).not.toHaveBeenCalled()
+  })
+  it('switches to reset password inside the same page', async () => {
+    mount()
+    await waitFor(() => expect(getByRole(container, 'button', { name: 'Reset password' })).toBeTruthy())
+    fireEvent.click(getByRole(container, 'button', { name: 'Reset password' }))
+    await waitFor(() => expect(container.querySelector('#form-password')).toBeNull())
+    expect(authenticated).not.toHaveBeenCalled()
+  })
+  it('opens registration directly and can close with Escape without navigation', async () => {
+    mount(true)
+    await waitFor(() => expect(container.querySelector('input[autocomplete="new-password"]')).toBeTruthy())
+    fireEvent(container.querySelector('dialog')!, new Event('cancel', { cancelable: true }))
+    await waitFor(() => expect(container.querySelector('dialog')).toBeNull())
+    expect(window.location.pathname).toBe('/account')
+    await waitFor(() => expect(document.body.style.overflow).toBe(''))
+  })
+  it('exchanges the callback and loads the profile without redirecting', async () => {
+    fetchMock.mockResolvedValue(Response.json(success))
+    mount(); await signIn()
+    await waitFor(() => expect(authenticated).toHaveBeenCalledWith('access', expect.objectContaining({ authId: 'user' })))
+    expect(auth.restore).toHaveBeenCalledWith(config, expect.any(URL), expect.any(Function))
+    expect(window.location.pathname + window.location.hash).toBe('/account#apps')
+  })
+  it('keeps MFA as an intermediate step and never authenticates prematurely', async () => {
+    fetchMock.mockResolvedValueOnce(Response.json({ ...success, nextPage: View.OtpMfa }))
+      .mockResolvedValue(Response.json({ allowFallbackToEmailMfa: false }))
+    mount(); await signIn()
+    await waitFor(() => expect(fetchMock.mock.calls.some(([url]) => String(url).includes('code=code'))).toBe(true))
+    expect(auth.restore).not.toHaveBeenCalled()
+    expect(authenticated).not.toHaveBeenCalled()
+    expect(window.location.pathname).toBe('/account')
+  })
+  it('discards a login response arriving after the dialog was closed', async () => {
+    let resolve!: (value: Response) => void
+    fetchMock.mockImplementation(() => new Promise<Response>((done) => { resolve = done }))
+    mount(); await signIn()
+    await waitFor(() => expect(fetchMock).toHaveBeenCalled())
+    fireEvent.click(getByRole(container, 'button', { name: '关闭弹窗' }))
+    await waitFor(() => expect(container.querySelector('dialog')).toBeNull())
+    resolve(Response.json(success))
+    await new Promise((done) => setTimeout(done, 20))
+    expect(auth.restore).not.toHaveBeenCalled()
+    expect(authenticated).not.toHaveBeenCalled()
+  })
+  it('rejects a response pointing outside the configured callback', async () => {
+    fetchMock.mockResolvedValue(Response.json({ ...success, redirectUri: 'https://other.example/account' }))
+    mount(); await signIn()
+    await waitFor(() => expect(getByRole(container, 'alert')).toBeTruthy())
+    expect(auth.restore).not.toHaveBeenCalled()
+    expect(authenticated).not.toHaveBeenCalled()
+  })
+})
