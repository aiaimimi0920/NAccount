+import { useEffect, useState } from 'hono/jsx'
+import Main from '../Main'
+import { AuthRuntime, AuthRuntimeContext } from '../tools/authRuntime'
+import Dialog from './Dialog'
+import * as auth from './auth'
+
+export default function AuthDialog({ config, signup, onClose, onAuthenticated }: {
+  config: auth.PortalConfig; signup: boolean; onClose: () => void;
+  onAuthenticated: (token: string, user: auth.Profile) => void;
+}) {
+  const [runtime, setRuntime] = useState<AuthRuntime | null>(null)
+  const [error, setError] = useState('')
+  const [completing, setCompleting] = useState(false)
+  useEffect(() => {
+    let active = true
+    let flow: AuthRuntime | null = null
+    let finishing = false
+    let authenticated = false
+    const complete = async (href: string) => {
+      if (!active || finishing) return
+      finishing = true
+      setCompleting(true)
+      try {
+        const callback = new URL(href)
+        const expected = new URL(config.redirectUri)
+        if (callback.origin !== expected.origin || callback.pathname !== expected.pathname) throw new auth.PortalError('INVALID_CALLBACK')
+        const token = await auth.restore(config, callback, () => active)
+        if (!token || !active) return
+        const user = await auth.profile(config, token)
+        if (active) { authenticated = true; onAuthenticated(token, user) }
+      } catch {
+        if (active) setError('登录未完成或请求已失效，请关闭后重试。')
+      } finally {
+        if (active) setCompleting(false)
+      }
+    }
+    const start = async () => {
+      try {
+        const url = await auth.beginAuthorization(config, undefined, signup, () => active)
+        // Interactive view returns the same server-validated flags as standalone authentication.
+        url.pathname = '/identity/v1/view/authorize'
+        const response = await auth.request<{ initialProps: Record<string, unknown>; locale: string }>(url.href, {
+          headers: { Accept: 'application/json' },
+        })
+        if (!active) return
+        url.searchParams.set('locale', response.locale)
+        flow = { url, initialProps: response.initialProps, active: true, complete: (href) => { void complete(href) } }
+        setRuntime(flow)
+      } catch {
+        if (active) setError('无法加载登录表单，请关闭后重试。')
+      }
+    }
+    void start()
+    return () => {
+      active = false
+      if (flow) flow.active = false
+      auth.cancelAuthorization()
+      if (!authenticated) auth.clearSession()
+    }
+  }, [])
+
+  return <Dialog title='账号验证' heading={false} onClose={onClose}>
+    {error ? <p class='error-inline' role='alert'>{error}</p> : completing ? <p role='status'>正在登录…</p> : runtime
+      ? <AuthRuntimeContext.Provider value={runtime}><Main /></AuthRuntimeContext.Provider>
+      : <p role='status'>正在加载…</p>}
+  </Dialog>
+}
