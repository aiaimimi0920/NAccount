diff --git a/server/src/pages/tools/authRuntime.ts b/server/src/pages/tools/authRuntime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ff80455474ba68202606e985bf5d599924b2363b
--- /dev/null
+++ b/server/src/pages/tools/authRuntime.ts
@@ -0,0 +1,20 @@
+import { createContext, useContext } from 'hono/jsx'
+
+// An embedded flow owns its URL and lifetime; late responses must not escape it.
+export interface AuthRuntime {
+  url: URL;
+  initialProps: Record<string, unknown>;
+  active: boolean;
+  complete: (url: string) => void;
+}
+
+export const AuthRuntimeContext = createContext<AuthRuntime | null>(null)
+export const useAuthRuntime = () => useContext(AuthRuntimeContext)
+
+export function navigateAuth(url: URL, runtime: AuthRuntime | null = null) {
+  if (runtime) {
+    if (runtime.active) runtime.url = url
+  } else {
+    window.history.pushState({}, '', url)
+  }
+}
