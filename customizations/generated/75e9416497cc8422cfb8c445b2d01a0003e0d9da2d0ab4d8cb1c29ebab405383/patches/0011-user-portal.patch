   })
 
+  it('combines first-render profile and social data in four D1 statements with one current-user check', async () => {
+    const reads = vi.spyOn(env.DB, 'prepare')
+    const keys = vi.spyOn(env.KV, 'get')
+    const separateProfile = await (await get()).json() as Record<string, unknown>
+    const separateSocial = await (await get('/account/api/social')).json()
+    expect(reads).toHaveBeenCalledTimes(6)
+    expect(keys).toHaveBeenCalledTimes(2)
+    reads.mockClear(); keys.mockClear()
+    const users = vi.spyOn(userModel, 'getByAuthId')
+    const response = await get('/account/api/profile?include=social')
+    expect(response.status).toBe(200)
+    expect(await response.json()).toEqual({ ...separateProfile, social: separateSocial })
+    expect(response.headers.get('Cache-Control')).toBe('no-store')
+    expect(users).toHaveBeenCalledTimes(1)
+    // Current user, portal client, profile card, linked identities. No second bearer lookup.
+    expect(reads).toHaveBeenCalledTimes(4)
+    expect(keys).toHaveBeenCalledTimes(1)
+  })
+
   it.each(['version', 'disabled', 'deleted'])('does not cache the user across requests after %s changes', async (kind) => {
-    expect((await get()).status).toBe(200)
+    expect((await get('/account/api/profile?include=social')).status).toBe(200)
