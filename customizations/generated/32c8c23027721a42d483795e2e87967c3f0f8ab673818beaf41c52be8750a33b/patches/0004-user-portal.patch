+++ b/server/src/__tests__/normal/social-google-proof.test.ts
@@ -0,0 +1,37 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { generateKeyPairSync, sign } from 'node:crypto'
+import { jwtService } from 'services'
+
+const { privateKey, publicKey } = generateKeyPairSync('rsa', { modulusLength: 2048 })
+const jwk = { ...publicKey.export({ format: 'jwk' }), kid: 'isolated-provider-fixture' }
+const token = (overrides: Record<string, unknown> = {}) => {
+  const now = Math.floor(Date.now() / 1000)
+  const payload = { iss: 'https://accounts.google.com', aud: 'google-client', sub: 'provider-subject', nonce: 'one-time-nonce',
+    email: 'provider@example.test', email_verified: true, iat: now, exp: now + 300, ...overrides }
+  const data = `${Buffer.from(JSON.stringify({ alg: 'RS256', kid: jwk.kid })).toString('base64url')}.${Buffer.from(JSON.stringify(payload)).toString('base64url')}`
+  return `${data}.${Buffer.from(sign('RSA-SHA256', Buffer.from(data), privateKey)).toString('base64url')}`
+}
+afterEach(() => vi.unstubAllGlobals())
+
+describe('signed Google linking proof', () => {
+  it('accepts matching issuer, audience, subject, nonce and recent signed claims', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(Response.json({ keys: [jwk] })))
+    expect(await jwtService.verifyGoogleCredential('google-client', token(), 'one-time-nonce')).toMatchObject({ id: 'provider-subject', emailVerified: true })
+  })
+  it.each([
+    { nonce: 'different' }, { aud: 'different-client' }, { iss: 'https://evil.example' },
+    { sub: '' }, { iat: 1 }, { iat: Math.floor(Date.now() / 1000) + 1000 },
+    { email_verified: false }, { email_verified: 'true' }, { azp: 'different-client' }, { aud: ['google-client', 'other'] },
+  ])('rejects mismatched signed claims: %j', async (claims) => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(Response.json({ keys: [jwk] })))
+    let value
+    try { value = await jwtService.verifyGoogleCredential('google-client', token(claims), 'one-time-nonce') } catch { value = undefined }
+    expect(value).toBeUndefined()
+  })
+  it('rejects a valid-looking token whose signature is forged', async () => {
+    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(Response.json({ keys: [jwk] })))
+    const parts = token().split('.')
+    parts[1] = Buffer.from(JSON.stringify({ sub: 'attacker' })).toString('base64url')
+    await expect(jwtService.verifyGoogleCredential('google-client', parts.join('.'), 'one-time-nonce')).rejects.toThrow()
+  })
+})
