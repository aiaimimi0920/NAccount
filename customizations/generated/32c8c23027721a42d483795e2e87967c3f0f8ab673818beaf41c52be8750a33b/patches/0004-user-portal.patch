@@ -0,0 +1,67 @@
+import { useEffect, useState } from 'hono/jsx'
+import { request } from './auth'
+
+interface SocialStatus {
+  canManage: boolean;
+  providers: { provider: 'Google' | 'GitHub'; available: boolean; bound: boolean; primary: boolean; label: string | null }[];
+}
+
+export default function SocialAccounts({ accessToken }: { accessToken: string }) {
+  const [status, setStatus] = useState<SocialStatus | null>(null)
+  const [password, setPassword] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+  const [attempt, setAttempt] = useState(0)
+  const headers = { Authorization: `Bearer ${accessToken}`, 'Content-Type': 'application/json' }
+  useEffect(() => {
+    let stale = false
+    setBusy(true)
+    setError('')
+    void request<SocialStatus>('/account/api/social', { headers }).then((value) => {
+      if (!stale) setStatus(value)
+    }).catch(() => {
+      if (!stale) setError('无法读取社交账号，请重试或重新登录。')
+    }).finally(() => { if (!stale) setBusy(false) })
+    return () => { stale = true }
+  }, [accessToken, attempt])
+
+  const act = async (provider: 'Google' | 'GitHub', unlink: boolean) => {
+    if (busy || !password) return
+    if (unlink && !window.confirm(`确认解绑 ${provider}？解绑后该社交账号将不能登录此 NAccount。`)) return
+    setBusy(true)
+    setError('')
+    const secret = password
+    setPassword('')
+    try {
+      const result = await request<{ authorizeUrl?: string }>(`/account/api/social/${unlink ? 'unlink' : 'start'}`, {
+        method: 'POST', headers, body: JSON.stringify({ provider, password: secret }),
+      })
+      if (unlink) { setAttempt(attempt + 1); return }
+      const url = new URL(result.authorizeUrl ?? '')
+      if (url.protocol !== 'https:' || url.hostname !== (provider === 'Google' ? 'accounts.google.com' : 'github.com')) throw new Error('Invalid provider URL')
+      window.location.assign(url.href)
+    } catch {
+      setError('操作未完成。请检查当前密码、邮箱验证状态和账号绑定状态后重试。')
+    } finally { setBusy(false) }
+  }
+  const button = 'rounded-lg border border-slate-300 px-4 py-2 disabled:opacity-50 focus-visible:outline-2'
+  return <section aria-labelledby='social-accounts' class='rounded-xl border border-slate-200 bg-white p-6'>
+    <h2 id='social-accounts' class='text-lg font-semibold mb-4'>社交账号</h2>
+    {busy && <p role='status'>正在处理…</p>}
+    {error && <div role='alert'><p>{error}</p><button class={button} disabled={busy} onClick={() => setAttempt(attempt + 1)}>重试社交账号</button></div>}
+    {status && <>
+      {!status.canManage && <p>绑定管理需要已验证邮箱和当前账号密码。</p>}
+      {status.canManage && <label class='flex flex-col gap-2 mb-4'>确认当前密码
+        <input class='rounded-lg border border-slate-300 p-3' type='password' autoComplete='current-password' value={password}
+          disabled={busy} onInput={(event) => setPassword((event.target as HTMLInputElement).value)} />
+      </label>}
+      <ul class='flex flex-col gap-4'>
+        {status.providers.map((entry) => <li key={entry.provider} class='flex flex-wrap items-center justify-between gap-3'>
+          <div><strong>{entry.provider}</strong><p class='text-sm'>{entry.primary ? '原始登录方式' : entry.bound ? `已绑定 · ${entry.label ?? ''}` : entry.available ? '未绑定' : '未配置'}</p></div>
+          {!entry.primary && <button class={button} disabled={busy || !status.canManage || !password || (!entry.bound && !entry.available)}
+            onClick={() => act(entry.provider, entry.bound)}>{entry.bound ? `解绑 ${entry.provider}` : `绑定 ${entry.provider}`}</button>}
+        </li>)}
+      </ul>
+    </>}
+  </section>
+}
