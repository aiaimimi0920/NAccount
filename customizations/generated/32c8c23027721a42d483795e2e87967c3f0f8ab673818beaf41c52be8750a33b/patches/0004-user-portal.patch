diff --git a/server/src/models/socialIdentity.ts b/server/src/models/socialIdentity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9864912e3efc9b564c93a702feebf7cf574c02a3
--- /dev/null
+++ b/server/src/models/socialIdentity.ts
@@ -0,0 +1,56 @@
+import { errorConfig } from 'configs'
+import { userModel } from 'models'
+
+export type Provider = 'Google' | 'GitHub'
+export interface Identity { provider: Provider; subject: string; userId: number; label: string }
+export interface LinkRequest {
+  state: string; provider: Provider; userId: number; clientId: string;
+  passwordFingerprint: string; browserHash: string; verifier: string; nonce: string; expiresAt: number;
+}
+
+export const list = async (db: D1Database, userId: number) => {
+  const result = await db.prepare('SELECT provider,subject,"userId",label FROM naccount_social_identity WHERE "userId"=$1').bind(userId).all<Identity>()
+  return result.results
+}
+
+export const resolve = async (db: D1Database, provider: Provider, subject: string, org?: string): Promise<userModel.Record | null> => {
+  const identity = await db.prepare('SELECT "userId" FROM naccount_social_identity WHERE provider=$1 AND subject=$2').bind(provider, String(subject)).first<{ userId: number }>()
+  if (!identity) return null
+  const raw = await db.prepare('SELECT * FROM "user" WHERE id=$1').bind(identity.userId).first<userModel.Raw>()
+  // A disabled/deleted owner is never replaced by a newly created provider account.
+  if (!raw || raw.deletedAt || !raw.isActive || (org && org !== 'default' && raw.orgSlug !== org) || (org === 'default' && raw.orgSlug)) {
+    throw new errorConfig.Forbidden('NACCOUNT_LINKED_ACCOUNT_UNAVAILABLE')
+  }
+  return userModel.convertToRecord(raw)
+}
+
+export const consume = (db: D1Database, state: string, provider: Provider, browserHash: string) => db.prepare(
+  'DELETE FROM naccount_link_request WHERE state=$1 AND provider=$2 AND "browserHash"=$3 AND "expiresAt">$4 RETURNING *',
+).bind(state, provider, browserHash, Date.now()).first<LinkRequest>()
+
+export const saveRequest = async (db: D1Database, value: LinkRequest) => {
+  // Short-lived authorization material, never provider tokens or the user's password.
+  await db.prepare('DELETE FROM naccount_link_request WHERE expiresAt<=$1 OR (userId=$2 AND provider=$3)').bind(Date.now(), value.userId, value.provider).run()
+  await db.prepare('INSERT INTO naccount_link_request(state,provider,userId,clientId,passwordFingerprint,browserHash,verifier,nonce,expiresAt) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)').bind(
+    value.state, value.provider, value.userId, value.clientId, value.passwordFingerprint,
+    value.browserHash, value.verifier, value.nonce, value.expiresAt,
+  ).run()
+}
+
+export const bind = async (db: D1Database, identity: Identity, password: string) => {
+  try {
+    const result = await db.prepare(`INSERT INTO naccount_social_identity(provider,subject,"userId",label)
+      SELECT $1,$2,id,$3 FROM "user" WHERE id=$4 AND password=$5 AND "isActive"=1 AND "emailVerified"=1 AND "deletedAt" IS NULL RETURNING provider`).bind(
+      identity.provider, identity.subject, identity.label, identity.userId, password,
+    ).first()
+    if (!result) throw new Error('Owner changed')
+  } catch {
+    // Includes uniqueness/legacy-ownership races. Never retry or silently reassign.
+    throw new errorConfig.Forbidden('NACCOUNT_IDENTITY_CONFLICT')
+  }
+}
+
+export const unbind = (db: D1Database, provider: Provider, userId: number, password: string) => db.prepare(
+  `DELETE FROM naccount_social_identity WHERE provider=$1 AND "userId"=$2
+   AND EXISTS (SELECT 1 FROM "user" WHERE id=$3 AND password=$4 AND "isActive"=1 AND "deletedAt" IS NULL) RETURNING provider`,
+).bind(provider, userId, userId, password).first<{ provider: Provider }>()
