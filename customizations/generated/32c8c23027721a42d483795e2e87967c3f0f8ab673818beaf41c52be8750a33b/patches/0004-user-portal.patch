diff --git a/server/src/__tests__/normal/account-social.test.ts b/server/src/__tests__/normal/account-social.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..55da9b3be8f2febe7834325ec2752eec74263a67
--- /dev/null
+++ b/server/src/__tests__/normal/account-social.test.ts
@@ -0,0 +1,152 @@
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { Hono } from 'hono'
+import { Database } from 'better-sqlite3'
+import { migrate, mock } from 'tests/mock'
+import { typeConfig } from 'configs'
+import { cryptoUtil } from 'utils'
+import { jwtService, userService } from 'services'
+import * as social from 'services/accountSocial'
+import * as identity from 'models/socialIdentity'
+import account from 'routes/account'
+
+let db: Database
+let env: typeConfig.Bindings
+let app: Hono<typeConfig.Context>
+let passwordHash: string
+const password = 'Synthetic-Test-Only-493!'
+const providerFetch = vi.fn()
+
+beforeEach(async () => {
+  db = await migrate()
+  passwordHash = await cryptoUtil.bcryptText(password)
+  db.prepare('INSERT INTO user(authId,email,password,emailVerified,otpSecret) VALUES(?,?,?,?,?)').run('owner', 'owner@example.test', passwordHash, 1, 'test-otp')
+  db.prepare('INSERT INTO user(authId,email,password,emailVerified,otpSecret) VALUES(?,?,?,?,?)').run('other', 'other@example.test', passwordHash, 1, 'test-otp')
+  db.prepare('UPDATE app SET redirectUris=? WHERE clientId=?').run('https://auth.example.test/account', 'naccount-user-portal')
+  env = { ...process.env, ...mock(db), AUTH_SERVER_URL: 'https://auth.example.test', NACCOUNT_PORTAL_CLIENT_ID: 'naccount-user-portal',
+    GOOGLE_AUTH_CLIENT_ID: 'google-test', GOOGLE_AUTH_CLIENT_SECRET: 'google-secret-fixture',
+    GITHUB_AUTH_CLIENT_ID: 'github-test', GITHUB_AUTH_CLIENT_SECRET: 'github-secret-fixture', GITHUB_AUTH_APP_NAME: 'test-app',
+    PG_CONNECTION_STRING: '',
+  } as unknown as typeConfig.Bindings
+  vi.spyOn(jwtService, 'getAccessTokenBody').mockImplementation(async (_c, token) => {
+    if (!['owner', 'other', 'admin-client', 'no-profile'].includes(token)) throw new Error('Invalid fixture token')
+    return { sub: token === 'other' ? 'other' : 'owner', azp: token === 'admin-client' ? 'administrator-client' : 'naccount-user-portal',
+      scope: token === 'no-profile' ? 'openid' : 'openid profile', iss: env.AUTH_SERVER_URL } as typeConfig.AccessTokenBody
+  })
+  vi.spyOn(jwtService, 'verifyGoogleCredential').mockResolvedValue({ id: 'google-subject', email: 'different-provider-email@example.test', emailVerified: true, firstName: 'External', lastName: '' })
+  providerFetch.mockReset()
+  providerFetch.mockImplementation(async (url) => Response.json(String(url).includes('/user') ? { id: 12345, login: 'github-user' } : { id_token: 'signed-test-token', access_token: 'provider-test-token' }))
+  vi.stubGlobal('fetch', providerFetch)
+  app = new Hono<typeConfig.Context>()
+  app.route('/', account)
+  app.get('/identity/v1/authorize-github', (c) => social.callback(c, 'GitHub'))
+  app.get('/simulate-google-login', async (c) => c.json(await userService.processGoogleAccount(c, { id: 'google-subject', email: 'different-provider-email@example.test', emailVerified: true, firstName: '', lastName: '' }, 'en')))
+  app.get('/simulate-github-login', async (c) => c.json(await userService.processGithubAccount(c, { id: '12345', email: null as any, firstName: '', lastName: '' }, 'en')))
+})
+afterEach(() => { db.close(); vi.restoreAllMocks(); vi.unstubAllGlobals() })
+
+const post = (path: string, body: object, token = 'owner') => app.request(path, {
+  method: 'POST', headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+}, env)
+async function start(provider: 'Google' | 'GitHub' = 'Google', token = 'owner') {
+  const response = await post('/account/api/social/start', { provider, password }, token)
+  expect(response.status).toBe(200)
+  const { authorizeUrl } = await response.json() as { authorizeUrl: string }
+  const url = new URL(authorizeUrl)
+  const cookie = response.headers.get('set-cookie')!.split(';')[0]
+  return { url, cookie, state: url.searchParams.get('state')!, callback: url.searchParams.get('redirect_uri')! }
+}
+const finish = (value: Awaited<ReturnType<typeof start>>, query = '') => app.request(`${value.callback}?state=${value.state}&code=provider-code${query}`, { headers: { Cookie: value.cookie } }, env)
+
+describe('self-service social identities (D1)', () => {
+  it.each(['Google', 'GitHub'] as const)('binds %s and resolves future login to the original authId, not the provider email', async (provider) => {
+    const value = await start(provider)
+    expect(value.url.searchParams.get('code_challenge_method')).toBe('S256')
+    expect(value.url.searchParams.get('code_challenge')).toHaveLength(43)
+    const response = await finish(value)
+    expect(response.headers.get('location')).toBe('/account?link_result=success')
+    expect(db.prepare('SELECT count(*) AS count FROM user').get()).toEqual({ count: 2 })
+    const login = await app.request(provider === 'Google' ? '/simulate-google-login' : '/simulate-github-login', {}, env)
+    expect(login.status).toBe(200)
+    expect(await login.json()).toMatchObject({ authId: 'owner', email: 'owner@example.test' })
+    const tokenBody = new URLSearchParams(providerFetch.mock.calls[0][1].body)
+    expect(tokenBody.get('redirect_uri')).toBe(value.callback)
+    expect(tokenBody.get('code_verifier')).toHaveLength(64)
+    expect(tokenBody.get('code_verifier')).not.toBe(value.url.searchParams.get('code_challenge'))
+    if (provider === 'Google') expect(jwtService.verifyGoogleCredential).toHaveBeenCalledWith('google-test', 'signed-test-token', value.url.searchParams.get('nonce'))
+    const calls = providerFetch.mock.calls.length
+    expect((await finish(value)).headers.get('location')).toBe('/account?link_result=failed')
+    expect(providerFetch).toHaveBeenCalledTimes(calls)
+  })
+  it.each(['admin-client', 'no-profile', 'invalid-token'])('rejects unrelated or invalid token %s', async (token) => {
+    expect((await post('/account/api/social/start', { provider: 'Google', password }, token)).status).not.toBe(200)
+    expect(db.prepare('SELECT count(*) AS count FROM naccount_link_request').get()).toEqual({ count: 0 })
+  })
+  it('requires a current password and verified email, and does not accept an owner ID from the body', async () => {
+    expect((await post('/account/api/social/start', { provider: 'Google', password: 'wrong', authId: 'other' })).status).toBe(400)
+    db.prepare('UPDATE user SET emailVerified=0 WHERE authId=?').run('owner')
+    expect((await post('/account/api/social/start', { provider: 'Google', password })).status).toBe(400)
+  })
+  it.each(['browser', 'state', 'expired', 'cancelled', 'duplicate'])('rejects invalid callback: %s without contacting provider', async (kind) => {
+    const value = await start()
+    if (kind === 'browser') value.cookie = '__Host-naccount-link-google=wrong-browser'
+    if (kind === 'state') value.state += 'x'
+    if (kind === 'expired') db.prepare('UPDATE naccount_link_request SET expiresAt=0').run()
+    const response = await finish(value, kind === 'cancelled' ? '&error=access_denied' : kind === 'duplicate' ? '&state=another' : '')
+    expect(response.headers.get('location')).toBe('/account?link_result=failed')
+    expect(providerFetch).not.toHaveBeenCalled()
+    expect(await identity.list(env.DB, 1)).toEqual([])
+  })
+  it.each(['disabled', 'deleted', 'password', 'client'])('rejects owner or client changes during authorization: %s', async (kind) => {
+    const value = await start()
+    if (kind === 'disabled') db.prepare('UPDATE user SET isActive=0 WHERE authId=?').run('owner')
+    if (kind === 'deleted') db.prepare('UPDATE user SET deletedAt=CURRENT_TIMESTAMP WHERE authId=?').run('owner')
+    if (kind === 'password') db.prepare('UPDATE user SET password=? WHERE authId=?').run('changed', 'owner')
+    if (kind === 'client') db.prepare('UPDATE app SET isActive=0 WHERE clientId=?').run('naccount-user-portal')
+    expect((await finish(value)).headers.get('location')).toBe('/account?link_result=failed')
+    expect(providerFetch).not.toHaveBeenCalled()
+  })
+  it('does not reassign a provider identity already bound to someone else', async () => {
+    await finish(await start())
+    expect((await finish(await start('Google', 'other'))).headers.get('location')).toBe('/account?link_result=failed')
+    expect((await identity.resolve(env.DB, 'Google', 'google-subject'))?.authId).toBe('owner')
+  })
+  it('does not merge an existing native provider account, even with identical email', async () => {
+    db.prepare('UPDATE user SET socialAccountType=?,socialAccountId=? WHERE authId=?').run('Google', 'google-subject', 'other')
+    expect((await finish(await start())).headers.get('location')).toBe('/account?link_result=failed')
+    expect(await identity.list(env.DB, 1)).toEqual([])
+  })
+  it('database constraints reject races with legacy registration and duplicate primary identities', async () => {
+    await finish(await start())
+    expect(() => db.prepare('UPDATE user SET socialAccountType=?,socialAccountId=? WHERE authId=?').run('Google', 'google-subject', 'other')).toThrow()
+    db.prepare('UPDATE user SET socialAccountType=?,socialAccountId=? WHERE authId=?').run('GitHub', 'legacy-id', 'other')
+    expect(() => db.prepare('UPDATE user SET socialAccountType=?,socialAccountId=? WHERE authId=?').run('GitHub', 'legacy-id', 'owner')).toThrow()
+  })
+  it('will not create a replacement account for a disabled/deleted binding owner', async () => {
+    await finish(await start())
+    db.prepare('UPDATE user SET isActive=0 WHERE authId=?').run('owner')
+    await expect(identity.resolve(env.DB, 'Google', 'google-subject')).rejects.toThrow('NACCOUNT_LINKED_ACCOUNT_UNAVAILABLE')
+    expect(db.prepare('SELECT count(*) AS count FROM user').get()).toEqual({ count: 2 })
+  })
+  it('unbind requires current password, operates only on self, and leaves password usable', async () => {
+    await finish(await start())
+    expect((await post('/account/api/social/unlink', { provider: 'Google', password }, 'other')).status).toBe(400)
+    expect((await post('/account/api/social/unlink', { provider: 'Google', password: 'wrong' })).status).toBe(400)
+    expect((await post('/account/api/social/unlink', { provider: 'Google', password })).status).toBe(200)
+    expect(await identity.resolve(env.DB, 'Google', 'google-subject')).toBeNull()
+    expect((db.prepare('SELECT password FROM user WHERE authId=?').get('owner') as any).password).toBe(passwordHash)
+  })
+  it('does not offer destructive management when no password remains', async () => {
+    db.prepare('UPDATE user SET password=NULL WHERE authId=?').run('owner')
+    const response = await app.request('/account/api/social', { headers: { Authorization: 'Bearer owner' } }, env)
+    expect(await response.json()).toMatchObject({ canManage: false })
+    expect((await post('/account/api/social/unlink', { provider: 'Google', password })).status).toBe(400)
+  })
+  it('fails closed and consumes the transaction if the provider is unavailable', async () => {
+    const value = await start()
+    providerFetch.mockRejectedValue(new Error('sensitive-provider-details'))
+    const response = await finish(value)
+    expect(response.headers.get('location')).toBe('/account?link_result=failed')
+    expect(await response.text()).not.toContain('sensitive')
+    expect(db.prepare('SELECT count(*) AS count FROM naccount_link_request').get()).toEqual({ count: 0 })
+  })
+})
