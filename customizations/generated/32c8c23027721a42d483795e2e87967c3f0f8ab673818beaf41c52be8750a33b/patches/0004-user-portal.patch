+// Read-compatible schema. NAccount self-service binding is currently D1-only.
+exports.up = async function (knex) {
+  await knex.schema.createTable('naccount_social_identity', (table) => {
+    table.string('provider').notNullable()
+    table.string('subject').notNullable()
+    table.integer('userId').notNullable().references('id').inTable('user')
+    table.string('label').notNullable()
+    table.timestamp('createdAt').notNullable().defaultTo(knex.fn.now())
+    table.primary(['provider', 'subject'])
+    table.unique(['userId', 'provider'])
+  })
+}
+exports.down = async function (knex) {
+  await knex.schema.dropTable('naccount_social_identity')
+}
diff --git a/server/migrations/sqlite/0047_naccount_social_identity.sql b/server/migrations/sqlite/0047_naccount_social_identity.sql
new file mode 100644
index 0000000000000000000000000000000000000000..8967a95333bf43f9a4a8626ced1f5baf4d3b9a4d
--- /dev/null
+++ b/server/migrations/sqlite/0047_naccount_social_identity.sql
@@ -0,0 +1,39 @@
+CREATE TABLE naccount_social_identity (
+  provider TEXT NOT NULL CHECK (provider IN ('Google', 'GitHub')),
+  subject TEXT NOT NULL,
+  userId INTEGER NOT NULL REFERENCES user(id),
+  label TEXT NOT NULL,
+  createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  PRIMARY KEY (provider, subject),
+  UNIQUE (userId, provider)
+);
+
+CREATE TABLE naccount_link_request (
+  state TEXT PRIMARY KEY,
+  provider TEXT NOT NULL CHECK (provider IN ('Google', 'GitHub')),
+  userId INTEGER NOT NULL REFERENCES user(id),
+  clientId TEXT NOT NULL,
+  passwordFingerprint TEXT NOT NULL,
+  browserHash TEXT NOT NULL,
+  verifier TEXT NOT NULL,
+  nonce TEXT NOT NULL,
+  expiresAt INTEGER NOT NULL
+);
+CREATE INDEX naccount_link_expiry ON naccount_link_request(expiresAt);
+
+-- Abort migration on ambiguous legacy ownership instead of merging accounts or choosing a winner.
+CREATE UNIQUE INDEX naccount_primary_social_unique ON user(socialAccountType, CAST(socialAccountId AS TEXT))
+WHERE socialAccountType IN ('Google', 'GitHub') AND socialAccountId IS NOT NULL;
+
+-- Enforce ownership across new bindings and legacy primary social accounts, including tombstones.
+CREATE TRIGGER naccount_identity_owner BEFORE INSERT ON naccount_social_identity
+WHEN EXISTS (SELECT 1 FROM user WHERE socialAccountType=NEW.provider AND CAST(socialAccountId AS TEXT)=NEW.subject)
+BEGIN SELECT RAISE(ABORT, 'NACCOUNT_IDENTITY_CONFLICT'); END;
+
+CREATE TRIGGER naccount_primary_identity_insert BEFORE INSERT ON user
+WHEN EXISTS (SELECT 1 FROM naccount_social_identity WHERE provider=NEW.socialAccountType AND subject=CAST(NEW.socialAccountId AS TEXT))
+BEGIN SELECT RAISE(ABORT, 'NACCOUNT_IDENTITY_CONFLICT'); END;
+
+CREATE TRIGGER naccount_primary_identity_update BEFORE UPDATE OF socialAccountType,socialAccountId ON user
+WHEN EXISTS (SELECT 1 FROM naccount_social_identity WHERE provider=NEW.socialAccountType AND subject=CAST(NEW.socialAccountId AS TEXT))
+BEGIN SELECT RAISE(ABORT, 'NACCOUNT_IDENTITY_CONFLICT'); END;
