diff --git a/server/src/services/accountSocial.ts b/server/src/services/accountSocial.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8c34966ef399e1e73e660e0b85d5e3690cef4a27
--- /dev/null
+++ b/server/src/services/accountSocial.ts
@@ -0,0 +1,168 @@
+import { Context } from 'hono'
+import { getCookie, setCookie, deleteCookie } from 'hono/cookie'
+import { ClientType } from '@melody-auth/shared'
+import { errorConfig, routeConfig, typeConfig } from 'configs'
+import { appModel, userModel } from 'models'
+import * as identity from 'models/socialIdentity'
+import { jwtService, userService } from 'services'
+import { cryptoUtil } from 'utils'
+
+export const statePrefix = 'naccount-link.'
+const random = () => crypto.randomUUID().replace(/-/g, '') + crypto.randomUUID().replace(/-/g, '')
+export const digest = async (value: string) => {
+  const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(value)))
+  return btoa(String.fromCharCode(...hash)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+}
+const denied = () => new errorConfig.Forbidden('NACCOUNT_SOCIAL_REQUEST_DENIED')
+const cookieName = (provider: identity.Provider) => `__Host-naccount-link-${provider.toLowerCase()}`
+export const provider = (value: string): identity.Provider => {
+  if (value !== 'Google' && value !== 'GitHub') throw denied()
+  return value
+}
+export const available = (c: Context<typeConfig.Context>, name: identity.Provider) => name === 'Google'
+  ? !!(c.env.GOOGLE_AUTH_CLIENT_ID && c.env.GOOGLE_AUTH_CLIENT_SECRET)
+  : !!(c.env.GITHUB_AUTH_CLIENT_ID && c.env.GITHUB_AUTH_CLIENT_SECRET && c.env.GITHUB_AUTH_APP_NAME)
+
+const portalClient = async (c: Context<typeConfig.Context>, clientId: string) => {
+  if (!clientId || clientId !== c.env.NACCOUNT_PORTAL_CLIENT_ID) throw denied()
+  const app = await appModel.getByClientId(c.env.DB, clientId)
+  if (!app || !app.isActive || app.type !== ClientType.SPA || !app.redirectUris.includes(`${c.env.AUTH_SERVER_URL.replace(/\/$/, '')}/account`)) throw denied()
+}
+
+export const actor = async (c: Context<typeConfig.Context>) => {
+  // NAccount's transactional binding contract is implemented and validated for Cloudflare D1.
+  if (c.env.PG_CONNECTION_STRING) throw denied()
+  const token = c.get('access_token_body')
+  if (!token || !token.sub || !token.scope.split(' ').includes('profile')) throw denied()
+  await portalClient(c, token.azp)
+  const user = await userModel.getByAuthId(c.env.DB, token.sub)
+  if (!user || !user.isActive || user.deletedAt) throw denied()
+  return user
+}
+
+const confirmPassword = async (c: Context<typeConfig.Context>, user: userModel.Record, password: unknown) => {
+  if (!user.password || !user.email || !user.emailVerified || typeof password !== 'string' || !password || password.length > 1024) throw denied()
+  // Reuse sign-in lockout/rate limits, not an unmetered bcrypt oracle.
+  const confirmed = await userService.verifySignIn(c, user.email, (record) => record.id === user.id && !!record.password && cryptoUtil.bcryptCompare(password, record.password))
+  if (confirmed.id !== user.id) throw denied()
+}
+
+export const status = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  const linked = await identity.list(c.env.DB, user.id)
+  return c.json({
+    canManage: !!(user.password && user.emailVerified),
+    providers: (['Google', 'GitHub'] as const).map((name) => ({
+      provider: name, available: available(c, name),
+      bound: linked.some((entry) => entry.provider === name),
+      label: linked.find((entry) => entry.provider === name)?.label ?? null,
+      primary: user.socialAccountType === name,
+    })),
+  })
+}
+
+const callbackUri = (c: Context<typeConfig.Context>, name: identity.Provider) => `${c.env.AUTH_SERVER_URL.replace(/\/$/, '')}${
+  name === 'GitHub' ? routeConfig.IdentityRoute.AuthorizeGitHub : '/account/social/google/callback'
+}`
+
+export const start = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  const body = await c.req.json()
+  const name = provider(body.provider)
+  if (!available(c, name)) throw denied()
+  await confirmPassword(c, user, body.password)
+  if (user.socialAccountType === name || (await identity.list(c.env.DB, user.id)).some((entry) => entry.provider === name)) throw denied()
+  const state = statePrefix + random()
+  const verifier = random()
+  const browser = random()
+  const nonce = random()
+  await identity.saveRequest(c.env.DB, {
+    state, provider: name, userId: user.id, clientId: c.env.NACCOUNT_PORTAL_CLIENT_ID!,
+    passwordFingerprint: await digest(user.password!), browserHash: await digest(browser), verifier, nonce,
+    expiresAt: Date.now() + 300000,
+  })
+  setCookie(c, cookieName(name), browser, { httpOnly: true, secure: true, sameSite: 'Lax', path: '/', maxAge: 300 })
+  const params = new URLSearchParams({
+    client_id: name === 'Google' ? c.env.GOOGLE_AUTH_CLIENT_ID : c.env.GITHUB_AUTH_CLIENT_ID,
+    redirect_uri: callbackUri(c, name), response_type: 'code', state,
+    code_challenge: await digest(verifier), code_challenge_method: 'S256',
+    scope: name === 'Google' ? 'openid email profile' : 'read:user',
+  })
+  if (name === 'Google') { params.set('nonce', nonce); params.set('prompt', 'select_account') }
+  const base = name === 'Google' ? 'https://accounts.google.com/o/oauth2/v2/auth' : 'https://github.com/login/oauth/authorize'
+  return c.json({ authorizeUrl: `${base}?${params}` })
+}
+
+async function providerJson(url: string, init: RequestInit): Promise<Record<string, unknown>> {
+  const response = await fetch(url, { ...init, signal: AbortSignal.timeout(10000), redirect: 'error' })
+  if (!response.ok) throw denied()
+  const json = await response.json()
+  if (!json || typeof json !== 'object') throw denied()
+  return json as Record<string, unknown>
+}
+
+export const exchange = async (c: Context<typeConfig.Context>, request: identity.LinkRequest, code: string) => {
+  const google = request.provider === 'Google'
+  const response = await providerJson(google ? 'https://oauth2.googleapis.com/token' : 'https://github.com/login/oauth/access_token', {
+    method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
+    body: new URLSearchParams({
+      client_id: google ? c.env.GOOGLE_AUTH_CLIENT_ID : c.env.GITHUB_AUTH_CLIENT_ID,
+      client_secret: google ? c.env.GOOGLE_AUTH_CLIENT_SECRET! : c.env.GITHUB_AUTH_CLIENT_SECRET,
+      grant_type: 'authorization_code', code, redirect_uri: callbackUri(c, request.provider), code_verifier: request.verifier,
+    }).toString(),
+  })
+  if (google) {
+    if (typeof response.id_token !== 'string') throw denied()
+    const user = await jwtService.verifyGoogleCredential(c.env.GOOGLE_AUTH_CLIENT_ID, response.id_token, request.nonce)
+    if (!user || !user.id || !user.emailVerified) throw denied()
+    return { subject: user.id, label: user.email }
+  }
+  if (typeof response.access_token !== 'string' || !response.access_token) throw denied()
+  const user = await providerJson('https://api.github.com/user', {
+    headers: { Authorization: `Bearer ${response.access_token}`, 'User-Agent': c.env.GITHUB_AUTH_APP_NAME, Accept: 'application/vnd.github+json' },
+  })
+  if (!Number.isSafeInteger(user.id) || Number(user.id) <= 0 || typeof user.login !== 'string') throw denied()
+  return { subject: String(user.id), label: user.login }
+}
+
+export const callback = async (c: Context<typeConfig.Context>, name: identity.Provider) => {
+  c.header('Cache-Control', 'no-store')
+  c.header('Referrer-Policy', 'no-referrer')
+  const browser = getCookie(c, cookieName(name))
+  deleteCookie(c, cookieName(name), { path: '/', secure: true, httpOnly: true, sameSite: 'Lax' })
+  try {
+    const state = c.req.query('state') ?? ''
+    if (!browser || !state.startsWith(statePrefix) || c.req.queries('state')?.length !== 1) throw denied()
+    const request = await identity.consume(c.env.DB, state, name, await digest(browser))
+    // Consume atomically before any external exchange: duplicate/cancelled callbacks are not replayed.
+    if (!request || !available(c, name) || c.req.query('error') || c.req.queries('code')?.length !== 1) throw denied()
+    const code = c.req.query('code')
+    if (!code || code.length > 4096) throw denied()
+    await portalClient(c, request.clientId)
+    const getOwner = async () => {
+      const raw = await c.env.DB.prepare('SELECT * FROM "user" WHERE id=$1').bind(request.userId).first<userModel.Raw>()
+      if (!raw || raw.deletedAt || !raw.isActive || !raw.emailVerified || !raw.password || await digest(raw.password) !== request.passwordFingerprint) throw denied()
+      return raw
+    }
+    await getOwner()
+    const external = await exchange(c, request, code)
+    const owner = await getOwner()
+    await portalClient(c, request.clientId)
+    await identity.bind(c.env.DB, { provider: name, userId: request.userId, ...external }, owner.password!)
+    return c.redirect('/account?link_result=success')
+  } catch {
+    // Neither provider response bodies, credentials, codes nor SQL errors reach the user/logs.
+    return c.redirect('/account?link_result=failed')
+  }
+}
+
+export const unlink = async (c: Context<typeConfig.Context>) => {
+  const user = await actor(c)
+  const body = await c.req.json()
+  const name = provider(body.provider)
+  await confirmPassword(c, user, body.password)
+  // A confirmed usable password remains; native primary social identities are not deleted.
+  const removed = await identity.unbind(c.env.DB, name, user.id, user.password!)
+  if (!removed) throw denied()
+  return c.json({ success: true })
+}
