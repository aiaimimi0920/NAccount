diff --git a/server/src/pages/auth-theme.css b/server/src/pages/auth-theme.css
new file mode 100644
index 0000000000000000000000000000000000000000..bee875a70750bd03a40d1745ed809cb56d4c812f
--- /dev/null
+++ b/server/src/pages/auth-theme.css
@@ -0,0 +1,56 @@
+/* 独立登录、注册、MFA、授权和安全流程共用；组织显式 branding 仍由服务端注入。 */
+.naccount-auth {
+  color-scheme: var(--auth-scheme, dark);
+  --auth-panel: var(--auth-panel-color, #0e1218);
+  --auth-control: var(--auth-control-color, #111720);
+  --auth-muted: var(--auth-muted-color, #929a9f);
+  --auth-line: var(--auth-line-color, rgba(255, 255, 255, .12));
+  --auth-focus: var(--primary-button-color, #d9ff38);
+  --text-width: min(280px, calc(100vw - 68px));
+  padding: 24px 16px;
+}
+.naccount-auth .auth-card {
+  max-width: 100%;
+  background: var(--auth-panel);
+  border: 1px solid var(--auth-line);
+  border-radius: 4px;
+  border-top: 2px solid #22c55e;
+}
+.naccount-auth :is(input:not([type=checkbox]), select, textarea) {
+  color: var(--label-color);
+  background: var(--auth-control);
+  border: 1px solid var(--auth-line);
+  border-radius: 3px;
+}
+.naccount-auth input::placeholder { color: var(--auth-muted); opacity: 1; }
+.naccount-auth input[type=checkbox] { accent-color: var(--auth-focus); }
+.naccount-auth :is(button, input, select, a, textarea):focus-visible {
+  outline: 2px solid var(--auth-focus);
+  outline-offset: 3px;
+}
+.naccount-auth .bg-primaryButtonColor:hover:not(:disabled) {
+  background: color-mix(in srgb, var(--primary-button-color) 86%, white);
+}
+.naccount-auth .bg-secondaryButtonColor:hover:not(:disabled) {
+  background: color-mix(in srgb, var(--secondary-button-color) 92%, var(--secondary-button-label-color));
+}
+.naccount-auth button:disabled { opacity: .65; cursor: not-allowed; }
+.naccount-auth button { max-width: 100%; }
+.naccount-auth .code-input { width: min(42px, calc((100vw - 108px) / 6)); min-width: 0; }
+.naccount-auth a { color: var(--auth-link-color, #06b6d4); text-underline-offset: 3px; }
+.naccount-auth :is(.text-gray-500, .text-gray) { color: var(--auth-muted); }
+.naccount-auth .text-blue-500 { color: var(--auth-link-color, #06b6d4); }
+.naccount-auth .text-yellow-500 { color: var(--auth-focus); }
+.naccount-auth .text-green-500 { color: #22c55e; }
+.naccount-auth :is(.text-criticalIndicatorColor, .text-red-500) { color: var(--critical-indicator-color); }
+.naccount-auth .bg-criticalIndicatorColor {
+  color: var(--label-color);
+  background: color-mix(in srgb, var(--critical-indicator-color) 12%, var(--auth-panel));
+  border: 1px solid var(--critical-indicator-color);
+}
+@media (max-width: 480px) {
+  .naccount-auth .auth-card > section { padding: 24px 16px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .naccount-auth * { transition: none; animation: none; scroll-behavior: auto; }
+}
