diff --git a/server/src/services/jwtSigning.test.ts b/server/src/services/jwtSigning.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..04f868e36c944853eeccb3ecbe5b20ec96f04a6d
--- /dev/null
+++ b/server/src/services/jwtSigning.test.ts
@@ -0,0 +1,100 @@
+import { generateKeyPairSync } from 'node:crypto'
+import { Hono } from 'hono'
+import { decode, verify } from 'hono/jwt'
+import { afterEach, beforeAll, describe, expect, test, vi } from 'vitest'
+import { typeConfig } from 'configs'
+import { kvService } from 'services'
+import { cryptoUtil } from 'utils'
+import { signWithKid } from './jwt'
+import { getJwks } from 'handlers/other'
+
+const pair = () => generateKeyPairSync('rsa', {
+  modulusLength: 2048,
+  privateKeyEncoding: { type: 'pkcs8', format: 'pem' },
+  publicKeyEncoding: { type: 'spki', format: 'pem' },
+})
+let first: ReturnType<typeof pair>
+let second: ReturnType<typeof pair>
+beforeAll(() => { first = pair(); second = pair() })
+afterEach(() => vi.restoreAllMocks())
+
+describe('request-local signing material', () => {
+  test('shares one load/import for concurrent and sequential token signatures', async () => {
+    const privateRead = vi.spyOn(kvService, 'getJwtPrivateSecret').mockResolvedValue(first.privateKey)
+    const publicRead = vi.spyOn(kvService, 'getJwtPublicSecret').mockResolvedValue(first.publicKey)
+    const importKey = vi.spyOn(crypto.subtle, 'importKey')
+    const router = new Hono<typeConfig.Context>().get('/', async (c) => {
+      const tokens = await Promise.all([signWithKid(c, { sub: 'access' }), signWithKid(c, { sub: 'id' })])
+      tokens.push(await signWithKid(c, { sub: 'third' }))
+      return c.json(tokens)
+    })
+    const tokens = await (await router.request('/')).json() as string[]
+    expect(privateRead).toHaveBeenCalledTimes(1)
+    expect(publicRead).toHaveBeenCalledTimes(1)
+    expect(importKey.mock.calls.filter(([format]) => format === 'pkcs8')).toHaveLength(1)
+    expect(importKey.mock.calls.filter(([format]) => format === 'spki')).toHaveLength(1)
+    expect(new Set(tokens.map((token) => (decode(token).header as { kid?: string }).kid)).size).toBe(1)
+    for (const [index, token] of tokens.entries()) {
+      expect((await verify(token, first.publicKey, 'RS256')).sub).toBe(['access', 'id', 'third'][index])
+    }
+  })
+
+  test('a subsequent request reads rotated material, not a module-level cache', async () => {
+    const privateRead = vi.spyOn(kvService, 'getJwtPrivateSecret').mockResolvedValueOnce(first.privateKey).mockResolvedValueOnce(second.privateKey)
+    vi.spyOn(kvService, 'getJwtPublicSecret').mockResolvedValueOnce(first.publicKey).mockResolvedValueOnce(second.publicKey)
+    const router = new Hono<typeConfig.Context>().get('/', async (c) => c.text(await signWithKid(c, { sub: 'user' })))
+    const before = await (await router.request('/')).text()
+    const after = await (await router.request('/')).text()
+    expect(privateRead).toHaveBeenCalledTimes(2)
+    expect(decode(before).header).not.toEqual(decode(after).header)
+    expect((await verify(after, second.publicKey, 'RS256')).sub).toBe('user')
+    await expect(verify(after, first.publicKey, 'RS256')).rejects.toThrow()
+  })
+
+  test('does not retry a failed load within a request; the next request can recover', async () => {
+    const read = vi.spyOn(kvService, 'getJwtPrivateSecret').mockRejectedValueOnce(new Error('unavailable')).mockResolvedValueOnce(first.privateKey)
+    vi.spyOn(kvService, 'getJwtPublicSecret').mockResolvedValue(first.publicKey)
+    const router = new Hono<typeConfig.Context>().get('/', async (c) => {
+      const results = await Promise.allSettled([signWithKid(c, {}), signWithKid(c, {})])
+      return c.json(results.map((r) => r.status))
+    })
+    expect(await (await router.request('/')).json()).toEqual(['rejected', 'rejected'])
+    expect(read).toHaveBeenCalledTimes(1)
+    expect(await (await router.request('/')).json()).toEqual(['fulfilled', 'fulfilled'])
+    expect(read).toHaveBeenCalledTimes(2)
+  })
+
+  test('starts both signing key reads before either completes', async () => {
+    let release!: (value: string) => void
+    const pending = new Promise<string>((resolve) => { release = resolve })
+    vi.spyOn(kvService, 'getJwtPrivateSecret').mockReturnValue(pending)
+    const publicRead = vi.spyOn(kvService, 'getJwtPublicSecret').mockResolvedValue(first.publicKey)
+    const router = new Hono<typeConfig.Context>().get('/', async (c) => c.text(await signWithKid(c, {})))
+    const response = router.request('/')
+    try { await vi.waitFor(() => expect(publicRead).toHaveBeenCalledTimes(1)) }
+    finally { release(first.privateKey) }
+    expect((await response).status).toBe(200)
+  })
+})
+
+describe('JWKS parallel reads without caching', () => {
+  test('starts deprecated lookup before current resolves and preserves current-first ordering', async () => {
+    let release!: (value: string) => void
+    const pending = new Promise<string>((resolve) => { release = resolve })
+    vi.spyOn(kvService, 'getJwtPublicSecret').mockReturnValue(pending)
+    const deprecated = vi.spyOn(kvService, 'getDeprecatedPublicSecret').mockResolvedValue(second.publicKey)
+    const router = new Hono<typeConfig.Context>().get('/', getJwks)
+    const response = router.request('/', {}, {} as typeConfig.Bindings)
+    try { await vi.waitFor(() => expect(deprecated).toHaveBeenCalledTimes(1)) }
+    finally { release(first.publicKey) }
+    expect(await (await response).json()).toEqual({ keys: [await cryptoUtil.secretToJwk(first.publicKey), await cryptoUtil.secretToJwk(second.publicKey)] })
+  })
+
+  test('works without a deprecated key and does not accept a missing current key', async () => {
+    vi.spyOn(kvService, 'getJwtPublicSecret').mockResolvedValueOnce(first.publicKey).mockRejectedValueOnce(new Error('missing key'))
+    vi.spyOn(kvService, 'getDeprecatedPublicSecret').mockResolvedValue(null)
+    const router = new Hono<typeConfig.Context>().get('/', getJwks)
+    expect(await (await router.request('/', {}, {} as typeConfig.Bindings)).json()).toEqual({ keys: [await cryptoUtil.secretToJwk(first.publicKey)] })
+    expect((await router.request('/', {}, {} as typeConfig.Bindings)).status).toBe(500)
+  })
+})
