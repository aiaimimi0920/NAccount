+import { afterEach, expect, test } from 'vitest'
+import { getLocaleFromParams } from './param'
+import { AuthRuntime } from './authRuntime'
+
+afterEach(() => {
+  document.documentElement.lang = ''
+  window.history.replaceState({}, '', '/')
+})
+
+test.each(['', '?locale=invalid', '?locale=zh-CN'])('uses the server-negotiated document locale for %s', (query) => {
+  document.documentElement.lang = 'zh'
+  window.history.replaceState({}, '', `/login${query}`)
+  expect(getLocaleFromParams()).toBe('zh')
+})
+
+test('a dialog uses its runtime locale instead of the host document', () => {
+  document.documentElement.lang = 'zh'
+  const runtime = { url: new URL('https://example.com/login?locale=fr') } as AuthRuntime
+  expect(getLocaleFromParams(runtime)).toBe('fr')
+})
+
+test('unknown query locale fails back to a supported language, not undefined strings', () => {
+  window.history.replaceState({}, '', '/login?locale=invalid')
+  expect(getLocaleFromParams()).toBe('en')
+})
