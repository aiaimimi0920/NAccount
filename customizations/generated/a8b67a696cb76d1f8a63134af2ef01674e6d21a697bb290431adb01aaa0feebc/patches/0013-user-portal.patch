diff --git a/server/src/__tests__/normal/hosted-login.test.ts b/server/src/__tests__/normal/hosted-login.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1fd06957caf64ea210b0bdf2701c52de32a3131d
--- /dev/null
+++ b/server/src/__tests__/normal/hosted-login.test.ts
@@ -0,0 +1,185 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest'
+import type { Database } from 'better-sqlite3'
+import app from 'index'
+import { appService, brandingService, kvService, scopeService, sessionService } from 'services'
+import { migrate, mock, mockedKV, sessionStore } from 'tests/mock'
+import { getApp, getAuthorizeParams, insertUsers, postSignInRequest } from 'tests/identity'
+import { routeConfig } from 'configs'
+import { decode, verify } from 'hono/jwt'
+
+let db: Database
+beforeEach(async () => { db = await migrate() })
+afterEach(async () => {
+  vi.restoreAllMocks()
+  await db.close()
+  await mockedKV.empty()
+  Object.keys(sessionStore).forEach((key) => delete sessionStore[key])
+})
+
+const login = async (change?: (params: URLSearchParams) => void, json = false) => {
+  const params = new URLSearchParams(await getAuthorizeParams(await getApp(db)))
+  change?.(params)
+  return app.request(`/login?${params}`, json ? { headers: { Accept: 'application/json' } } : {}, mock(db))
+}
+
+describe('shared hosted login panel', () => {
+  test('renders in one response with one validated client/scope/branding read', async () => {
+    const client = vi.spyOn(appService, 'verifySPAClientRequest')
+    const scopes = vi.spyOn(scopeService, 'verifyAppScopes')
+    const branding = vi.spyOn(brandingService, 'getBranding')
+    const session = vi.spyOn(sessionService, 'getAuthInfoSession')
+    const res = await login()
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Location')).toBeNull()
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
+    expect(res.headers.get('Referrer-Policy')).toBe('no-referrer')
+    const html = await res.text()
+    expect(html).toContain('appName: "Admin Panel (SPA)"')
+    expect(html).toContain('redirectOrigin: "http://localhost:3000"')
+    expect(html).not.toContain('fonts.googleapis.com')
+    expect(html).not.toContain('fonts.gstatic.com')
+    expect(client).toHaveBeenCalledTimes(1)
+    expect(scopes).toHaveBeenCalledTimes(1)
+    expect(branding).toHaveBeenCalledTimes(1)
+    expect(session).toHaveBeenCalledTimes(1)
+  })
+
+  test('JSON configuration has the same trusted application context', async () => {
+    const res = await login((p) => p.set('appName', 'UNTRUSTED'), true)
+    expect(res.status).toBe(200)
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
+    const body = await res.json() as { initialProps: Record<string, unknown> }
+    expect(body.initialProps.appName).toBe('Admin Panel (SPA)')
+    expect(body.initialProps.redirectOrigin).toBe('http://localhost:3000')
+    expect(body.initialProps).not.toHaveProperty('clientSecret')
+  })
+
+  test.each(['client_id', 'redirect_uri', 'code_challenge_method', 'response_type', 'state', 'code_challenge'])(
+    'rejects invalid %s before rendering', async (field) => {
+      const res = await login((p) => p.set(field, field === 'state' || field === 'code_challenge' ? '' : 'invalid'))
+      expect(res.status).toBeGreaterThanOrEqual(400)
+      expect(await res.text()).not.toContain('window.__initialProps')
+    },
+  )
+
+  test('rejects a disabled application', async () => {
+    await db.prepare('UPDATE app SET "isActive" = 0 WHERE id = 1').run()
+    expect((await login()).status).toBeGreaterThanOrEqual(400)
+  })
+
+  test('application metadata cannot terminate the initial-props script', async () => {
+    await db.prepare('UPDATE app SET name = ? WHERE id = 1').run('</script><img src=x onerror=alert(1)>')
+    const html = await (await login()).text()
+    expect(html).toContain('appName: "\\u003c/script>\\u003cimg')
+    expect(html).not.toContain('</script><img src=x')
+  })
+
+  test('preserves custom organization fonts rather than overwriting branding', async () => {
+    const original = brandingService.getBranding
+    vi.spyOn(brandingService, 'getBranding').mockImplementation(async (...args) => ({
+      ...await original(...args), fontFamily: 'Custom', fontUrl: 'https://example.com/font.css',
+    }))
+    expect(await (await login()).text()).toContain('<link href="https://example.com/font.css" rel="stylesheet"/>')
+  })
+
+  test.each([
+    ['/callback', ''],
+    ['myapp://callback', 'myapp:'],
+    ['https://app.example.com/callback?source=desktop', 'https://app.example.com'],
+  ])('display metadata does not reject registered callback %s', async (redirect, origin) => {
+    await db.prepare('UPDATE app SET "redirectUris" = ? WHERE id = 1').run(redirect)
+    const res = await login((p) => p.set('redirect_uri', redirect), true)
+    expect(res.status).toBe(200)
+    const body = await res.json() as { initialProps: Record<string, unknown> }
+    expect(body.initialProps.redirectOrigin).toBe(origin)
+  })
+
+  test('keeps the existing OIDC authorize redirect contract', async () => {
+    const params = await getAuthorizeParams(await getApp(db))
+    const res = await app.request(`${routeConfig.OauthRoute.Authorize}${params}`, {}, mock(db))
+    expect(res.status).toBe(302)
+    expect(res.headers.get('Location')).toBe(`${routeConfig.IdentityRoute.AuthorizeView}${params}`)
+  })
+
+  test('external provider policies still leave through the original handler', async () => {
+    const previous = process.env.ENABLE_SAML_SSO_AS_SP
+    try {
+      process.env.ENABLE_SAML_SSO_AS_SP = true as unknown as string
+      const res = await login((p) => p.set('policy', 'saml_sso_test'))
+      expect(res.status).toBe(302)
+      expect(res.headers.get('Location')).toContain(`${routeConfig.InternalRoute.SamlSp}/login?`)
+    } finally { process.env.ENABLE_SAML_SSO_AS_SP = previous }
+  })
+
+  test('reuses a valid SSO session and issues verifiable access/ID tokens with one key load', async () => {
+    const previous = process.env.ENFORCE_ONE_MFA_ENROLLMENT
+    try {
+      process.env.ENFORCE_ONE_MFA_ENROLLMENT = [] as unknown as string
+      insertUsers(db)
+      expect((await postSignInRequest(db, await getApp(db))).status).toBe(200)
+      const res = await login()
+      expect(res.status).toBe(302)
+      const callback = new URL(res.headers.get('Location')!)
+      expect(callback.origin).toBe('http://localhost:3000')
+      expect(callback.searchParams.get('state')).toBe('123')
+      const privateRead = vi.spyOn(kvService, 'getJwtPrivateSecret')
+      const publicRead = vi.spyOn(kvService, 'getJwtPublicSecret')
+      const tokenRes = await app.request(routeConfig.OauthRoute.Token, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+        body: new URLSearchParams({ grant_type: 'authorization_code', code: callback.searchParams.get('code')!, code_verifier: 'abc' }),
+      }, mock(db))
+      expect(tokenRes.status).toBe(200)
+      const tokens = await tokenRes.json() as { access_token: string; id_token: string }
+      expect(privateRead).toHaveBeenCalledTimes(1)
+      expect(publicRead).toHaveBeenCalledTimes(1)
+      const publicKey = await publicRead.mock.results[0].value
+      expect((await verify(tokens.access_token, publicKey, 'RS256')).sub).toBe('1-1-1-1')
+      expect((await verify(tokens.id_token, publicKey, 'RS256')).sub).toBe('1-1-1-1')
+      expect(decode(tokens.access_token).header).toEqual(decode(tokens.id_token).header)
+    } finally { process.env.ENFORCE_ONE_MFA_ENROLLMENT = previous }
+  })
+
+  test.each(['signup', 'reset'])('explicit screen=%s does not silently use SSO', async (screen) => {
+    const previous = process.env.ENFORCE_ONE_MFA_ENROLLMENT
+    try {
+      process.env.ENFORCE_ONE_MFA_ENROLLMENT = [] as unknown as string
+      insertUsers(db)
+      await postSignInRequest(db, await getApp(db))
+      expect((await login()).status).toBe(302)
+      const res = await login((p) => p.set('screen', screen))
+      expect(res.status).toBe(200)
+      expect(res.headers.get('Location')).toBeNull()
+    } finally { process.env.ENFORCE_ONE_MFA_ENROLLMENT = previous }
+  })
+
+  test('a revoked session cannot skip the panel', async () => {
+    const previous = process.env.ENFORCE_ONE_MFA_ENROLLMENT
+    try {
+      process.env.ENFORCE_ONE_MFA_ENROLLMENT = [] as unknown as string
+      insertUsers(db)
+      await postSignInRequest(db, await getApp(db))
+      await db.prepare('UPDATE "user" SET "securityVersion" = "securityVersion" + 1').run()
+      expect((await login()).status).toBe(200)
+    } finally { process.env.ENFORCE_ONE_MFA_ENROLLMENT = previous }
+  })
+
+  test('SSO preserves registered callback query and round-trips encoded state', async () => {
+    const previous = process.env.ENFORCE_ONE_MFA_ENROLLMENT
+    try {
+      process.env.ENFORCE_ONE_MFA_ENROLLMENT = [] as unknown as string
+      insertUsers(db)
+      await postSignInRequest(db, await getApp(db))
+      const redirect = 'http://localhost:3000/en/dashboard?source=desktop'
+      await db.prepare('UPDATE app SET "redirectUris" = ? WHERE id = 1').run(redirect)
+      const state = 'nonce+with&reserved=#and?marks'
+      const res = await login((p) => { p.set('redirect_uri', redirect); p.set('state', state) })
+      expect(res.status).toBe(302)
+      const callback = new URL(res.headers.get('Location')!)
+      expect(callback.searchParams.get('source')).toBe('desktop')
+      expect(callback.searchParams.getAll('state')).toEqual([state])
+      expect(callback.searchParams.getAll('code')).toHaveLength(1)
+      expect(callback.hash).toBe('')
+    } finally { process.env.ENFORCE_ONE_MFA_ENROLLMENT = previous }
+  })
+})
