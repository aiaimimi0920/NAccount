+const negotiatePortalLocale = (c: { req: { query: (k: string) => string | undefined; header: (k: string) => string | undefined } }): 'en' | 'zh' => {
+  const explicit = c.req.query('locale')?.toLowerCase()
+  if (explicit?.startsWith('en')) return 'en'
+  if (explicit?.startsWith('zh')) return 'zh'
+  const accept = c.req.header('Accept-Language') ?? ''
+  if (!accept) return 'zh'
+  const firstTag = accept.split(',')[0]?.trim().toLowerCase() ?? ''
+  return firstTag.startsWith('en') ? 'en' : 'zh'
+}
+
+account.get('/account', (c) => {
+  const lang = negotiatePortalLocale(c)
+  return c.html(
