+const PBKDF2_PREFIX = '$pbkdf2-sha256$'
+const PBKDF2_ITERATIONS = 100000
+
+const constantTimeEqual = (a: string, b: string): boolean => {
+  if (a.length !== b.length) return false
+  let diff = 0
+  for (let i = 0; i < a.length; i++) {
+    diff |= a.charCodeAt(i) ^ b.charCodeAt(i)
+  }
+  return diff === 0
+}
+
+const toBase64Url = (bytes: Uint8Array): string => {
+  return uint8ArrayToBase64(bytes)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '')
+}
+
+const fromBase64Url = (value: string): Uint8Array => {
+  const padded = value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - (value.length % 4)) % 4)
+  return base64ToUint8Array(padded)
+}
+
+export const isLegacyPasswordHash = (hash: string | null | undefined): boolean => {
+  return typeof hash === 'string' && hash.startsWith('$2')
+}
+
+export const hashPassword = async (text: string): Promise<string> => {
+  const salt = genRandomBytes(16)
+  const baseKey = await crypto.subtle.importKey(
+    'raw',
+    new TextEncoder().encode(text),
+    'PBKDF2',
+    false,
+    ['deriveBits'],
+  )
+  const derived = await crypto.subtle.deriveBits(
+    {
+      name: 'PBKDF2',
+      hash: 'SHA-256',
+      salt,
+      iterations: PBKDF2_ITERATIONS,
+    },
+    baseKey,
+    256,
+  )
+  return `${PBKDF2_PREFIX}${PBKDF2_ITERATIONS}$${toBase64Url(salt)}$${toBase64Url(new Uint8Array(derived))}`
+}
+
+export const verifyPassword = async (
+  text: string,
+  storedHash: string,
+): Promise<boolean> => {
+  if (!text || !storedHash) return false
+  if (storedHash.startsWith(PBKDF2_PREFIX)) {
+    const parts = storedHash.slice(PBKDF2_PREFIX.length).split('$')
+    if (parts.length !== 3) return false
+    const iterations = Number(parts[0])
+    if (!Number.isSafeInteger(iterations) || iterations < 10000 || iterations > 1000000) return false
+    try {
+      const salt = fromBase64Url(parts[1])
+      const baseKey = await crypto.subtle.importKey(
+        'raw',
+        new TextEncoder().encode(text),
+        'PBKDF2',
+        false,
+        ['deriveBits'],
+      )
+      const derived = await crypto.subtle.deriveBits(
+        {
+          name: 'PBKDF2',
+          hash: 'SHA-256',
+          salt,
+          iterations,
+        },
+        baseKey,
+        256,
+      )
+      return constantTimeEqual(toBase64Url(new Uint8Array(derived)), parts[2])
+    } catch {
+      return false
+    }
+  }
+  return bcryptCompare(text, storedHash)
+}
