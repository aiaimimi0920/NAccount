+export type PortalLocale = 'zh' | 'en'
+
+const LOCALE_STORAGE_KEY = 'naccount.portal.locale'
+
+export function resolvePortalLocale(raw?: string | null): PortalLocale {
+  const normalized = (raw ?? '').trim().toLowerCase()
+  if (normalized.startsWith('en')) return 'en'
+  return 'zh'
+}
+
+export function getPortalCopy(locale: PortalLocale) {
+  return portalText[locale]
+}
+
+export function detectPortalLocale(): PortalLocale {
+  try {
+    const query = new URLSearchParams(window.location.search).get('locale')?.toLowerCase()
+    if (query?.startsWith('en')) return 'en'
+    if (query?.startsWith('zh')) return 'zh'
+    const saved = localStorage.getItem(LOCALE_STORAGE_KEY)
+    if (saved === 'en' || saved === 'zh') return saved
+    const docLang = document.documentElement.lang?.toLowerCase() ?? ''
+    if (docLang.startsWith('en')) return 'en'
+    if (docLang.startsWith('zh')) return 'zh'
+  } catch { /* Safe fallback in restricted test DOM environments. */ }
+  return 'zh'
+}
+
+export function persistPortalLocale(locale: PortalLocale): void {
+  try {
+    localStorage.setItem(LOCALE_STORAGE_KEY, locale)
+    document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en'
+  } catch { /* Ignore storage restrictions. */ }
+}
