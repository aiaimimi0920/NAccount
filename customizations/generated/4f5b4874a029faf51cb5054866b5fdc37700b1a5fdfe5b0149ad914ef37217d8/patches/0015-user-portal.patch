@@ -0,0 +1,98 @@
+import { useEffect, useState } from 'hono/jsx'
+import Dialog from './Dialog'
+import * as auth from './auth'
+import { PortalLocale, portalText } from './i18n'
+
+export interface ActiveSessionItem {
+  sessionId: string;
+  clientId: string;
+  appName: string;
+  createdAt: number;
+  expiresAt: number;
+}
+
+export default function SessionsDialog({ accessToken, locale = 'zh', onClose, onRevokedCurrent }: {
+  accessToken: string;
+  locale?: PortalLocale;
+  onClose: () => void;
+  onRevokedCurrent: () => void;
+}) {
+  const t = portalText[locale].sessions
+  const [sessions, setSessions] = useState<ActiveSessionItem[] | null>(null)
+  const [busy, setBusy] = useState(false)
+  const [error, setError] = useState('')
+
+  useEffect(() => {
+    let stale = false
+    const controller = new AbortController()
+    setError('')
+    void auth.request<{ sessions: ActiveSessionItem[] }>('/account/api/sessions', {
+      headers: { Authorization: 'Bearer ' + accessToken },
+      signal: controller.signal,
+    })
+      .then((res) => { if (!stale) setSessions(res.sessions) })
+      .catch(() => { if (!stale) setError(t.loadError) })
+    return () => { stale = true; controller.abort() }
+  }, [accessToken, locale])
+
+  const formatTime = (epochSeconds: number) => {
+    try {
+      return new Date(epochSeconds * 1000).toLocaleString(locale === 'zh' ? 'zh-CN' : 'en-US', {
+        month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
+      })
+    } catch { return String(epochSeconds) }
+  }
+
+  const revokeOne = async (sessionId: string) => {
+    if (busy) return
+    setBusy(true); setError('')
+    try {
+      await auth.request(`/account/api/sessions/${encodeURIComponent(sessionId)}`, {
+        method: 'DELETE',
+        headers: { Authorization: 'Bearer ' + accessToken },
+      })
+      setSessions((prev) => prev ? prev.filter((item) => item.sessionId !== sessionId) : prev)
+    } catch {
+      setError(t.loadError)
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  const revokeAll = async () => {
+    if (busy) return
+    setBusy(true); setError('')
+    try {
+      await auth.request('/account/api/sessions', {
+        method: 'DELETE',
+        headers: { Authorization: 'Bearer ' + accessToken },
+      })
+      auth.clearSession()
+      onRevokedCurrent()
+    } catch {
+      setError(t.loadError)
+      setBusy(false)
+    }
+  }
+
+  return <Dialog title={t.title} locale={locale} busy={busy} onClose={onClose}>
+    {error && <p role='alert' class='error-inline'>{error}</p>}
+    {!sessions ? !error && <p role='status'>{t.loading}</p> : !sessions.length ? <p class='muted'>{t.empty}</p> : (
+      <ul class='session-list'>
+        {sessions.map((item) => (
+          <li key={item.sessionId} class='session-row'>
+            <div class='session-meta'>
+              <strong>{item.appName || item.clientId}</strong>
+              <span class='muted'>{t.issuedAt}: {formatTime(item.createdAt)} · {t.expiresAt}: {formatTime(item.expiresAt)}</span>
+            </div>
+            <button type='button' class='btn danger' disabled={busy} onClick={() => { void revokeOne(item.sessionId) }}>{t.revokeOne}</button>
+          </li>
+        ))}
+      </ul>
+    )}
+    <div class='form-actions'>
+      {!!sessions?.length && <button type='button' class='btn danger' disabled={busy} onClick={() => { void revokeAll() }}>{t.revokeAll}</button>}
+      <button type='button' class='btn' disabled={busy} onClick={onClose}>{t.close}</button>
+    </div>
+  </Dialog>
+}
