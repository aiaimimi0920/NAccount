new file mode 100644
index 0000000000000000000000000000000000000000..2bc34d4015efb367150379b6b18de89907b79ec2
--- /dev/null
+++ b/server/src/__tests__/normal/naccount-optimizations.test.ts
@@ -0,0 +1,625 @@
+import {
+  afterEach, beforeEach, describe, expect, it, vi,
+} from 'vitest'
+import { Context } from 'hono'
+import { decode } from 'hono/jwt'
+import { Database } from 'better-sqlite3'
+import { ClientType } from '@melody-auth/shared'
+import app from 'index'
+import account from 'routes/account'
+import {
+  migrate, mock, mockedKV, sessionStore,
+} from 'tests/mock'
+import {
+  adapterConfig, messageConfig, routeConfig, typeConfig,
+} from 'configs'
+import { oauthDto } from 'dtos'
+import {
+  emailService, jwtService, kvService, smsService, userService,
+} from 'services'
+import { cryptoUtil, timeUtil } from 'utils'
+import { EmailVerificationTemplate } from 'templates'
+import { getPortalCopy, resolvePortalLocale } from 'pages/account/i18n'
+
+let db: Database
+
+beforeEach(async () => {
+  db = await migrate()
+})
+
+afterEach(() => {
+  db.close()
+  mockedKV.empty()
+  vi.restoreAllMocks()
+})
+
+describe('NAccount P0-P3 end-to-end optimizations', () => {
+  it('serves stateless /favicon.svg and /favicon.ico even when KV secrets are absent', async () => {
+    const originalGet = mockedKV.get
+    mockedKV.get = () => Promise.resolve(null)
+    try {
+      const svgRes = await app.request('/favicon.svg', {}, mock(db))
+      expect(svgRes.status).toBe(200)
+      expect(svgRes.headers.get('content-type')).toContain('image/svg+xml')
+      expect(await svgRes.text()).toContain('<svg')
+
+      const icoRes = await app.request('/favicon.ico', {}, mock(db))
+      expect(icoRes.status).toBe(200)
+      expect(icoRes.headers.get('content-type')).toContain('image/svg+xml')
+    } finally {
+      mockedKV.get = originalGet
+    }
+  })
+
+  it('omits empty emailLogoUrl <img> tag and applies dynamic html lang and NAccount brand', () => {
+    const html = String(EmailVerificationTemplate({
+      serverUrl: 'https://auth.example.test',
+      branding: {
+        emailLogoUrl: '',
+      },
+      verificationCode: '123456',
+      authId: 'user-1',
+      org: '',
+      locale: 'zh',
+    }))
+    expect(html).toContain('lang="zh"')
+    expect(html).not.toContain('<img')
+    expect(html).toContain('NAccount')
+  })
+
+  it('bumps securityVersion on password reset, policy mutations, and admin user deactivation', async () => {
+    const legacyHash = cryptoUtil.bcryptText('InitialPass1!')
+    db.prepare('INSERT INTO "user"(authId, email, password, emailVerified, otpSecret) VALUES(?, ?, ?, 1, ?)').run(
+      'sec-user',
+      'sec@example.test',
+      legacyHash,
+      'JBSWY3DPEHPK3PXP',
+    )
+    const env = { ...process.env, ...mock(db) } as unknown as typeConfig.Bindings
+    const c = new Context<typeConfig.Context>(new Request('http://localhost:8787'), { env })
+
+    const oldToken = (await jwtService.genAccessToken(
+      c,
+      ClientType.SPA,
+      timeUtil.getCurrentTimestamp(),
+      'sec-user',
+      'spa-client',
+      'openid profile',
+    )).accessToken
+
+    const secUser = (await userService.getUserByAuthId(c, 'sec-user'))!
+    await kvService.storePasswordResetCode(c.env.KV, secUser.id, '654321')
+    await userService.resetUserPassword(c, {
+      email: 'sec@example.test',
+      password: 'NewPassword2!',
+      code: '654321',
+    } as never)
+
+    const afterReset = db.prepare('SELECT password, securityVersion FROM "user" WHERE authId=?').get('sec-user') as {
+      password: string; securityVersion: number;
+    }
+    expect(afterReset.securityVersion).toBe(1)
+    expect(afterReset.password.startsWith('$pbkdf2-sha256$')).toBe(true)
+    await expect(jwtService.getAccessTokenBody(c, oldToken)).rejects.toThrow('ACCOUNT_SESSION_REVOKED')
+
+    await userService.changeUserPassword(c, (await userService.getUserByAuthId(c, 'sec-user'))!, {
+      password: 'NewPassword3!',
+    } as never)
+    expect((db.prepare('SELECT securityVersion FROM "user" WHERE authId=?').get('sec-user') as { securityVersion: number }).securityVersion).toBe(2)
+
+    await kvService.storeChangeEmailCode(c.env.KV, secUser.id, 'sec2@example.test', '112233')
+    await userService.changeUserEmail(c, (await userService.getUserByAuthId(c, 'sec-user'))!, {
+      email: 'sec2@example.test',
+      verificationCode: '112233',
+    } as never)
+    expect((db.prepare('SELECT securityVersion FROM "user" WHERE authId=?').get('sec-user') as { securityVersion: number }).securityVersion).toBe(3)
+
+    await userService.resetUserMfa(c, 'sec-user')
+    expect((db.prepare('SELECT securityVersion FROM "user" WHERE authId=?').get('sec-user') as { securityVersion: number }).securityVersion).toBe(4)
+
+    await userService.updateUser(c, 'sec-user', { isActive: false } as never)
+    expect((db.prepare('SELECT securityVersion FROM "user" WHERE authId=?').get('sec-user') as { securityVersion: number }).securityVersion).toBe(5)
+  })
+
+  it('transparently upgrades legacy bcrypt password hash to PBKDF2-SHA256 on sign-in and blocks deleted social tombstones cleanly', async () => {
+    const legacyHash = '$2a$10$/KBURsxnGm5OClLQFPNwZ.HcaM27Gogp/mA1xRxfEbY3bs0cuu8Fm'
+    db.prepare('INSERT INTO "user"(authId, email, password, emailVerified, otpSecret) VALUES(?, ?, ?, 1, ?)').run(
+      'upgrade-user',
+      'upgrade@example.test',
+      legacyHash,
+      '',
+    )
+    const env = { ...process.env, ...mock(db) } as unknown as typeConfig.Bindings
+    const c = new Context<typeConfig.Context>(new Request('http://localhost:8787'), { env })
+
+    const signedIn = await userService.verifyPasswordSignIn(c, {
+      email: 'upgrade@example.test',
+      password: 'Password1!',
+    } as never)
+    expect(signedIn.authId).toBe('upgrade-user')
+
+    const upgradedRow = db.prepare('SELECT password, securityVersion FROM "user" WHERE authId=?').get('upgrade-user') as {
+      password: string; securityVersion: number;
+    }
+    expect(upgradedRow.password.startsWith('$pbkdf2-sha256$')).toBe(true)
+    expect(await cryptoUtil.verifyPassword('Password1!', upgradedRow.password)).toBe(true)
+    expect(upgradedRow.securityVersion).toBe(0)
+
+    // Deleted primary social user re-login must return 403 UserDisabled rather than 500 UNIQUE constraint error.
+    db.prepare(
+      'INSERT INTO "user"(authId, socialAccountId, socialAccountType, isActive, deletedAt, otpSecret) VALUES(?, ?, ?, 0, CURRENT_TIMESTAMP, ?)',
+    ).run('deleted-google', 'google-sub-999', 'Google', '')
+
+    await expect(userService.processGoogleAccount(c, {
+      id: 'google-sub-999',
+      email: 'relogin@example.test',
+      emailVerified: true,
+      firstName: 'Gone',
+      lastName: 'User',
+    }, 'en')).rejects.toThrow(messageConfig.RequestError.UserDisabled)
+
+    // Admin deleteUser cleans naccount_profile and blanks social identity label.
+    db.prepare('INSERT INTO naccount_profile(userId, nickname, phone) SELECT id, ?, ? FROM "user" WHERE authId=?')
+      .run('Upgraded', '+12025550199', 'upgrade-user')
+    db.prepare('INSERT INTO naccount_social_identity(provider, subject, userId, label) SELECT ?, ?, id, ? FROM "user" WHERE authId=?')
+      .run('GitHub', 'gh-upgrade', 'gh-label', 'upgrade-user')
+
+    await userService.deleteUser(c, 'upgrade-user')
+    expect(db.prepare('SELECT * FROM naccount_profile WHERE phone=?').get('+12025550199')).toBeUndefined()
+    expect(db.prepare('SELECT label FROM naccount_social_identity WHERE subject=?').get('gh-upgrade')).toEqual({ label: '' })
+  })
+
+  it('projects sub and naccount_profile claims on GET/POST userinfo and id_token, and validates token client_id/redirect_uri & case-sensitive redirect paths', async () => {
+    const pwHash = await cryptoUtil.hashPassword('Password1!')
+    db.prepare('INSERT INTO "user"(authId, email, password, emailVerified, otpSecret) VALUES(?, ?, ?, 1, ?)').run(
+      'oidc-user',
+      'oidc@example.test',
+      pwHash,
+      '',
