+        expect(authProviderProps?.onLoginSuccess).toBeTypeOf('function')
+
+        authProviderProps?.onLoginSuccess?.({ locale: 'fr' })
+        expect(mockPush).not.toHaveBeenCalled()
+
+        authProviderProps?.onLoginSuccess?.({ locale: 'en' })
+        expect(mockPush).not.toHaveBeenCalled()
+
+        authProviderProps?.onLoginSuccess?.({ locale: 'zh' })
+        expect(mockPush).toHaveBeenCalledWith('/zh/dashboard')
+      },
+    )
+
+    it(
+      'renders inline SVG brand logo without valuemelody.com request by default and uses COMPANY_LOGO_URL when provided',
+      async () => {
+        mockSendNextRequest.mockResolvedValueOnce({ configs: {} })
+        const {
+          container, unmount,
+        } = render(<NextIntlClientProvider
+          locale='en'
+          messages={{}}><Setup>Loaded default logo</Setup></NextIntlClientProvider>)
+
+        expect(await screen.findByText('Loaded default logo')).toBeInTheDocument()
+        expect(screen.getByTestId('brandLogoSvg')).toBeInTheDocument()
+        expect(container.querySelectorAll('img')).toHaveLength(0)
+        expect(container.innerHTML).not.toContain('valuemelody.com')
+
+        unmount()
+
+        mockSendNextRequest.mockResolvedValueOnce({ configs: { COMPANY_LOGO_URL: '/custom-brand.svg' } })
+        const customRender = render(<NextIntlClientProvider
+          locale='en'
+          messages={{}}><Setup>Loaded custom logo</Setup></NextIntlClientProvider>)
+
+        expect(await screen.findByText('Loaded custom logo')).toBeInTheDocument()
+        expect(screen.queryByTestId('brandLogoSvg')).not.toBeInTheDocument()
+        const customImg = customRender.container.querySelector('img')
+        expect(customImg).not.toBeNull()
+        expect(customImg).toHaveAttribute(
+          'src',
+          '/custom-brand.svg',
+        )
+        expect(customRender.container.innerHTML).not.toContain('valuemelody.com')
+      },
+    )
+
+    it(
+      'keeps en.json, fr.json, and zh.json translation keys, placeholders, and NAccount brand aligned',
+      () => {
+        expect(routing.locales).toEqual(['en', 'fr', 'zh'])
+        expect(enMessages.layout.brand).toBe('NAccount')
+        expect(frMessages.layout.brand).toBe('NAccount')
+        expect(zhMessages.layout.brand).toBe('NAccount')
+
+        const flatEn = flattenTranslationEntries(enMessages)
+        const flatFr = flattenTranslationEntries(frMessages)
+        const flatZh = flattenTranslationEntries(zhMessages)
+
+        const enKeys = Object.keys(flatEn).sort()
+        expect(Object.keys(flatFr).sort()).toEqual(enKeys)
+        expect(Object.keys(flatZh).sort()).toEqual(enKeys)
+
+        for (const key of enKeys) {
+          expect(flatZh[key].trim().length).toBeGreaterThan(0)
+          const enPlaceholders = (flatEn[key].match(/\{[^}]+\}/g) ?? []).sort()
+          const frPlaceholders = (flatFr[key].match(/\{[^}]+\}/g) ?? []).sort()
+          const zhPlaceholders = (flatZh[key].match(/\{[^}]+\}/g) ?? []).sort()
+          expect(frPlaceholders).toEqual(enPlaceholders)
+          expect(zhPlaceholders).toEqual(enPlaceholders)
+        }
+      },
+    )
   },
 )
