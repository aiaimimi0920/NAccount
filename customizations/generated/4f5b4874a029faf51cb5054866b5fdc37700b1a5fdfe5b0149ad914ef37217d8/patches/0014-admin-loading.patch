+    it(
+      'redirects to /zh/dashboard on onLoginSuccess({ locale: "zh" }) when supported',
+      () => {
+        process.env.NEXT_PUBLIC_SUPPORTED_LOCALES = 'en,zh'
+        configSignal.value = {} as any
+        vi.mocked(useLocale).mockReturnValue('en')
+
+        render(<NextIntlClientProvider
+          locale='en'
+          messages={{}}><Setup>Test</Setup></NextIntlClientProvider>)
+
