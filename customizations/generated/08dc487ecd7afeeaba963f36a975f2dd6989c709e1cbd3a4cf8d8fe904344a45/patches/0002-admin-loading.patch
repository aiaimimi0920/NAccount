diff --git a/admin-panel/app/useAdminConfig.test.tsx b/admin-panel/app/useAdminConfig.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8e28dc9801600e2067b65a9743630d9ac23cd870
--- /dev/null
+++ b/admin-panel/app/useAdminConfig.test.tsx
@@ -0,0 +1,78 @@
+import { act, renderHook, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { configSignal } from 'signals'
+import { proxyTool } from 'tools'
+import useAdminConfig, { CONFIG_TIMEOUT_MS } from './useAdminConfig'
+
+describe('admin configuration lifecycle', () => {
+  const send = vi.spyOn(proxyTool, 'sendNextRequest')
+  const acquire = vi.fn(async () => 'test-token')
+  beforeEach(() => {
+    configSignal.value = null
+    send.mockReset()
+    acquire.mockClear()
+  })
+  afterEach(() => vi.useRealTimers())
+
+  it('loads configuration and forwards cancellation', async () => {
+    send.mockResolvedValue({ configs: { ENABLE_ORG: true } })
+    const { result } = renderHook(() => useAdminConfig(true, acquire))
+    await waitFor(() => expect(configSignal.value).toEqual({ ENABLE_ORG: true }))
+    expect(result.current.failed).toBe(false)
+    expect(send.mock.calls[0][0].signal).toBeInstanceOf(AbortSignal)
+  })
+
+  it.each([undefined, {}, { configs: null }, { configs: [] }])('ends loading for invalid responses %j', async (response) => {
+    send.mockResolvedValue(response)
+    const { result } = renderHook(() => useAdminConfig(true, acquire))
+    await waitFor(() => expect(result.current.failed).toBe(true))
+    expect(configSignal.value).toBeNull()
+  })
+
+  it('recovers after an explicit retry, without automatic retry loops', async () => {
+    send.mockRejectedValueOnce(new Error('network failure')).mockResolvedValueOnce({ configs: {} })
+    const { result } = renderHook(() => useAdminConfig(true, acquire))
+    await waitFor(() => expect(result.current.failed).toBe(true))
+    expect(send).toHaveBeenCalledTimes(1)
+    act(() => result.current.retry())
+    await waitFor(() => expect(configSignal.value).toEqual({}))
+    expect(result.current.failed).toBe(false)
+    expect(send).toHaveBeenCalledTimes(2)
+  })
+
+  it('times out a hung token request and ignores its late completion', async () => {
+    vi.useFakeTimers()
+    let resolve!: (value: string) => void
+    const token = vi.fn(() => new Promise<string>((done) => { resolve = done }))
+    const { result } = renderHook(() => useAdminConfig(true, token))
+    await act(async () => { vi.advanceTimersByTime(CONFIG_TIMEOUT_MS) })
+    expect(result.current.failed).toBe(true)
+    await act(async () => resolve('late-token'))
+    expect(send).not.toHaveBeenCalled()
+  })
+
+  it('aborts a hung fetch and ignores a stale response after retry', async () => {
+    vi.useFakeTimers()
+    let resolve!: (value: unknown) => void
+    send.mockImplementationOnce(() => new Promise((done) => { resolve = done }))
+      .mockResolvedValueOnce({ configs: { ENABLE_ORG: false } })
+    const { result } = renderHook(() => useAdminConfig(true, acquire))
+    await act(async () => {})
+    await act(async () => { vi.advanceTimersByTime(CONFIG_TIMEOUT_MS) })
+    expect(result.current.failed).toBe(true)
+    expect(send.mock.calls[0][0].signal?.aborted).toBe(true)
+    await act(async () => result.current.retry())
+    await act(async () => resolve({ configs: { ENABLE_ORG: true } }))
+    expect(configSignal.value).toEqual({ ENABLE_ORG: false })
+    expect(result.current.failed).toBe(false)
+  })
+
+  it('clears old configuration and cancels when signed out', async () => {
+    send.mockResolvedValue({ configs: {} })
+    const { rerender } = renderHook(({ signedIn }) => useAdminConfig(signedIn, acquire), { initialProps: { signedIn: true } })
+    await waitFor(() => expect(configSignal.value).toEqual({}))
+    rerender({ signedIn: false })
+    expect(configSignal.value).toBeNull()
+    expect(send.mock.calls[0][0].signal?.aborted).toBe(true)
+  })
+})
diff --git a/admin-panel/app/useAdminConfig.ts b/admin-panel/app/useAdminConfig.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f5030742a19b48146b33245b6bddef2cbcf15de0
--- /dev/null
+++ b/admin-panel/app/useAdminConfig.ts
@@ -0,0 +1,54 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+import { configSignal } from 'signals'
+import { proxyTool } from 'tools'
+
+export const CONFIG_TIMEOUT_MS = 15000
+
+export default function useAdminConfig (authenticated: boolean, acquireToken: () => Promise<string | undefined>) {
+  const [failed, setFailed] = useState(false)
+  const [attempt, setAttempt] = useState(0)
+
+  useEffect(() => {
+    configSignal.value = null
+    setFailed(false)
+    if (!authenticated) return
+
+    const controller = new AbortController()
+    let active = true
+    const timer = setTimeout(() => {
+      controller.abort()
+      if (active) setFailed(true)
+    }, CONFIG_TIMEOUT_MS)
+
+    const load = async () => {
+      try {
+        const token = await acquireToken()
+        if (!active || controller.signal.aborted) return
+        if (!token) throw new Error('Missing access token')
+        const data = await proxyTool.sendNextRequest({
+          endpoint: '/api/info', method: 'GET', token, signal: controller.signal,
+        })
+        if (!active || controller.signal.aborted) return
+        if (!data?.configs || typeof data.configs !== 'object' || Array.isArray(data.configs)) {
+          throw new Error('Invalid admin configuration response')
+        }
+        configSignal.value = data.configs
+      } catch {
+        if (active) setFailed(true)
+      } finally {
+        clearTimeout(timer)
+      }
+    }
+    void load()
+
+    return () => {
+      active = false
+      clearTimeout(timer)
+      controller.abort()
+    }
+  }, [authenticated, acquireToken, attempt])
+
+  return { failed, retry: () => setAttempt((value) => value + 1) }
+}
