{
  "schemaVersion": 2,
  "accountMode": "single",
  "accounts": [{"key": "runtime", "label": "账户", "path": ["accountId"], "secret": "CLOUDFLARE_API_TOKEN"}],
  "target": "cloudflare-workers",
  "accountPath": ["accountId"],
  "defaults": {
    "server": {"name": "", "url": "", "secretNames": []},
    "admin": {"name": "", "url": "", "spaClientId": "", "s2sClientId": ""},
    "vars": {
      "COMPANY_LOGO_URL": "",
      "COMPANY_EMAIL_LOGO_URL": "",
      "EMAIL_SENDER_NAME": "NAccount",
      "EMAIL_PROVIDER_NAME": "cloudflare",
      "CLOUDFLARE_SENDER_ADDRESS": "",
      "SUPPORTED_LOCALES": ["en", "zh"],
      "ENABLE_LOCALE_SELECTOR": true
    }
  },
  "fields": [
    {"path": ["server", "name"], "label": "认证服务", "type": "text", "required": true, "template": "{instance}-auth"},
    {"path": ["server", "url"], "label": "认证地址", "type": "text", "required": true, "template": "https://{instance}-auth.{subdomain:runtime}.workers.dev"},
    {"path": ["admin", "name"], "label": "管理后台", "type": "text", "required": true, "template": "{instance}-admin"},
    {"path": ["admin", "url"], "label": "后台地址", "type": "text", "required": true, "template": "https://{instance}-admin.{subdomain:runtime}.workers.dev"},
    {"path": ["vars"], "label": "公开变量", "type": "json", "required": true, "template": null}
  ],
  "targets": [
    {"kind": "worker", "path": ["server", "name"], "account": "runtime"},
    {"kind": "domain", "path": ["server", "url"], "account": "runtime"},
    {"kind": "worker", "path": ["admin", "name"], "account": "runtime"},
    {"kind": "domain", "path": ["admin", "url"], "account": "runtime"}
  ],
  "resources": [
    {"key": "database", "label": "数据库", "kind": "d1", "idPath": ["database", "id"], "namePath": ["database", "name"], "account": "runtime", "nativeAccount": "runtime", "nameTemplate": "{instance}-db"},
    {"key": "session", "label": "会话", "kind": "kv", "idPath": ["kvId"], "namePath": null, "account": "runtime", "nativeAccount": "runtime", "nameTemplate": "{instance}-session"}
  ]
}
