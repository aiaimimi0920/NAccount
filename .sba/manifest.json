{
  "schemaVersion": 1,
  "id": "naccount-cloudflare",
  "name": "NAccount Cloudflare deployment",
  "entrypoint": "deploy.ps1",
  "workingDirectory": "caller",
  "configPathBase": "caller",
  "invocation": {
    "executable": "powershell.exe",
    "arguments": ["-NoProfile", "-NonInteractive", "-File", "{absoluteEntrypoint}", "{action}", "{actionArguments}", "--json"],
    "jsonFlagPosition": "after action"
  },
  "minimumRuntime": {
    "powershell": "5.1",
    "python": "3.11",
    "git": "required",
    "node": "22 for build and key bootstrap",
    "npm": "required for build"
  },
  "resultProtocol": {
    "flag": "--json",
    "stdout": "one JSON object for parsed actions; schemaVersion=1, ok, action, result or error",
    "stderr": "diagnostic logs; not a stable protocol",
    "successExitCode": 0,
    "argumentError": "nonzero exit; argparse may write only to stderr"
  },
  "actions": {
    "plan": {
      "requiredArguments": ["--config"],
      "optionalArguments": ["--component", "--json"],
      "cloudWrites": false,
      "network": false
    },
    "prepare": {
      "requiredArguments": ["--config"],
      "optionalArguments": ["--component", "--json"],
      "cloudWrites": false,
      "network": false
    },
    "build": {
      "requiredArguments": ["--config"],
      "optionalArguments": ["--component", "--json"],
      "cloudWrites": false,
      "network": "npm dependencies"
    },
    "bootstrap-keys": {
      "requiredArguments": ["--release", "--execute"],
      "optionalArguments": ["--json"],
      "cloudWrites": true,
      "requiresSeparateApproval": true
    },
    "publish": {
      "requiredArguments": ["--release", "--execute"],
      "optionalArguments": ["--migrate", "--json"],
      "cloudWrites": true,
      "requiresSeparateApproval": true
    }
  },
  "componentValues": ["server", "admin", "all"],
  "rules": "AGENTS.md",
  "documentation": "README.md",
  "environmentTemplate": "environments/cloudflare.example.json"
}
